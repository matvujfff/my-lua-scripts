local function getLevelAndQuest()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    local lvl = (l and l.Value) or 1
    for i = 1, #QuestsSea1 do
        local q = QuestsSea1[i]
        if lvl >= q.Min and lvl <= q.Max then
            return q, lvl
        end
    end
    return QuestsSea1[#QuestsSea1], lvl
end

-- ============================================================================
-- 5. ПЛАВНЫЙ ПОЛЕТ И УДЕРЖАНИЕ ПОЗИЦИИ
-- ============================================================================
local TargetPosCFrame = nil
local ZeroVector = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function(dt)
    if not Env.OllieV4.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    pcall(function()
        root.Velocity = ZeroVector
        root.RotVelocity = ZeroVector
    end)

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end

    if TargetPosCFrame then
        local cur = root.Position
        local dst = TargetPosCFrame.Position
        local diff = dst - cur
        local dist = diff.Magnitude

        if dist <= 4 then
            root.CFrame = TargetPosCFrame
        else
            local step = math.min(dist, Env.OllieV4.TweenSpeed * dt)
            root.CFrame = CFrame.new(cur + (diff.Unit * step))
        end
    end
end)

-- ============================================================================
-- 6. ПОИСК МОБОВ (ПО ЧАСТИ ИМЕНИ) И БОЕВАЯ СИСТЕМА
-- ============================================================================
local function findAliveMob(mobSubstring)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local lowerSub = string.lower(mobSubstring)

    for _, m in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(m.Name), lowerSub, 1, true) then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr and mh.Health > 0 then
                return m
            end
        end
    end
    return nil
end

local function equipMelee()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return nil end

    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == Env.OllieV4.WeaponType or eq.Name == "Combat") then
        return eq
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, it in ipairs(bp:GetChildren()) do
            if it:IsA("Tool") and (it.ToolTip == Env.OllieV4.WeaponType or it.Name == "Combat") then
                hum:EquipTool(it)
                return it
            end
        end
        local anyTool = bp:FindFirstChildOfClass("Tool")
        if anyTool then
            hum:EquipTool(anyTool)
            return anyTool
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function bringMobs(mobSubstring, pos)
    if not Env.OllieV4.BringMobs then return end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local lowerSub = string.lower(mobSubstring)

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end
    end)

    for _, m in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(m.Name), lowerSub, 1, true) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            local mh = m:FindFirstChildOfClass("Humanoid")
            if mr and mh and mh.Health > 0 and (mr.Position - pos).Magnitude <= 250 then
                pcall(function()
                    mr.CanCollide = false
                    mr.Velocity = ZeroVector
                    mr.CFrame = CFrame.new(pos)
                end)
            end
        end
    end
end

local function hitTarget(mob)
    local tool = equipMelee()
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local net = modules and modules:FindFirstChild("Net")
        if net and mob and mob:FindFirstChild("HumanoidRootPart") then
            local regAtk = net:FindFirstChild("RE/RegisterAttack")
            local regHit = net:FindFirstChild("RE/RegisterHit")
            if regAtk and regHit then
                regAtk:FireServer(0)
                regHit:FireServer(mob.HumanoidRootPart, {{mob, mob.HumanoidRootPart}})
            end
        end
    end)

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(400, 225))
    end)
end

-- ============================================================================
-- 7. АВТО-СТАТЫ И ФРУКТЫ
-- ============================================================================
task.spawn(function()
    while task.wait(4) do
        if Env.OllieV4.Enabled then
            local comm = getCommF()
            if comm then
                if Env.OllieV4.AutoStats then
                    pcall(function()
                        local pts = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Points")
                        if pts and pts.Value > 0 then
                            comm:InvokeServer("AddPoint", "Melee", 2)
                            comm:InvokeServer("AddPoint", "Defense", 1)
                        end
                    end)
                end
                if Env.OllieV4.AutoRollFruit then
                    pcall(function() comm:InvokeServer("Cousin", "Buy") end)
                end
            end
        end
    end
end)

-- ============================================================================
-- 8. ГЛАВНЫЙ ЦИКЛ ФАРМА
-- ============================================================================
task.spawn(function()
    while task.wait(Env.OllieV4.AttackDelay) do
        if not Env.OllieV4.Enabled then
            TargetPosCFrame = nil
        else
            pcall(function()
                if ensurePirates() then
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")

                    if not char or not root or not hum or hum.Health <= 0 then
                        setStatus("Ожидание спавна...")
                    else
                        local qData, myLvl = getLevelAndQuest()

                        if not checkQuestActive(qData.Mob, myLvl) then
                            local distToNpc = (root.Position - qData.QPos.Position).Magnitude
                            setStatus("Летим к NPC (" .. tostring(math.floor(distToNpc)) .. "м)", myLvl, qData.QName)
                            TargetPosCFrame = qData.QPos

                            -- Когда подлетели вплотную (менее 6 стадов), вызываем StartQuest и фиксируем таймер
                            if distToNpc <= 6 then
                                local comm = getCommF()
                                if comm then
                                    setStatus("Берем квест " .. qData.QName .. "...", myLvl, qData.QName)
                                    comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                                    LastQuestTakenTime = tick()
                                    LastQuestLevel = myLvl
                                    task.wait(0.6)
                                end
                            end
                        else
                            local mob = findAliveMob(qData.Mob)
                            if mob then
                                local mPos = mob.HumanoidRootPart.Position
                                local distToMob = (root.Position - mPos).Magnitude
                                setStatus("Атакуем: " .. mob.Name .. " [HP: " .. tostring(math.floor(mob.Humanoid.Health)) .. "]", myLvl, qData.QName)
                                TargetPosCFrame = CFrame.new(mPos + Vector3.new(0, Env.OllieV4.HoverHeight, 0))

                                if distToMob <= 35 then
                                    bringMobs(qData.Mob, mPos)
                                    hitTarget(mob)
                                end
                            else
                                local distToSpawn = (root.Position - qData.MPos.Position).Magnitude
                                setStatus("Летим к точке мобов (" .. tostring(math.floor(distToSpawn)) .. "м)", myLvl, qData.QName)
                                TargetPosCFrame = qData.MPos * CFrame.new(0, 15, 0)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
