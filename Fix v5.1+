-- [[ OLLIE BLOX FRUITS AUTO-FARM V4 - QUEST & SERVERHOP FIXED ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
while not LocalPlayer do
    task.wait(0.2)
    LocalPlayer = Players.LocalPlayer
end

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "OLLIE FARM V4",
        Text = "Запуск V4 (Фикс квестов и хопа)",
        Duration = 5
    })
end)

local Env = (getgenv and getgenv()) or _G
Env.OllieV4 = {
    Enabled = true,
    AutoStats = true,
    AutoRollFruit = true,
    BringMobs = true,
    TweenSpeed = 250,
    HoverHeight = 12,
    AttackDelay = 0.15,
    WeaponType = "Melee"
}

-- ============================================================================
-- 1. НАДЕЖНЫЙ HUD В PLAYERGUI
-- ============================================================================
local StatusTextObj = nil
local LevelTextObj = nil

local function createHUD()
    local pGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    if not pGui then return nil end

    local old = pGui:FindFirstChild("OllieHudV4")
    if old then old:Destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "OllieHudV4"
    screen.ResetOnSpawn = false
    screen.DisplayOrder = 999999
    screen.Parent = pGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 115)
    frame.Position = UDim2.new(0, 12, 0, 38)
    frame.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(0, 255, 136)
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screen

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 22)
    title.Position = UDim2.new(0, 6, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "OLLIE BF FARM V4 [АКТИВЕН]"
    title.TextColor3 = Color3.fromRGB(0, 255, 136)
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    frame.Parent = screen
    title.Parent = frame

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -12, 0, 34)
    statusLbl.Position = UDim2.new(0, 6, 0, 26)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Статус: Запуск..."
    statusLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    statusLbl.Font = Enum.Font.SourceSans
    statusLbl.TextSize = 14
    statusLbl.TextWrapped = true
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.TextYAlignment = Enum.TextYAlignment.Top
    statusLbl.Parent = frame

    local infoLbl = Instance.new("TextLabel")
    infoLbl.Size = UDim2.new(1, -12, 0, 18)
    infoLbl.Position = UDim2.new(0, 6, 0, 60)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Text = "LVL: -- | Квест: --"
    infoLbl.TextColor3 = Color3.fromRGB(180, 185, 200)
    infoLbl.Font = Enum.Font.SourceSans
    infoLbl.TextSize = 13
    infoLbl.TextXAlignment = Enum.TextXAlignment.Left
    infoLbl.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 125, 0, 26)
    toggleBtn.Position = UDim2.new(0, 8, 0, 82)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Text = "ФАРМ: ВКЛ"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 14
    toggleBtn.Parent = frame

    local hopBtn = Instance.new("TextButton")
    hopBtn.Size = UDim2.new(0, 125, 0, 26)
    hopBtn.Position = UDim2.new(0, 145, 0, 82)
    hopBtn.BackgroundColor3 = Color3.fromRGB(40, 95, 200)
    hopBtn.BorderSizePixel = 0
    hopBtn.Text = "СМЕНА СЕРВЕРА"
    hopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    hopBtn.Font = Enum.Font.SourceSansBold
    hopBtn.TextSize = 14
    hopBtn.Parent = frame

    StatusTextObj = statusLbl
    LevelTextObj = infoLbl

    toggleBtn.MouseButton1Click:Connect(function()
        Env.OllieV4.Enabled = not Env.OllieV4.Enabled
        if Env.OllieV4.Enabled then
            toggleBtn.Text = "ФАРМ: ВКЛ"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
            title.Text = "OLLIE BF FARM V4 [АКТИВЕН]"
            title.TextColor3 = Color3.fromRGB(0, 255, 136)
            frame.BorderColor3 = Color3.fromRGB(0, 255, 136)
        else
            toggleBtn.Text = "ФАРМ: ПАУЗА"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(190, 45, 45)
            title.Text = "OLLIE BF FARM V4 [ПАУЗА]"
            title.TextColor3 = Color3.fromRGB(255, 80, 80)
            frame.BorderColor3 = Color3.fromRGB(255, 80, 80)
            statusLbl.Text = "Статус: На паузе"
        end
    end)

    return hopBtn
end

local function setStatus(msg, lvl, qName)
    pcall(function()
        if StatusTextObj then
            StatusTextObj.Text = "Статус: " .. tostring(msg)
        end
        if LevelTextObj and (lvl or qName) then
            LevelTextObj.Text = "LVL: " .. tostring(lvl or "--") .. " | Квест: " .. tostring(qName or "--")
        end
    end)
end

local HopBtn = createHUD()

-- ============================================================================
-- 2. ПРОБИВНОЙ SERVER HOP (ТРОЙНОЙ МЕТОД: __ServerBrowser -> API -> Прямой Teleport)
-- ============================================================================
local HopLock = false
local function forceServerHop()
    if HopLock then return end
    HopLock = true
    setStatus("Переход на другой сервер...")

    local placeId = game.PlaceId
    local currentJob = game.JobId

    -- Метод 1: Встроенный браузер серверов Blox Fruits
    pcall(function()
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if sb then
            for page = 1, 3 do
                local list = sb:InvokeServer(page)
                if type(list) == "table" then
                    for jobId, info in pairs(list) do
                        if jobId ~= currentJob and type(info) == "table" and info.Count and info.Count >= 2 and info.Count <= 9 then
                            setStatus("Телепорт через ServerBrowser...")
                            sb:InvokeServer("teleport", jobId)
                            task.wait(3)
                        end
                    end
                end
            end
        end
    end)

    -- Метод 2: Публичный API с сортировкой Desc (живые серверы, а не пустые)
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100"
        local raw = game:HttpGet(url)
        local data = HttpService:JSONDecode(raw)
        if data and data.data then
            for i = 1, #data.data do
                local srv = data.data[i]
                if type(srv) == "table" and srv.id ~= currentJob and srv.playing and srv.playing >= 3 and srv.playing <= 9 then
                    setStatus("Телепорт по JobId...")
                    TeleportService:TeleportToPlaceInstance(placeId, srv.id, LocalPlayer)
                    task.wait(3)
                end
            end
        end
    end)

    -- Метод 3: Безотказный стандартный реконнект Roblox на новый сервер
    setStatus("Прямой перезаход на новый сервер...")
    pcall(function()
        TeleportService:Teleport(placeId, LocalPlayer)
    end)

    task.wait(5)
    HopLock = false
end

if HopBtn then
    HopBtn.MouseButton1Click:Connect(function()
        task.spawn(forceServerHop)
    end)
end

-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button2Down(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
        task.wait(1)
        VirtualUser:Button2Up(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
    end)
end)

-- ============================================================================
-- 3. РАБОТА С REMOTES И ПРОВЕРКОЙ ОКОН КВЕСТА (MOBILE + PC UI)
-- ============================================================================
local function getCommF()
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    return rem and rem:FindFirstChild("CommF_")
end

local function ensurePirates()
    if not LocalPlayer.Team or (LocalPlayer.Team.Name ~= "Pirates" and LocalPlayer.Team.Name ~= "Marines") then
        setStatus("Выбираем команду Pirates...")
        pcall(function()
            local comm = getCommF()
            if comm then
                comm:InvokeServer("SetTeam", "Pirates")
            end
        end)
        task.wait(1)
        return false
    end
    return true
end

-- Универсальный поиск контейнера Quest (поддерживает и Main, и Main (minimal) на Android)
local function getQuestGuiFrame()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    local main1 = pGui:FindFirstChild("Main")
    if main1 and main1:FindFirstChild("Quest") then
        return main1.Quest
    end

    local main2 = pGui:FindFirstChild("Main (minimal)")
    if main2 and main2:FindFirstChild("Quest") then
        return main2.Quest
    end

    -- Резервный глубокий поиск
    for _, child in ipairs(pGui:GetChildren()) do
        if child:IsA("ScreenGui") then
            local q = child:FindFirstChild("Quest", true)
            if q and q:IsA("GuiObject") and q:FindFirstChild("Container") then
                return q
            end
        end
    end
    return nil
end

local LastQuestTakenTime = 0
local LastQuestLevel = 0

local function checkQuestActive(expectedMob, myLvl)
    local qFrame = getQuestGuiFrame()
    if qFrame then
        if qFrame.Visible then
            return true
        else
            return false
        end
    end
    -- Если мобильный интерфейс скрыл Quest фрейм, опираемся на таймер после вызова StartQuest
    if (tick() - LastQuestTakenTime < 90) and (LastQuestLevel == myLvl) then
        return true
    end
    return false
end

