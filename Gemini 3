local function getLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    if l then return l.Value end
    return 1
end

local function getQuestForLevel()
    local lvl = getLevel()
    for i = 1, #QuestsSea1 do
        local q = QuestsSea1[i]
        if lvl >= q.Min and lvl <= q.Max then
            return q, lvl
        end
    end
    return QuestsSea1[#QuestsSea1], lvl
end

local function isQuestActiveForMob(mobName)
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pGui and pGui:FindFirstChild("Main")
    local qFrame = main and main:FindFirstChild("Quest")
    if not qFrame or not qFrame.Visible then
        return false
    end
    local cont = qFrame:FindFirstChild("Container")
    local qTitle = cont and cont:FindFirstChild("QuestTitle")
    local titleLbl = qTitle and qTitle:FindFirstChild("Title")
    if titleLbl and titleLbl:IsA("TextLabel") then
        local txt = string.lower(titleLbl.Text)
        if not string.find(txt, string.lower(mobName), 1, true) then
            local comm = getCommF()
            if comm then
                pcall(function() comm:InvokeServer("AbandonQuest") end)
            end
            return false
        end
    end
    return true
end

