local function equipWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and (currentTool.ToolTip == Env.OllieV3.WeaponType or currentTool.Name == "Combat") then
        return currentTool
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local items = bp:GetChildren()
        for i = 1, #items do
            local it = items[i]
            if it:IsA("Tool") and (it.ToolTip == Env.OllieV3.WeaponType or it.Name == "Combat") then
                hum:EquipTool(it)
                return it
            end
        end
        local fallback = bp:FindFirstChildOfClass("Tool")
        if fallback then
            hum:EquipTool(fallback)
            return fallback
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function bringMobsAround(mobName, centerPos)
    if not Env.OllieV3.BringMobs then return end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end
    end)

    local list = enemies:GetChildren()
    for i = 1, #list do
        local m = list[i]
        if m.Name == mobName then
            local mRoot = m:FindFirstChild("HumanoidRootPart")
            local mHum = m:FindFirstChildOfClass("Humanoid")
            if mRoot and mHum and mHum.Health > 0 then
                local d = (mRoot.Position - centerPos).Magnitude
                if d <= 250 then
                    pcall(function()
                        mRoot.CanCollide = false
                        mRoot.Velocity = ZeroVec
                        mRoot.CFrame = CFrame.new(centerPos)
                    end)
                end
            end
        end
    end
end

local function attackTarget(mob)
    local char = LocalPlayer.Character
    if not char then return end

    if not char:FindFirstChild("HasBuso") then
        pcall(function()
            local comm = getCommF()
            if comm then comm:InvokeServer("Buso") end
        end)
    end

    local tool = equipWeapon()
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local net = modules and modules:FindFirstChild("Net")
        if net and mob and mob:FindFirstChild("HumanoidRootPart") then
            local regAtk = net:FindFirstChild("RE/RegisterAttack")
            local regHit = net:FindFirstChild("RE/RegisterHit")
            if regAtk and regHit then
                regAtk:FireServer(0)
                regHit:FireServer(mob.HumanoidRootPart, {{mob, mob.HumanoidRootPart}})
            end
        end
    end)

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(400, 225))
    end)
end

