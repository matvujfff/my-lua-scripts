local HopBusy = false
local function serverHop()
    if HopBusy then return end
    HopBusy = true
    setStatus("Ищем свободный сервер...")

    local placeId = game.PlaceId
    local jobId = game.JobId
    local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"

    local ok, body = pcall(function()
        local httpFunc = (http_request or request or (syn and syn.request))
        if httpFunc then
            local r = httpFunc({ Url = url, Method = "GET" })
            return r and r.Body
        end
        return game:HttpGet(url)
    end)

    if ok and body then
        local parsedOk, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if parsedOk and decoded and decoded.data then
            for i = 1, #decoded.data do
                local srv = decoded.data[i]
                if type(srv) == "table" and srv.id ~= jobId and srv.playing and srv.playing >= 2 and srv.playing <= 8 then
                    setStatus("Переход на новый сервер...")
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(placeId, srv.id, LocalPlayer)
                    end)
                    task.wait(4)
                end
            end
        end
    end
    HopBusy = false
end

