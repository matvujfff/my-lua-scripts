-- 6. ПЛАВНОЕ ДВИЖЕНИЕ (НЕБЛОКИРУЮЩИЙ STEP + NOCLIP БЕЗ VECTOR3.ZERO)
-- ============================================================================
local DesiredCFrame = nil
local ZeroVec = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function(dt)
    if not Env.OllieV3.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    pcall(function()
        root.Velocity = ZeroVec
        root.RotVelocity = ZeroVec
    end)

    local parts = char:GetDescendants()
    for i = 1, #parts do
        local p = parts[i]
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
        end
    end

    if DesiredCFrame then
        local curPos = root.Position
        local dstPos = DesiredCFrame.Position
        local delta = dstPos - curPos
        local dist = delta.Magnitude

        if dist <= 6 then
            root.CFrame = DesiredCFrame
        else
            local step = math.min(dist, Env.OllieV3.TweenSpeed * dt)
            local nextPos = curPos + (delta.Unit * step)
            root.CFrame = CFrame.new(nextPos)
        end
    end
end)

