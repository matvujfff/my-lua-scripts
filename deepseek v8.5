local CachedCommF = nil
local CachedQuestFrame = nil
local CachedDialogueFrame = nil

local function getCommF()
    if CachedCommF and CachedCommF.Parent then return CachedCommF end
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    CachedCommF = rem and rem:FindFirstChild("CommF_")
    return CachedCommF
end

local function ensureTeam()
    if not LocalPlayer.Team or (LocalPlayer.Team.Name ~= "Pirates" and LocalPlayer.Team.Name ~= "Marines") then
        setFSMState("SELECT_TEAM", "Выбираем команду Pirates...")
        pcall(function()
            local comm = getCommF()
            if comm then comm:InvokeServer("SetTeam", "Pirates") end
        end)
        task.wait(1)
        return false
    end
    return true
end

local function isGuiChainVisible(obj)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then return false end
    local parent = obj.Parent
    while parent do
        if parent:IsA("ScreenGui") then return parent.Enabled
        elseif parent:IsA("GuiObject") and not parent.Visible then return false end
        parent = parent.Parent
    end
    return false
end

local function getVisibleQuestFrame()
    if CachedQuestFrame and CachedQuestFrame.Parent and isGuiChainVisible(CachedQuestFrame) then
        return CachedQuestFrame
    end
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV8_5" then
            local directQuest = gui:FindFirstChild("Quest")
            if directQuest and directQuest:IsA("GuiObject") and isGuiChainVisible(directQuest) then
                CachedQuestFrame = directQuest
                return directQuest
            end
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") and isGuiChainVisible(obj) then
                    CachedQuestFrame = obj
                    return obj
                end
            end
        end
    end
    return nil
end

local function isQuestGuiVisible()
    return getVisibleQuestFrame() ~= nil
end

local function waitForQuestGuiState(targetVisible, timeoutSec)
    local t0 = os.clock()
    while isCurrentRunActive() and (os.clock() - t0) < timeoutSec do
        if isQuestGuiVisible() == targetVisible then return true end
        task.wait(0.1)
    end
    return isQuestGuiVisible() == targetVisible
end

local function doesTextMatchQuestEntry(qEntry, textLower)
    if string.find(textLower, string.lower(qEntry.Mob), 1, true) then return true end
    return false
end

local function inspectActiveQuestMatch(qData)
    local qFrame = getVisibleQuestFrame()
    if not qFrame then return false, "HIDDEN", "no_visible_quest_frame", "" end
    local parts = {}
    for _, desc in ipairs(qFrame:GetDescendants()) do
        if desc:IsA("TextLabel") and isGuiChainVisible(desc) and type(desc.Text) == "string" and #desc.Text > 0 then
            table.insert(parts, desc.Text)
        end
    end
    local rawCombined = table.concat(parts, " | ")
    if #rawCombined == 0 then return false, "HIDDEN", "empty_quest_frame", "" end
    local combinedLower = string.lower(rawCombined)
    local shortSnippet = string.sub(rawCombined, 1, 60)
    if doesTextMatchQuestEntry(qData, combinedLower) then return true, "MATCH", shortSnippet, rawCombined end
    return true, "UNDECIDED", shortSnippet, rawCombined
end

local function waitForQuestActivationDiff(qData, visBefore, rawBefore, timeoutSec, anchorRoot, anchorCF)
    local t0 = os.clock()
    while isCurrentRunActive() and (os.clock() - t0) < timeoutSec do
        if anchorRoot and anchorCF then pcall(function() anchorRoot.CFrame = anchorCF end) end
        local visNow, matchNow, snippetNow, rawNow = inspectActiveQuestMatch(qData)
        if visNow and #rawNow > 0 then
            if matchNow == "MATCH" then return true, "MATCH_CONFIRMED", visNow, matchNow, snippetNow, rawNow
            elseif not visBefore and matchNow ~= "MISMATCH" then return true, "OPENED_NEW_GUI", visNow, matchNow, snippetNow, rawNow
            elseif visBefore and rawNow ~= rawBefore and matchNow ~= "MISMATCH" then return true, "TEXT_CHANGED_AFTER_START", visNow, matchNow, snippetNow, rawNow end
        end
        task.wait(0.1)
    end
    return false, "NO_STATE_CHANGE", false, "HIDDEN", "", ""
end

local function clearBlockingDialogue()
    pcall(function()
        if CachedDialogueFrame and CachedDialogueFrame.Parent then
            if CachedDialogueFrame.Visible then
                local opt1 = CachedDialogueFrame:FindFirstChild("Option1", true)
                if opt1 and firesignal then pcall(function() firesignal(opt1.Activated) end) end
            end
            return
        end
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local mainGui = pGui and pGui:FindFirstChild("Main")
        local dlg = mainGui and mainGui:FindFirstChild("Dialogue")
        if dlg and dlg:IsA("GuiObject") then
            CachedDialogueFrame = dlg
            if dlg.Visible then
                local opt1 = dlg:FindFirstChild("Option1", true)
                if opt1 and firesignal then pcall(function() firesignal(opt1.Activated) end) end
            end
        end
    end)
end

local SeaPortals = {
    Sea2 = Vector3.new(-487.2, 29.1, 4442.5),
    Sea3 = Vector3.new(-16276.6, 14.7, 5593.5),
    FishmanInside  = Vector3.new(61163.8515625, 11.6796875, 1819.7841796875),
    FishmanOutside = Vector3.new(3864.6884765625, 6.73695755, -1926.2141113),
    SkyTemple      = Vector3.new(-4607.82275, 872.54248, -1667.55688),
    SkyUpperYard   = Vector3.new(-7894.617675, 5547.14160, -380.291198)
}

local LastPortalInvoke = 0
local LastStreamRequest = 0

local function requestStreamThrottled(pos)
    if os.clock() - LastStreamRequest >= 1.5 then
        LastStreamRequest = os.clock()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(pos) end)
    end
end

local function tryFastPortalTransition(rootPart, targetPos, currentLvl)
    if not rootPart or (os.clock() - LastPortalInvoke) < 3.5 then return false end
    local curPos = rootPart.Position
    local comm = getCommF()
    if not comm then return false end

    local portalToUse = nil
    if currentLvl >= 700 and currentLvl < 1500 and curPos.Y < 500 and curPos.X > -500 then
        if targetPos.X < -1000 or targetPos.Z < 0 then portalToUse = SeaPortals.Sea2 end
    elseif currentLvl >= 1500 and curPos.Y < 500 and curPos.X > -10000 then
        portalToUse = SeaPortals.Sea3
    end

    if not portalToUse then
        if targetPos.X > 50000 and curPos.X < 40000 then portalToUse = SeaPortals.FishmanInside
        elseif targetPos.X < 40000 and curPos.X > 50000 then portalToUse = SeaPortals.FishmanOutside
        elseif targetPos.Y > 4500 and curPos.Y < 3500 then portalToUse = SeaPortals.SkyUpperYard
        elseif targetPos.Y > 780 and targetPos.Y < 1200 and (curPos - targetPos).Magnitude > 3500 then portalToUse = SeaPortals.SkyTemple end
    end

    if portalToUse then
        LastPortalInvoke = os.clock()
        pcall(function() comm:InvokeServer("requestEntrance", portalToUse) end)
        task.wait(0.35)
        return true
    end
    return false
end

local function evaluatePlayerProgressAndQuest()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    if not l or type(l.Value) ~= "number" then return nil, 0, "DATA_NOT_LOADED" end
    local lvl = math.floor(l.Value)
    if lvl < 1 then return nil, lvl, "OUT_OF_RANGE" end
    if Config.StopOnGoalCompleted and lvl >= Config.MaxLevel then return nil, lvl, "GOAL_REACHED" end

    for i = 1, #QuestsAll do
        local q = QuestsAll[i]
        if lvl >= q.Min and lvl <= q.Max then return q, lvl, "OK" end
    end
    return QuestsAll[#QuestsAll], lvl, "OK"
end

local function getLiveNPCCFrame(qData)
    local npcFolders = {
        Workspace:FindFirstChild("NPCs"),
        Workspace:FindFirstChild("_WorldOrigin") and Workspace._WorldOrigin:FindFirstChild("NPCs")
    }
    for _, folder in ipairs(npcFolders) do
        if folder then
            if qData.NPC then
                local exact = folder:FindFirstChild(qData.NPC)
                if exact then
                    local r = exact:FindFirstChild("HumanoidRootPart") or exact:FindFirstChild("Head") or exact.PrimaryPart
                    if r and (r.Position - qData.QPos.Position).Magnitude <= 250 then
                        return r.CFrame * CFrame.new(0, 2, -4)
                    end
                end
            end
            local bestCF = nil
            local bestDist = 60
            for _, npc in ipairs(folder:GetChildren()) do
                local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                if r then
                    local d = (r.Position - qData.QPos.Position).Magnitude
                    if d < bestDist then bestDist = d bestCF = r.CFrame * CFrame.new(0, 2, -4) end
                end
            end
            if bestCF then return bestCF end
        end
    end
    return qData.QPos * CFrame.new(0, 2, -4)
end

local WaypointCache = { QuestKey = "", UpdatedAt = 0, Points = {} }

local function getMobSpawnWaypoints(qData)
    local qKey = qData.QName .. "_" .. tostring(qData.QNum)
    local now = os.clock()
    if WaypointCache.QuestKey == qKey and (now - WaypointCache.UpdatedAt) < Config.WaypointCacheTTL and #WaypointCache.Points > 0 then
        return WaypointCache.Points
    end
    local points = {}
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if mobNameMatches(sp.Name, qData.Mob) then
                local pos = (sp:IsA("BasePart") and sp.Position) or (sp:IsA("Model") and sp.PrimaryPart and sp.PrimaryPart.Position)
                if pos then
                    local hoverPos = pos + Vector3.new(0, Config.AttackHeight, 0)
                    local isDuplicate = false
                    for _, existingCF in ipairs(points) do
                        if (existingCF.Position - hoverPos).Magnitude < 12 then isDuplicate = true break end
                    end
                    if not isDuplicate then table.insert(points, CFrame.new(hoverPos)) end
                end
            end
        end
    end
    local mainHoverPos = qData.MPos.Position + Vector3.new(0, Config.AttackHeight, 0)
    local hasMain = false
    for _, existingCF in ipairs(points) do
        if (existingCF.Position - mainHoverPos).Magnitude < 20 then hasMain = true break end
    end
    if not hasMain then table.insert(points, CFrame.new(mainHoverPos)) end

    WaypointCache.QuestKey = qKey
    WaypointCache.UpdatedAt = now
    WaypointCache.Points = points
    return points
end

local ZeroVec = Vector3.new(0, 0, 0)
local HugeVec = Vector3.new(1e9, 1e9, 1e9)
local CachedCharParts = {}
local ModifiedCollisionParts = {}

local function trackCharacterParts(char)
    CachedCharParts = {}
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then table.insert(CachedCharParts, obj) end
    end
    table.insert(Env.OllieV85_Connections, char.DescendantAdded:Connect(function(obj)
        if isCurrentRunActive() and obj:IsA("BasePart") then table.insert(CachedCharParts, obj) end
    end))
end

restoreModifiedCollisions = function()
    for part, origVal in pairs(ModifiedCollisionParts) do
        if part and part.Parent then pcall(function() part.CanCollide = origVal end) end
        ModifiedCollisionParts[part] = nil
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local bv = root and root:FindFirstChild("OllieBV")
    if bv then pcall(function() bv:Destroy() end) end
end
Env.OllieV85_RestoreCollisions = restoreModifiedCollisions

if LocalPlayer.Character then trackCharacterParts(LocalPlayer.Character) end

local NavBypass = {
    Phase = "NONE", PhaseStartedAt = 0, SafeAltitudeY = 0, ClimbAnchorX = 0, ClimbAnchorZ = 0,
    LastCheckClock = 0, LastSamplePos = nil, LastGoalDist = math.huge, StuckTicks = 0, AttemptsUsed = 0, TrackedGoalPos = nil
}

local function resetNavBypass(keepAttemptCount)
    NavBypass.Phase = "NONE"
    NavBypass.PhaseStartedAt = 0
    NavBypass.LastCheckClock = os.clock()
    NavBypass.LastSamplePos = nil
    NavBypass.LastGoalDist = math.huge
    NavBypass.StuckTicks = 0
    if not keepAttemptCount then
        NavBypass.AttemptsUsed = 0
        NavBypass.TrackedGoalPos = nil
    end
end

table.insert(Env.OllieV85_Connections, LocalPlayer.CharacterAdded:Connect(function(newChar)
    if not isCurrentRunActive() or FSM.Completed then return end
    ModifiedCollisionParts = {}
    trackCharacterParts(newChar)
    FSM.DesiredGoalCFrame = nil
    FSM.GroundedAtNPC = false
    FSM.IsHealingState = false
    FSM.SafeHealCFrame = nil
    FSM.ActiveCombatMob = nil
    CachedQuestFrame = nil
    CachedDialogueFrame = nil
    resetNavBypass(false)
end))

table.insert(Env.OllieV85_Connections, RunService.Stepped:Connect(function()
    if not isCurrentRunActive() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not Env.OllieV85_Enabled or FSM.Completed or FSM.GroundedAtNPC or not char or not hum or hum.Health <= 0 then
        restoreModifiedCollisions()
        return
    end
    if hum.Sit then hum.Sit = false end
    for i = 1, #CachedCharParts do
        local part = CachedCharParts[i]
        if part and part.Parent and part.CanCollide then
            if ModifiedCollisionParts[part] == nil then ModifiedCollisionParts[part] = true end
            part.CanCollide = false
        end
    end
end))

-- УЛУЧШЕННЫЙ ФИЗИЧЕСКИЙ ПОЛЕТ
table.insert(Env.OllieV85_Connections, RunService.Heartbeat:Connect(function(dt)
    if not isCurrentRunActive() then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    -- Отключаем полет при взятии квеста (фикс неба)
    if not Env.OllieV85_Enabled or FSM.Completed or hum.Health <= 0 or FSM.GroundedAtNPC or FSM.State == "TAKE_QUEST" then
        restoreModifiedCollisions()
        resetNavBypass(false)
        return
    end

    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieBV"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Parent = root
    end

    -- Компенсация гравитации (защита от падения)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    local goalCF = FSM.DesiredGoalCFrame
    if not goalCF then
        bv.Velocity = Vector3.zero
        resetNavBypass(false)
        return
    end

    local curPos = root.Position
    local finalDstPos = goalCF.Position
    local totalDist = (finalDstPos - curPos).Magnitude

    if totalDist <= 7.0 then
        bv.Velocity = Vector3.zero
        root.CFrame = goalCF
        resetNavBypass(false)
        return
    end

    -- Движение напрямую к цели (защита от застревания)
    local dir = (finalDstPos - curPos).Unit
    local safeSpeed = math.min(Config.FlightSpeed, 210) -- Ограничение античита
    
    bv.Velocity = dir * safeSpeed

    -- Плавный поворот в сторону движения (античит)
    if (finalDstPos - curPos).Magnitude > 1 then
        root.CFrame = CFrame.new(curPos, Vector3.new(finalDstPos.X, curPos.Y, finalDstPos.Z))
    end
end))

local CachedRegAtk = nil
local CachedRegHit = nil

local function getCombatRemotes()
    if CachedRegAtk and CachedRegAtk.Parent and CachedRegHit and CachedRegHit.Parent then return CachedRegAtk, CachedRegHit end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if net then
        CachedRegAtk = net:FindFirstChild("RE/RegisterAttack")
        CachedRegHit = net:FindFirstChild("RE/RegisterHit")
    end
    return CachedRegAtk, CachedRegHit
end

local function equipBestTool()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return nil end
    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == Config.WeaponType or eq.Name == "Combat") then return eq end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == Config.WeaponType or item.Name == "Combat") then
                hum:EquipTool(item)
                return item
            end
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function findTargetMob(qData)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local bestMob = nil
    local bestDist = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = (myRoot and myRoot.Position) or qData.MPos.Position
    for _, m in ipairs(enemies:GetChildren()) do
        if mobNameMatches(m.Name, qData.Mob) then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr and mh.Health > 0 and mr.Position.Y > -350 then
                local d = (mr.Position - refPos).Magnitude
                if d < bestDist and (mr.Position - qData.MPos.Position).Magnitude <= 1600 then
                    bestDist = d
                    bestMob = m
                end
            end
        end
    end
    return bestMob
end

local function pullMobsTogether(mobName, targetPos)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local boxVec = Vector3.new(Config.MobHitboxSize, Config.MobHitboxSize, Config.MobHitboxSize)
    for _, m in ipairs(enemies:GetChildren()) do
        if mobNameMatches(m.Name, mobName) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            local mh = m:FindFirstChildOfClass("Humanoid")
            if mr and mh and mh.Health > 0 and (mr.Position - targetPos).Magnitude <= 260 then
                pcall(function()
                    if mr.CanCollide then mr.CanCollide = false end
                    if mr.Size ~= boxVec then mr.Size = boxVec mr.Transparency = 0.85 end
                    mr.AssemblyLinearVelocity = ZeroVec
                    if mh.WalkSpeed ~= 0 then mh.WalkSpeed = 0 end
                    if mh.JumpPower ~= 0 then mh.JumpPower = 0 end
                    if Config.BringMobs and (mr.Position - targetPos).Magnitude > 1.5 then mr.CFrame = CFrame.new(targetPos) end
                end)
            end
        end
    end
end

local function executeAttack(mob)
    if FSM.Completed or not isCurrentRunActive() then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end
    if not char:FindFirstChild("HasBuso") and (os.clock() - FSM.LastBusoTry) >= Config.BusoRetryCooldown then
        FSM.LastBusoTry = os.clock()
        task.spawn(function()
            if not isCurrentRunActive() or FSM.Completed then return end
            pcall(function()
                local comm = getCommF()
                if comm then comm:InvokeServer("Buso") end
            end)
        end)
    end
    local tool = equipBestTool()
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        local regAtk, regHit = getCombatRemotes()
        if regAtk and regHit and mob and mob:FindFirstChild("HumanoidRootPart") then
            local targets = {{mob, mob.HumanoidRootPart}}
            regAtk:FireServer(0)
            regHit:FireServer(mob.HumanoidRootPart, targets)
        end
    end)
    pcall(function()
        VirtualUser:CaptureController()
        local camCF = (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame) or CFrame.new()
        VirtualUser:Button1Down(Vector2.new(600, 280), camCF)
        VirtualUser:Button1Up(Vector2.new(600, 280), camCF)
    end)
end

task.spawn(function()
    while isCurrentRunActive() and not FSM.Completed and task.wait(Config.FastAttackInterval) do
        if not isCurrentRunActive() or FSM.Completed then break end
        if Env.OllieV85_Enabled and not FSM.GroundedAtNPC and not FSM.IsHealingState and FSM.ActiveCombatMob then
            pcall(function()
                local mh = FSM.ActiveCombatMob:FindFirstChildOfClass("Humanoid")
                local mr = FSM.ActiveCombatMob:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if mh and mr and myRoot and mh.Health > 0 and (mr.Position - myRoot.Position).Magnitude <= 65 then
                    executeAttack(FSM.ActiveCombatMob)
                end
            end)
        end
    end
end)

task.spawn(function()
    while isCurrentRunActive() and not FSM.Completed and task.wait(4) do
        if not isCurrentRunActive() or FSM.Completed then break end
        if Env.OllieV85_Enabled then
            local comm = getCommF()
            if comm then
                if Config.AutoStats then
                    pcall(function()
                        local d = LocalPlayer:FindFirstChild("Data")
                        local pts = d and d:FindFirstChild("Points")
                        if pts and pts.Value > 0 then
                            local spend = math.min(pts.Value, 30)
                            local meleePts = math.ceil(spend * 0.6)
                            local defPts = math.max(1, spend - meleePts)
                            comm:InvokeServer("AddPoint", "Melee", meleePts)
                            comm:InvokeServer("AddPoint", "Defense", defPts)
                        end
                    end)
                end
            end
        end
    end
end)

task.spawn(function()
    while isCurrentRunActive() and not FSM.Completed and task.wait(Config.LoopInterval) do
        if not isCurrentRunActive() or FSM.Completed then break end

        if not Env.OllieV85_Enabled then
            FSM.DesiredGoalCFrame = nil
            FSM.GroundedAtNPC = false
            FSM.ActiveCombatMob = nil
        else
            local loopOk, loopErr = pcall(function()
                if not ensureTeam() then return end
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not char or not root or not hum or hum.Health <= 0 then
                    FSM.DesiredGoalCFrame = nil
                    FSM.GroundedAtNPC = false
                    FSM.IsHealingState = false
                    FSM.SafeHealCFrame = nil
                    FSM.ActiveCombatMob = nil
                    setFSMState("WAIT_SPAWN", "Ожидание спавна персонажа...")
                    return
                end

                clearBlockingDialogue()
                local qData, myLvl, progressStatus = evaluatePlayerProgressAndQuest()
                if progressStatus == "DATA_NOT_LOADED" then
                    setFSMState("WAIT_DATA", "Ожидание загрузки Data.Level...")
                    return
                elseif progressStatus == "GOAL_REACHED" then
                    task.wait(0.3)
                    local _, recheckLvl, recheckStatus = evaluatePlayerProgressAndQuest()
                    if recheckStatus == "GOAL_REACHED" and recheckLvl >= Config.MaxLevel then
                        setFSMState("COMPLETED", "ФАРМ ОКОНЧЕН", recheckLvl, "COMPLETED")
                        updateHudCompletionState(recheckLvl)
                        stopAllBackgroundTasksOnCompletion()
                        return
                    end
                end

                local expectedQuestKey = qData.QName .. "_" .. tostring(qData.QNum)

                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if Config.SafeModeEnabled then
                    if hpRatio < Config.LowHpThreshold and not FSM.IsHealingState then
                        FSM.IsHealingState = true
                        FSM.GroundedAtNPC = false
                        FSM.ActiveCombatMob = nil
                        FSM.SafeHealCFrame = CFrame.new(root.Position.X, math.max(root.Position.Y + Config.SafeSkyOffset, 250), root.Position.Z)
                    elseif FSM.IsHealingState and hpRatio >= Config.RecoverHpThreshold then
                        FSM.IsHealingState = false
                        FSM.SafeHealCFrame = nil
                    end
                end

                if FSM.IsHealingState and FSM.SafeHealCFrame then
                    FSM.GroundedAtNPC = false
                    FSM.ActiveCombatMob = nil
                    FSM.DesiredGoalCFrame = FSM.SafeHealCFrame
                    setFSMState("HEALING", "ОТХИЛ В НЕБЕ", myLvl, expectedQuestKey)
                    return
                end

                local guiVisible, matchState, guiSnippet, guiRawText = inspectActiveQuestMatch(qData)
                local hasVerifiedQuest = guiVisible and FSM.CurrentTrackedQuestKey == expectedQuestKey

                if not hasVerifiedQuest then
                    FSM.ActiveCombatMob = nil
                    local npcTargetCF = getLiveNPCCFrame(qData)
                    tryFastPortalTransition(root, npcTargetCF.Position, myLvl)
                    local npcDist = (root.Position - npcTargetCF.Position).Magnitude

                    if npcDist > 9 then
                        FSM.GroundedAtNPC = false
                        FSM.DesiredGoalCFrame = npcTargetCF
                        setFSMState("MOVE_TO_NPC", string.format("Летим к NPC (%dм)", math.floor(npcDist)), myLvl, expectedQuestKey)
                        requestStreamThrottled(npcTargetCF.Position)
                    else
                        -- Фикс застревания у NPC
                        FSM.GroundedAtNPC = true
                        FSM.DesiredGoalCFrame = nil
                        restoreModifiedCollisions()
                        
                        local bv = root:FindFirstChild("OllieBV")
                        if bv then bv.Velocity = Vector3.zero end
                        
                        root.CFrame = npcTargetCF
                        hum:MoveTo(npcTargetCF.Position)
                        task.wait(0.5) -- Ждем, пока сервер прогрузит NPC

                        local comm = getCommF()
                        if comm then
                            FSM.QuestTriesAtNPC = FSM.QuestTriesAtNPC + 1
                            pcall(function() comm:InvokeServer("StartQuest", qData.QName, qData.QNum) end)
                            
                            -- Защита от Account Locked (задержка между квестами)
                            task.wait(1.5)
                            
                            -- Проверка, взят ли квест
                            local newVis, newMatch, _, _ = inspectActiveQuestMatch(qData)
                            if newVis and newMatch == "MATCH" then
                                FSM.CurrentTrackedQuestKey = expectedQuestKey
                                FSM.QuestTriesAtNPC = 0
                                setFSMState("QUEST_CONFIRMED", "Квест взят!", myLvl, expectedQuestKey)
                            else
                                setFSMState("TAKE_QUEST", "Проверка квеста...", myLvl, expectedQuestKey)
                                if FSM.QuestTriesAtNPC >= 3 then
                                    task.wait(2) -- Кулдаун при неудаче
                                    FSM.QuestTriesAtNPC = 0
                                end
                            end
                        end
                        FSM.GroundedAtNPC = false
                    end
                else
                    FSM.GroundedAtNPC = false
                    FSM.QuestTriesAtNPC = 0

                    local mob = findTargetMob(qData)
                    if mob then
                        FSM.ActiveCombatMob = mob
                        local mPos = mob.HumanoidRootPart.Position
                        tryFastPortalTransition(root, mPos, myLvl)
                        local attackPos = mPos + Vector3.new(0, Config.AttackHeight, Config.AttackBackOffset)
                        FSM.DesiredGoalCFrame = CFrame.new(attackPos, mPos)
                        setFSMState("COMBAT", "Бьем: " .. mob.Name, myLvl, expectedQuestKey)
                        if (root.Position - mPos).Magnitude <= 50 then pullMobsTogether(qData.Mob, mPos) end
                    else
                        FSM.ActiveCombatMob = nil
                        local waypoints = getMobSpawnWaypoints(qData)
                        if #waypoints > 1 then
                            FSM.PatrolIndex = (FSM.PatrolIndex % #waypoints) + 1
                        else
                            FSM.PatrolIndex = 1
                        end
                        local targetSpawnCF = waypoints[FSM.PatrolIndex]
                        tryFastPortalTransition(root, targetSpawnCF.Position, myLvl)
                        requestStreamThrottled(targetSpawnCF.Position)
                        FSM.DesiredGoalCFrame = targetSpawnCF
                        setFSMState("PATROL_SPAWN", "Ждем спавн мобов", myLvl, expectedQuestKey)
                    end
                end
            end)

            if not loopOk then
                setFSMState("ERROR_RECOVERY", "Ошибка: " .. tostring(loopErr))
            end
        end
    end
end)
