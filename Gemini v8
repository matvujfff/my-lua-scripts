table.insert(Env.OllieV8_Connections, RunService.Heartbeat:Connect(function(dt)
    if not isRunActive() then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if not Env.OllieV8_Enabled or hum.Health <= 0 or GroundedAtNPC then
        local bv = root:FindFirstChild("OllieBV")
        if bv then bv:Destroy() end
        if GroundedAtNPC or not Env.OllieV8_Enabled then
            root.CanCollide = true
        end
        return
    end

    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieBV"
        bv.MaxForce = HugeVec
        bv.Velocity = ZeroVec
        bv.Parent = root
    else
        bv.Velocity = ZeroVec
    end

    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)

    if DesiredGoalCFrame then
        local curPos = root.Position
        local dstPos = DesiredGoalCFrame.Position
        local totalDist = (dstPos - curPos).Magnitude
        local now = tick()

        -- Если летим далеко, но уперлись в преграду (за 0.8 с сдвинулись меньше чем на 8 стадов) — поднимаемся на +135 стадов вверх
        if totalDist > 20 then
            if (now - LastStuckCheck) >= 0.8 then
                if LastStuckPos and (curPos - LastStuckPos).Magnitude < 8.0 and now > ClimbBypassUntil then
                    ClimbBypassUntil = now + 2.0
                    ClimbTargetY = math.max(curPos.Y, dstPos.Y) + 135
                end
                LastStuckPos = curPos
                LastStuckCheck = now
            end
        else
            ClimbBypassUntil = 0
            LastStuckPos = curPos
        end

        local stepGoal = dstPos
        local horizGap = Vector3.new(dstPos.X - curPos.X, 0, dstPos.Z - curPos.Z).Magnitude
        if now < ClimbBypassUntil and horizGap > 14 then
            if curPos.Y < (ClimbTargetY - 10) then
                -- Сначала вертикальный подъем над стеной
                stepGoal = Vector3.new(curPos.X, ClimbTargetY, curPos.Z)
            else
                -- Затем горизонтальный пролет над преградой
                stepGoal = Vector3.new(dstPos.X, ClimbTargetY, dstPos.Z)
            end
        end

        local delta = stepGoal - curPos
        local dist = delta.Magnitude

        if totalDist <= 6.0 then
            root.CFrame = DesiredGoalCFrame
        elseif dist > 0.05 then
            local step = math.min(dist, Config.FlightSpeed * dt)
            local nextPos = curPos + (delta.Unit * step)
            local horizDist = Vector3.new(dstPos.X - nextPos.X, 0, dstPos.Z - nextPos.Z).Magnitude
            if horizDist > 0.05 then
                root.CFrame = CFrame.new(nextPos, dstPos)
            else
                root.CFrame = CFrame.new(nextPos) * DesiredGoalCFrame.Rotation
            end
        end
    end
end))

