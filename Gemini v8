                                    DesiredGoalCFrame = nil
                                    root.CFrame = npcTargetCF
                                    hum:MoveTo(npcTargetCF.Position)
                                    task.wait(0.4)

                                    local comm = getCommF()
                                    local serverReply = nil
                                    if comm then
                                        pcall(function()
                                            serverReply = comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                                        end)
                                    end

                                    -- Сразу возвращаем полетное удержание, чтобы не падать с уступа Sky Adventurer
                                    GroundedAtNPC = false
                                    DesiredGoalCFrame = npcTargetCF

                                    QuestTriesAtNPC = QuestTriesAtNPC + 1
                                    CurrentTrackedQuestKey = expectedQuestKey
                                    logStatus("Взятие квеста #" .. tostring(QuestTriesAtNPC) .. " (Ответ: " .. tostring(serverReply) .. ")", myLvl, expectedQuestKey)
                                    task.wait(0.55)

                                    if isQuestGuiVisible() or QuestTriesAtNPC >= 3 then
                                        if not isQuestGuiVisible() then
                                            ForceFarmExpireTime = tick() + 30
                                        end
                                        QuestTriesAtNPC = 0
                                    end
                                end
                            else
                                -- ШАГ 2: КВЕСТ АКТИВЕН -> ИЩЕМ И УНИЧТОЖАЕМ МОБОВ С БЕЗОПАСНОЙ ВЫСОТЫ
                                GroundedAtNPC = false
                                QuestTriesAtNPC = 0
                                CurrentTrackedQuestKey = expectedQuestKey

                                local mob = findTargetMob(qData)
                                if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                                    ActiveCombatMob = mob
                                    local mPos = mob.HumanoidRootPart.Position
                                    tryFastPortalTransition(root, mPos)

                                    local distToMob = (root.Position - mPos).Magnitude
                                    logStatus("Бьем: " .. mob.Name .. " [HP: " .. tostring(math.floor(mob.Humanoid.Health)) .. "]", myLvl, expectedQuestKey)

                                    local attackPos = mPos + Vector3.new(0, Config.AttackHeight, Config.AttackBackOffset)
                                    DesiredGoalCFrame = CFrame.new(attackPos, mPos)

                                    if distToMob <= 50 then
                                        pullMobsTogether(qData.Mob, mPos)
                                    end
                                else
                                    ActiveCombatMob = nil
                                    local waypoints = getMobSpawnWaypoints(qData)
                                    if #waypoints > 1 and (tick() - LastPatrolSwitch) >= Config.SpawnPatrolInterval then
                                        LastPatrolSwitch = tick()
                                        PatrolIndex = (PatrolIndex % #waypoints) + 1
                                    end
                                    if PatrolIndex > #waypoints then PatrolIndex = 1 end

                                    local targetSpawnCF = waypoints[PatrolIndex]
                                    tryFastPortalTransition(root, targetSpawnCF.Position)
                                    requestStreamThrottled(targetSpawnCF.Position)

                                    local waitDist = (root.Position - targetSpawnCF.Position).Magnitude
                                    DesiredGoalCFrame = targetSpawnCF
                                    logStatus(
                                        string.format("Ждем/летим к спавну %s (%dм) [%d/%d]", qData.Mob, math.floor(waitDist), PatrolIndex, #waypoints),
                                        myLvl,
                                        expectedQuestKey
                                    )
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
