local IsHopping = false
local function performServerHop()
    if IsHopping or not isRunActive() then return end
    IsHopping = true
    logStatus("Поиск чистого сервера...")

    local placeId = game.PlaceId
    local currentJob = tostring(game.JobId)
    local teleportInitiated = false

    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
        local reqFunc = (http_request or request or (syn and syn.request))
        local rawBody = nil
        if reqFunc then
            local r = reqFunc({ Url = url, Method = "GET" })
            if r and tonumber(r.StatusCode) == 200 then
                rawBody = r.Body
            end
        elseif game.HttpGet then
            rawBody = game:HttpGet(url)
        end

        if rawBody then
            local decoded = HttpService:JSONDecode(rawBody)
            if decoded and type(decoded.data) == "table" then
                local list = decoded.data
                for i = #list, 2, -1 do
                    local j = math.random(i)
                    list[i], list[j] = list[j], list[i]
                end
                for i = 1, #list do
                    local srv = list[i]
                    if type(srv) == "table" and tostring(srv.id) ~= currentJob and tonumber(srv.playing) and srv.playing >= 2 and srv.playing <= 8 then
                        logStatus("Телепорт на сервер: " .. string.sub(tostring(srv.id), 1, 8))
                        teleportInitiated = true
                        TeleportService:TeleportToPlaceInstance(placeId, srv.id, LocalPlayer)
                        break
                    end
                end
            end
        end
    end)

    if not teleportInitiated then
        logStatus("Нативный TeleportService:Teleport...")
        pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end

    task.wait(8)
    IsHopping = false
end

