                            ActiveCombatMob = nil
                            DesiredGoalCFrame = SafeHealCFrame
                            logStatus(string.format("ОТХИЛ В НЕБЕ [HP: %d%% / %d%%]", math.floor(hpRatio * 100), math.floor(Config.RecoverHpThreshold * 100)), myLvl, expectedQuestKey)
                        else
