-- ============ main farm loop ============
task.spawn(function()
    ensureTeam()
    setStatus("Team ready. Farm starting...")
    print("[OLLIE v4] main loop entered")
    while true do
        task.wait(Env.OllieV4.AttackDelay)
        if not Env.OllieV4.Enabled then
            TargetCF = nil
        else
            pcall(function()
                if not LP.Team then
                    ensureTeam()
                end
                local char = LP.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not char or not root or not hum or hum.Health <= 0 then
                    setStatus("Waiting for character...")
                    return
                end

                if Env.OllieV4.Evasion then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            if (root.Position - p.Character.HumanoidRootPart.Position).Magnitude < Env.OllieV4.SafePlayerDist then
                                setStatus("Player nearby! Hopping...")
                                doServerHop()
                                return
                            end
                        end
                    end
                end

                local q, lvl = getQuest()

                if not isQuestActive(q.Mob) then
                    local npcDist = (root.Position - q.QPos.Position).Magnitude
                    setStatus("Fly to NPC (" .. math.floor(npcDist) .. "m)", lvl, q.QName)
                    TargetCF = q.QPos
                    if npcDist <= 12 then
                        local cf = getCommF()
                        if cf then
                            cf:InvokeServer("StartQuest", q.QName, q.QNum)
                            task.wait(0.4)
                        end
                    end
                else
                    local enemies = Workspace:FindFirstChild("Enemies")
                    local target = nil
                    if enemies then
                        for _, m in ipairs(enemies:GetChildren()) do
                            if m.Name == q.Mob then
                                local mh = m:FindFirstChildOfClass("Humanoid")
                                local mr = m:FindFirstChild("HumanoidRootPart")
                                if mh and mr and mh.Health > 0 then
                                    target = m
                                    break
                                end
                            end
                        end
                    end

                    if target then
                        local mp   = target.HumanoidRootPart.Position
                        local dist = (root.Position - mp).Magnitude
                        setStatus("Hit " .. q.Mob .. " HP:" .. math.floor(target.Humanoid.Health), lvl, q.QName)
                        TargetCF = CFrame.new(mp + Vector3.new(0, Env.OllieV4.HoverHeight, 0))
                        if dist <= 40 then
                            bringMobs(q.Mob, mp)
                            attack(target)
                        end
                    else
                        setStatus("Wait respawn " .. q.Mob, lvl, q.QName)
                        TargetCF = q.MPos * CFrame.new(0, 20, 0)
                    end
                end
            end)
        end
    end
end)

