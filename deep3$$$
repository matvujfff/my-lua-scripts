-- ============ server hop ============
local hopBusy = false
function doServerHop()
    if hopBusy then return end
    hopBusy = true
    setStatus("Looking for server...")
    pcall(function()
        local placeId = game.PlaceId
        local jobId   = game.JobId
        local url     = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
        local body
        local ok = pcall(function()
            local req = (http_request or request or (syn and syn.request))
            if req then
                local r = req({ Url = url, Method = "GET" })
                body = r and r.Body
            else
                body = game:HttpGet(url)
            end
        end)
        if ok and body then
            local decOk, decoded = pcall(function() return HttpService:JSONDecode(body) end)
            if decOk and decoded and decoded.data then
                for _, srv in ipairs(decoded.data) do
                    if srv.id ~= jobId and srv.playing and srv.playing >= 2 and srv.playing <= 8 then
                        setStatus("Hopping to new server...")
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(placeId, srv.id, LP)
                        end)
                        task.wait(4)
                        break
                    end
                end
            end
        end
    end)
    hopBusy = false
end

