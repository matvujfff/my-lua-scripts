local function getLevel()
    local d = LP:FindFirstChild("Data")
    if not d then return 1 end
    local l = d:FindFirstChild("Level")
    if not l then return 1 end
    return l.Value
end

local function getQuest()
    local lvl = getLevel()
    for _, q in ipairs(Quests) do
        if lvl >= q.Min and lvl <= q.Max then return q, lvl end
    end
    return Quests[#Quests], lvl
end

local function isQuestActive(mobName)
    local pg = LP:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local qf = main and main:FindFirstChild("Quest")
    if not qf or not qf.Visible then return false end
    local cont = qf:FindFirstChild("Container")
    local qt = cont and cont:FindFirstChild("QuestTitle")
    local title = qt and qt:FindFirstChild("Title")
    if title and title:IsA("TextLabel") then
        if not string.find(string.lower(title.Text), string.lower(mobName), 1, true) then
            pcall(function()
                local cf = getCommF()
                if cf then cf:InvokeServer("AbandonQuest") end
            end)
            return false
        end
        return true
    end
    return false
end

-- ============ flight (Delta-safe) ============
local TargetCF = nil
local ZeroVec  = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function(dt)
    if not Env.OllieV4.Enabled then return end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    pcall(function()
        -- Delta/Roblox: AssemblyLinearVelocity is the modern property; Velocity still aliases it
        if root.AssemblyLinearVelocity then
            root.AssemblyLinearVelocity = ZeroVec
        else
            root.Velocity = ZeroVec
        end
        if root.AssemblyAngularVelocity then
            root.AssemblyAngularVelocity = ZeroVec
        else
            root.RotVelocity = ZeroVec
        end
    end)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            pcall(function() p.CanCollide = false end)
        end
    end

    if TargetCF then
        local cur  = root.Position
        local dst  = TargetCF.Position
        local diff = dst - cur
        local dist = diff.Magnitude
        if dist <= 5 then
            root.CFrame = TargetCF
        else
            local step = math.min(dist, Env.OllieV4.FlightSpeed * dt)
            root.CFrame = CFrame.new(cur + diff.Unit * step)
        end
    end
end)

-- ============ weapon ============
local function equipWeapon()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return nil end
    local cur = char:FindFirstChildOfClass("Tool")
    if cur then return cur end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                pcall(function() hum:EquipTool(t) end)
                return t
            end
        end
    end
    return nil
end

-- ============ bring mobs (Delta-safe) ============
local function bringMobs(mobName, center)
    if not Env.OllieV4.BringMobs then return end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    pcall(function()
        -- Delta supports sethiddenproperty; fall back to setsimulationradius if present
        if sethiddenproperty then
            sethiddenproperty(LP, "SimulationRadius", math.huge)
        elseif setsimulationradius then
            setsimulationradius(math.huge)
        end
    end)
    for _, m in ipairs(enemies:GetChildren()) do
        if m.Name == mobName then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                if (r.Position - center).Magnitude <= 250 then
                    pcall(function()
                        r.CanCollide = false
                        r.AssemblyLinearVelocity = ZeroVec
                        r.CFrame     = CFrame.new(center)
                    end)
                end
            end
        end
    end
end

-- ============ attack (triple-path, Delta-safe) ============
local function attack(mob)
    local char = LP.Character
    if not char then return end

    if not char:FindFirstChild("HasBuso") then
        pcall(function()
            local cf = getCommF()
            if cf then cf:InvokeServer("Buso") end
        end)
    end

    local tool = equipWeapon()
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local net = modules and modules:FindFirstChild("Net")
        if not net then return end
        local atk = net:FindFirstChild("RE/RegisterAttack")
        local hit = net:FindFirstChild("RE/RegisterHit")
        if atk and hit and mob and mob:FindFirstChild("HumanoidRootPart") then
            atk:FireServer(0)
            hit:FireServer(mob.HumanoidRootPart, {{mob, mob.HumanoidRootPart}})
        end
    end)

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(400, 225))
    end)
end

