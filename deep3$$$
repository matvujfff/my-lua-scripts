-- ============ team selection ============
local function ensureTeam()
    local tries = 0
    while tries < 30 do
        tries = tries + 1

        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            return true
        end

        setStatus("Selecting team (Pirates) try " .. tries .. "...")

        pcall(function()
            local cf = getCommF()
            if cf then cf:InvokeServer("SetTeam", "Pirates") end
        end)

        -- GUI fallback (Delta: firesignal is supported)
        pcall(function()
            local pg = LP:FindFirstChild("PlayerGui")
            local main = pg and (pg:FindFirstChild("Main") or pg:FindFirstChild("Main (minimal)"))
            local ct = main and main:FindFirstChild("ChooseTeam")
            if not ct then return end
            local container = ct:FindFirstChild("Container")
            local pirates = container and container:FindFirstChild("Pirates")
            local pf = pirates and pirates:FindFirstChild("Frame")
            local btn = pf and (pf:FindFirstChild("TextButton") or pf:FindFirstChild("Button"))
            if btn and btn:IsA("TextButton") and firesignal then
                pcall(function() firesignal(btn.MouseButton1Click) end)
                pcall(function() firesignal(btn.MouseButton1Down) end)
                pcall(function() firesignal(btn.Activated) end)
            end
        end)

        task.wait(1)
    end
    return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") ~= nil
end

