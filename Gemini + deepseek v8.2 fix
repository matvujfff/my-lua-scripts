        return CachedCommF
    end
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    CachedCommF = rem and rem:FindFirstChild("CommF_")
    return CachedCommF
end

local function ensureTeam()
    if not LocalPlayer.Team or (LocalPlayer.Team.Name ~= "Pirates" and LocalPlayer.Team.Name ~= "Marines") then
        setFSMState("SELECT_TEAM", "Выбираем команду Pirates...")
        pcall(function()
            local comm = getCommF()
            if comm then
                comm:InvokeServer("SetTeam", "Pirates")
            end
        end)
        task.wait(1)
        return false
    end
    return true
