local function isGuiChainVisible(obj)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then
        return false
    end
    local parent = obj.Parent
    while parent do
        if parent:IsA("ScreenGui") then
            return parent.Enabled
        elseif parent:IsA("GuiObject") and not parent.Visible then
            return false
        end
        parent = parent.Parent
    end
    return false
end

local function getVisibleQuestFrame()
    if CachedQuestFrame then
        if not CachedQuestFrame.Parent then
            CachedQuestFrame = nil
        elseif isGuiChainVisible(CachedQuestFrame) then
            return CachedQuestFrame
        end
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV8_2" then
            local directQuest = gui:FindFirstChild("Quest")
            if directQuest and directQuest:IsA("GuiObject") then
                if isGuiChainVisible(directQuest) then
                    CachedQuestFrame = directQuest
                    return directQuest
                elseif not CachedQuestFrame then
                    CachedQuestFrame = directQuest
                end
            end
        end
    end

    if (os.clock() - LastFullGuiSearchClock) < 0.5 then
        return (CachedQuestFrame and isGuiChainVisible(CachedQuestFrame)) and CachedQuestFrame or nil
    end
    LastFullGuiSearchClock = os.clock()

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV8_2" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") then
                    if isGuiChainVisible(obj) then
                        CachedQuestFrame = obj
                        return obj
                    elseif not CachedQuestFrame then
                        CachedQuestFrame = obj
                    end
                end
            end
        end
    end

    return (CachedQuestFrame and isGuiChainVisible(CachedQuestFrame)) and CachedQuestFrame or nil
end

local function isQuestGuiVisible()
    return getVisibleQuestFrame() ~= nil
end

local function waitForQuestGuiState(targetVisible, timeoutSec)
    local t0 = os.clock()
    while isCurrentRunActive() and (os.clock() - t0) < timeoutSec do
        if isQuestGuiVisible() == targetVisible then
            return true
        end
        task.wait(0.1)
    end
    return isQuestGuiVisible() == targetVisible
end

local function doesTextMatchQuestEntry(qEntry, textLower)
    for _, enStem in ipairs(qEntry.EnStems or {string.lower(qEntry.Mob)}) do
        if string.find(textLower, enStem, 1, true) then
            local superstringConflict = false
            for _, other in ipairs(qEntry._AllQuestsRef or {}) do
                if other._Index ~= qEntry._Index then
                    for _, otherEn in ipairs(other.EnStems or {string.lower(other.Mob)}) do
                        if #otherEn > #enStem
                            and string.find(otherEn, enStem, 1, true)
                            and string.find(textLower, otherEn, 1, true)
                        then
                            superstringConflict = true
                            break
                        end
                    end
                end
                if superstringConflict then break end
            end
            if not superstringConflict then
                return true
            end
        end
    end

    local excludedByRu = false
    for _, exWord in ipairs(qEntry.ExcludeRu or {}) do
        if string.find(textLower, exWord, 1, true) then
            excludedByRu = true
            break
        end
    end

    if not excludedByRu then
        for _, ruStem in ipairs(qEntry.RuStems or {}) do
            if string.find(textLower, ruStem, 1, true) then
                return true
            end
        end
    end

    return false
end

local function inspectActiveQuestMatch(qData)
    local qFrame = getVisibleQuestFrame()
    if not qFrame then
        return false, "HIDDEN", "no_visible_quest_frame", ""
    end

    local parts = {}
    for _, desc in ipairs(qFrame:GetDescendants()) do
        if desc:IsA("TextLabel") and isGuiChainVisible(desc) and type(desc.Text) == "string" and #desc.Text > 0 then
            table.insert(parts, desc.Text)
        end
    end

    local rawCombined = table.concat(parts, " | ")
    if #rawCombined == 0 then
        return false, "HIDDEN", "empty_quest_frame", ""
    end

    local combinedLower = string.lower(rawCombined)
    local shortSnippet = string.sub(rawCombined, 1, 60)

    if doesTextMatchQuestEntry(qData, combinedLower) then
        return true, "MATCH", shortSnippet, rawCombined
    end

    for _, otherQuest in ipairs(qData._AllQuestsRef or {}) do
        if otherQuest._Index ~= qData._Index then
            if doesTextMatchQuestEntry(otherQuest, combinedLower) then
                return true, "MISMATCH", shortSnippet, rawCombined
            end
        end
    end

    return true, "UNDECIDED_LOCALIZED", shortSnippet, rawCombined
end

local function waitForQuestActivationDiff(qData, visBefore, rawBefore, timeoutSec, anchorRoot, anchorCF)
    local t0 = os.clock()
    while isCurrentRunActive() and (os.clock() - t0) < timeoutSec do
        if anchorRoot and anchorCF then
            pcall(function() anchorRoot.CFrame = anchorCF end)
        end
        local visNow, matchNow, snippetNow, rawNow = inspectActiveQuestMatch(qData)
        if visNow and #rawNow > 0 then
            if matchNow == "MATCH" then
                return true, "MATCH_CONFIRMED", visNow, matchNow, snippetNow, rawNow
            elseif not visBefore and matchNow ~= "MISMATCH" then
                return true, "OPENED_NEW_GUI", visNow, matchNow, snippetNow, rawNow
            elseif visBefore and rawNow ~= rawBefore and matchNow ~= "MISMATCH" then
                return true, "TEXT_CHANGED_AFTER_START", visNow, matchNow, snippetNow, rawNow
            end
        end
        task.wait(0.1)
    end

    local visEnd, matchEnd, snippetEnd, rawEnd = inspectActiveQuestMatch(qData)
    return false, "NO_STATE_CHANGE", visEnd, matchEnd, snippetEnd, rawEnd
end

