local function resetNavBypass(keepAttemptCount)
    NavBypass.Phase = "NONE"
    NavBypass.PhaseStartedAt = 0
    NavBypass.LastCheckClock = os.clock()
    NavBypass.LastSamplePos = nil
    NavBypass.LastGoalDist = math.huge
    NavBypass.StuckTicks = 0
