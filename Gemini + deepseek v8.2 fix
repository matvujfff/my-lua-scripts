            then
                HopFSM.Status = "FAILED"
                HopFSM.FailReason = "GuiError:" .. msg
            end
        end
    end))
end)

local function waitTeleportAttemptOutcome(timeoutSec)
    local startClock = os.clock()
    while isCurrentRunActive() do
        if tostring(game.JobId) ~= "" and tostring(game.JobId) ~= HopFSM.OriginJobId then
            HopFSM.Status = "IDLE"
            return "NEW_JOB"
        end
        if HopFSM.Status == "FAILED" then
            return "EXPLICIT_FAIL"
        end
        if (os.clock() - startClock) >= timeoutSec then
            HopFSM.Status = "INDETERMINATE"
            return "INDETERMINATE"
        end
        task.wait(0.25)
    end
    return "INDETERMINATE"
end

local function performServerHop()
    if not isCurrentRunActive() or FSM.Completed then return end
    if HopFSM.Status == "IN_FLIGHT" or HopFSM.Status == "INDETERMINATE" then
        setFSMState(FSM.State, "Смена сервера уже активна (" .. HopFSM.Status .. "). Повторы заблокированы.")
        return
    end

    local placeId = game.PlaceId
    local currentJob = tostring(game.JobId)
    HopFSM.OriginJobId = currentJob

    local candidates = {}
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
        local reqFunc = (http_request or request or (syn and syn.request))
        local rawBody = nil
        if reqFunc then
            local r = reqFunc({ Url = url, Method = "GET" })
            if r and tonumber(r.StatusCode) == 200 then
                rawBody = r.Body
            end
        elseif game.HttpGet then
            rawBody = game:HttpGet(url)
        end

        if rawBody then
            local decoded = HttpService:JSONDecode(rawBody)
            if decoded and type(decoded.data) == "table" then
                for _, srv in ipairs(decoded.data) do
                    if type(srv) == "table" and srv.id and tostring(srv.id) ~= currentJob and tonumber(srv.playing) and srv.playing >= 2 and srv.playing <= 9 then
                        table.insert(candidates, tostring(srv.id))
                    end
                end
            end
        end
    end)

    for i = 1, math.min(#candidates, 3) do
        if not isCurrentRunActive() or FSM.Completed then return end
        local targetJobId = candidates[i]
        HopFSM.Status = "IN_FLIGHT"
        HopFSM.FailReason = ""
        setFSMState(FSM.State, "Телепорт по JobId: " .. string.sub(targetJobId, 1, 8))

        local callOk, callErr = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, targetJobId, LocalPlayer)
        end)
        if not callOk then
            HopFSM.Status = "FAILED"
            HopFSM.FailReason = tostring(callErr)
        end

        local outcome = waitTeleportAttemptOutcome(12.0)
        if outcome == "NEW_JOB" or outcome == "INDETERMINATE" then
            if outcome == "INDETERMINATE" then
                setFSMState(FSM.State, "Ожидание ответа сервера при телепорте (повторы заблокированы)...")
            end
            return
        end
        HopFSM.Status = "IDLE"
        task.wait(0.5)
    end

    if not isCurrentRunActive() or FSM.Completed then return end
    HopFSM.Status = "IN_FLIGHT"
    HopFSM.FailReason = ""
    setFSMState(FSM.State, "Нативный TeleportService:Teleport...")

    local nativeOk, nativeErr = pcall(function()
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
    if not nativeOk then
        HopFSM.Status = "FAILED"
        HopFSM.FailReason = tostring(nativeErr)
    end

    local finalOutcome = waitTeleportAttemptOutcome(15.0)
    if finalOutcome == "EXPLICIT_FAIL" then
        HopFSM.Status = "IDLE"
        setFSMState(FSM.State, "Смена сервера отклонена: " .. tostring(HopFSM.FailReason))
    end
end

