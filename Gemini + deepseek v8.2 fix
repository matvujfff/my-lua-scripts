-- 10. ГЛАВНЫЙ УПРАВЛЯЮЩИЙ АВТОМАТ (FSM V8.2 — MAX_LEVEL 700)
-- ============================================================================
task.spawn(function()
    while isCurrentRunActive() and not FSM.Completed and task.wait(Config.LoopInterval) do
        if not isCurrentRunActive() or FSM.Completed then
            break
        end

        if not Env.OllieV8_Enabled then
            FSM.DesiredGoalCFrame = nil
            FSM.GroundedAtNPC = false
            FSM.ActiveCombatMob = nil
        else
            local loopOk, loopErr = pcall(function()
                if not ensureTeam() then return end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not char or not root or not hum or hum.Health <= 0 then
                    FSM.DesiredGoalCFrame = nil
                    FSM.GroundedAtNPC = false
                    FSM.IsHealingState = false
                    FSM.SafeHealCFrame = nil
                    FSM.ActiveCombatMob = nil
                    setFSMState("WAIT_SPAWN", "Ожидание спавна персонажа...")
                    return
                end

                clearBlockingDialogue()

                local qData, myLvl, progressStatus = evaluatePlayerProgressAndQuest()
                if progressStatus == "DATA_NOT_LOADED" then
                    setFSMState("WAIT_DATA", "Ожидание загрузки Data.Level...")
                    return
                elseif progressStatus == "GOAL_REACHED" then
                    task.wait(0.3)
                    local _, recheckLvl, recheckStatus = evaluatePlayerProgressAndQuest()
                    if recheckStatus == "GOAL_REACHED" and recheckLvl >= Config.MaxLevel then
                        setFSMState("COMPLETED", "ФАРМ ОКОНЧЕН — ВСЕ ПОСТАВЛЕННЫЕ ЦЕЛИ ВЫПОЛНЕНЫ", recheckLvl, "COMPLETED")
                        updateHudCompletionState(recheckLvl)

                        if not FSM.CompletionNotified then
                            FSM.CompletionNotified = true
                            print(string.format("[OLLIE V8.2] ФАРМ ОКОНЧЕН — ВСЕ ПОСТАВЛЕННЫЕ ЦЕЛИ ВЫПОЛНЕНЫ (LVL %d / %d)", recheckLvl, Config.MaxLevel))
                            sendScreenNotification("OLLIE ENGINE V8.2", "ФАРМ ОКОНЧЕН — ВСЕ ПОСТАВЛЕННЫЕ ЦЕЛИ ВЫПОЛНЕНЫ", 10)
                        end

                        stopAllBackgroundTasksOnCompletion()
                        return
                    else
                        setFSMState("VERIFY_COMPLETION", "Повторная проверка достижения уровня " .. tostring(Config.MaxLevel) .. "...", recheckLvl, "VERIFY")
                        return
                    end
                elseif not qData then
                    FSM.DesiredGoalCFrame = nil
                    FSM.GroundedAtNPC = false
                    FSM.ActiveCombatMob = nil
                    restoreModifiedCollisions()
                    setFSMState("OUT_OF_RANGE", "Уровень " .. tostring(myLvl) .. " вне допустимого диапазона!", myLvl, "NONE")
                    return
                end

                local expectedQuestKey = qData.QName .. "_" .. tostring(qData.QNum)

                -- === ПРОВЕРКА ЗДОРОВЬЯ (HEALING FSM) ===
                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if Config.SafeModeEnabled then
                    if hpRatio < Config.LowHpThreshold and not FSM.IsHealingState then
                        FSM.IsHealingState = true
                        FSM.GroundedAtNPC = false
                        FSM.ActiveCombatMob = nil
                        FSM.SafeHealCFrame = CFrame.new(root.Position.X, math.max(root.Position.Y + Config.SafeSkyOffset, 250), root.Position.Z)
                    elseif FSM.IsHealingState and hpRatio >= Config.RecoverHpThreshold then
                        FSM.IsHealingState = false
                        FSM.SafeHealCFrame = nil
                    end
                else
                    FSM.IsHealingState = false
                end

                if FSM.IsHealingState and FSM.SafeHealCFrame then
                    FSM.GroundedAtNPC = false
                    FSM.ActiveCombatMob = nil
                    FSM.DesiredGoalCFrame = FSM.SafeHealCFrame
                    setFSMState(
                        "HEALING",
                        string.format("ОТХИЛ В НЕБЕ [HP: %d%% / %d%%]", math.floor(hpRatio * 100), math.floor(Config.RecoverHpThreshold * 100)),
                        myLvl,
                        expectedQuestKey
                    )
                    return
                end

                -- === ПРОВЕРКА ТЕКУЩЕГО КВЕСТА (CHECK_QUEST / ABANDON_QUEST) ===
                local guiVisible, matchState, guiSnippet, guiRawText = inspectActiveQuestMatch(qData)

                if not guiVisible then
                    if FSM.CurrentTrackedQuestKey ~= nil then
                        print(string.format("[QUEST DIAG] Окно Quest скрыто -> сброс CurrentTrackedQuestKey (%s -> nil).", tostring(FSM.CurrentTrackedQuestKey)))
                    end
                    FSM.CurrentTrackedQuestKey = nil
                else
                    local shouldAbandonImmediately = false
                    local abandonReason = nil

                    if FSM.CurrentTrackedQuestKey ~= nil and FSM.CurrentTrackedQuestKey ~= expectedQuestKey then
                        shouldAbandonImmediately = true
                        abandonReason = string.format("Смена целевого квеста по уровню (%s -> %s)", tostring(FSM.CurrentTrackedQuestKey), expectedQuestKey)
                    elseif matchState == "MISMATCH" then
                        shouldAbandonImmediately = true
                        abandonReason = string.format("Явный MISMATCH текста GUI ('%s') с целевым мобом %s", tostring(guiSnippet), qData.Mob)
                    elseif matchState == "MATCH" then
                        FSM.CurrentTrackedQuestKey = expectedQuestKey
                    elseif matchState == "UNDECIDED_LOCALIZED" then
                        if FSM.CurrentTrackedQuestKey ~= expectedQuestKey then
                            print(string.format(
                                "[QUEST DIAG] Нераспознанное окно Quest (state=%s, tracked=%s, expected=%s, text='%s'). Летим к NPC для проверки диффа.",
                                matchState,
                                tostring(FSM.CurrentTrackedQuestKey),
                                expectedQuestKey,
                                tostring(guiSnippet)
                            ))
                        end
                    end

                    if shouldAbandonImmediately then
                        FSM.ActiveCombatMob = nil
                        setFSMState("ABANDON_QUEST", "Отмена старого квеста: " .. tostring(abandonReason), myLvl, expectedQuestKey)
                        print(string.format("[QUEST DIAG] Немедленный AbandonQuest! Причина: %s", tostring(abandonReason)))
                        local comm = getCommF()
                        if comm then
                            pcall(function() comm:InvokeServer("AbandonQuest") end)
                        end
                        FSM.CurrentTrackedQuestKey = nil
                        waitForQuestGuiState(false, 2.5)
                        guiVisible, matchState, guiSnippet, guiRawText = inspectActiveQuestMatch(qData)
                    end
                end

                local hasVerifiedQuest = guiVisible and (FSM.CurrentTrackedQuestKey == expectedQuestKey)

                if not hasVerifiedQuest then
                    -- ШАГ 1: MOVE_TO_NPC / TAKE_QUEST
                    FSM.ActiveCombatMob = nil
                    local npcTargetCF = getLiveNPCCFrame(qData)

                    tryFastPortalTransition(root, npcTargetCF.Position)
                    local npcDist = (root.Position - npcTargetCF.Position).Magnitude

                    if npcDist > 7 then
                        FSM.GroundedAtNPC = false
                        FSM.DesiredGoalCFrame = npcTargetCF
                        if NavBypass.Phase == "BLOCKED_HALT" then
                            setFSMState("BLOCKED_HALT", "ПАУЗА ОБХОДА ПРЕГРАДЫ (авто-повтор через 8 с)...", myLvl, expectedQuestKey)
                        else
                            setFSMState(
                                "MOVE_TO_NPC",
                                string.format("Летим к NPC %s (%dм) [GUI:%s]", tostring(qData.NPC), math.floor(npcDist), matchState),
                                myLvl,
                                expectedQuestKey
                            )
                        end
                        requestStreamThrottled(npcTargetCF.Position)
                    else
                        requestStreamThrottled(npcTargetCF.Position)
                        local visBefore, stateBefore, snipBefore, rawBefore = inspectActiveQuestMatch(qData)

                        FSM.GroundedAtNPC = true
                        FSM.DesiredGoalCFrame = nil
                        restoreModifiedCollisions()
                        root.CFrame = npcTargetCF
                        hum:MoveTo(npcTargetCF.Position)
                        task.wait(0.35)

                        local comm = getCommF()
                        local invokeOk = false
                        local serverReply = "no_comm"
                        if comm then
                            root.CFrame = npcTargetCF
                            invokeOk, serverReply = pcall(function()
                                return comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                            end)
                        end

                        FSM.GroundedAtNPC = false
                        FSM.DesiredGoalCFrame = npcTargetCF
                        FSM.QuestTriesAtNPC = FSM.QuestTriesAtNPC + 1

                        local diffConfirmed, diffReason, visAfter, matchAfter, snipAfter, rawAfter =
                            waitForQuestActivationDiff(qData, visBefore, rawBefore, 1.5, root, npcTargetCF)

                        print(string.format(
                            "[QUEST DIAG] Try #%d | Quest=%s (Mob=%s) | pcall=%s reply=%s | BEFORE(vis=%s, st=%s, txt='%s') -> AFTER(vis=%s, st=%s, txt='%s') | diff=%s(%s)",
                            FSM.QuestTriesAtNPC,
                            expectedQuestKey,
                            qData.Mob,
                            tostring(invokeOk),
                            tostring(serverReply),
                            tostring(visBefore),
                            tostring(stateBefore),
                            tostring(snipBefore),
                            tostring(visAfter),
                            tostring(matchAfter),
                            tostring(snipAfter),
                            tostring(diffConfirmed),
                            tostring(diffReason)
                        ))

                        if diffConfirmed then
                            FSM.CurrentTrackedQuestKey = expectedQuestKey
                            FSM.QuestTriesAtNPC = 0
                            FSM.UnverifiedTriesAtNPC = 0
                            setFSMState(
                                "QUEST_CONFIRMED",
                                string.format("Квест принят [%s]! Переход к бою.", tostring(diffReason)),
                                myLvl,
                                expectedQuestKey
                            )
                        else
                            if visBefore and visAfter and rawAfter == rawBefore then
                                FSM.UnverifiedTriesAtNPC = FSM.UnverifiedTriesAtNPC + 1
                            else
                                FSM.UnverifiedTriesAtNPC = 0
                            end

                            if FSM.UnverifiedTriesAtNPC >= 2 then
                                print(string.format(
                                    "[QUEST DIAG] Нераспознанное окно Quest не изменилось после 2 попыток StartQuest у %s (txt='%s'). Вызываем AbandonQuest!",
                                    tostring(qData.NPC),
                                    tostring(snipAfter)
                                ))
                                setFSMState("ABANDON_QUEST", "Очистка зависшего старого квеста в слоте...", myLvl, expectedQuestKey)
                                if comm then
                                    pcall(function() comm:InvokeServer("AbandonQuest") end)
                                end
                                FSM.CurrentTrackedQuestKey = nil
                                waitForQuestGuiState(false, 2.5)
                                FSM.QuestTriesAtNPC = 0
                                FSM.UnverifiedTriesAtNPC = 0
                            else
                                setFSMState(
                                    "TAKE_QUEST",
                                    string.format(
                                        "Взятие #%d: отв=%s дифф=%s GUI=%s(%s)",
                                        FSM.QuestTriesAtNPC,
                                        tostring(serverReply),
                                        tostring(diffReason),
                                        tostring(visAfter),
                                        tostring(matchAfter)
                                    ),
                                    myLvl,
                                    expectedQuestKey
                                )
                                if FSM.QuestTriesAtNPC >= 4 then
                                    print("[QUEST DIAG] 4 попытки у NPC без диффа GUI -> сброс счетчика попыток.")
                                    FSM.QuestTriesAtNPC = 0
                                end
                            end
                        end
                    end
                else
                    -- ШАГ 2: COMBAT / PATROL_SPAWN
                    FSM.GroundedAtNPC = false
                    FSM.QuestTriesAtNPC = 0
                    FSM.UnverifiedTriesAtNPC = 0

                    local mob = findTargetMob(qData)
                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                        FSM.ActiveCombatMob = mob
                        local mPos = mob.HumanoidRootPart.Position
                        tryFastPortalTransition(root, mPos)

                        local distToMob = (root.Position - mPos).Magnitude
                        local attackPos = mPos + Vector3.new(0, Config.AttackHeight, Config.AttackBackOffset)
                        FSM.DesiredGoalCFrame = CFrame.new(attackPos, mPos)

                        if NavBypass.Phase == "BLOCKED_HALT" then
                            setFSMState("BLOCKED_HALT", "ПАУЗА ОБХОДА К МОБУ (авто-повтор через 8 с)...", myLvl, expectedQuestKey)
                        else
                            setFSMState(
                                "COMBAT",
                                "Бьем: " .. mob.Name .. " [HP: " .. tostring(math.floor(mob.Humanoid.Health)) .. "]",
                                myLvl,
                                expectedQuestKey
                            )
                        end

                        if distToMob <= 50 then
                            pullMobsTogether(qData.Mob, mPos)
                        end
                    else
                        FSM.ActiveCombatMob = nil
                        local waypoints = getMobSpawnWaypoints(qData)

                        if #waypoints > 1 and (os.clock() - FSM.LastPatrolSwitchClock) >= Config.SpawnPatrolInterval then
                            FSM.LastPatrolSwitchClock = os.clock()
                            FSM.PatrolIndex = (FSM.PatrolIndex % #waypoints) + 1
                        end
                        if FSM.PatrolIndex > #waypoints then
                            FSM.PatrolIndex = 1
                        end

                        local targetSpawnCF = waypoints[FSM.PatrolIndex]
                        tryFastPortalTransition(root, targetSpawnCF.Position)
                        requestStreamThrottled(targetSpawnCF.Position)

                        local waitDist = (root.Position - targetSpawnCF.Position).Magnitude
                        FSM.DesiredGoalCFrame = targetSpawnCF

                        if NavBypass.Phase == "BLOCKED_HALT" then
                            setFSMState(
                                "BLOCKED_HALT",
                                string.format("ПАУЗА ОБХОДА К СПАВНУ [Точка %d/%d] (авто-повтор)", FSM.PatrolIndex, #waypoints),
                                myLvl,
                                expectedQuestKey
                            )
                        elseif waitDist <= 8 then
                            setFSMState(
                                "PATROL_SPAWN",
                                string.format("Ждем спавн %s [Точка %d/%d]", qData.Mob, FSM.PatrolIndex, #waypoints),
                                myLvl,
                                expectedQuestKey
                            )
                        else
                            setFSMState(
                                "PATROL_SPAWN",
                                string.format("Летим к спавну %s (%dм) [Точка %d/%d]", qData.Mob, math.floor(waitDist), FSM.PatrolIndex, #waypoints),
                                myLvl,
                                expectedQuestKey
                            )
                        end
                    end
                end
            end)

            if not loopOk then
                setFSMState("ERROR_RECOVERY", "Ошибка цикла (перехвачена): " .. string.sub(tostring(loopErr), 1, 36))
            end
        end
    end
end)
