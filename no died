-- === 3. ПОЛУЧЕНИЕ АКТИВНЫХ КОМПОНЕНТОВ ПЕРСОНАЖА ===
local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil, nil, nil end
    return char, root, hum
end

-- === 4. ЖЕСТКИЙ NOCLIP И АНТИ-ГРАВИТАЦИЯ (ЧТОБЫ НЕ ПАДАТЬ К МОБАМ) ===
RunService.Stepped:Connect(function()
    if not getgenv().FarmConfig.Enabled then return end
    local char, root, hum = getCharacterParts()
    if not char or not root or not hum then return end

    -- Отключаем коллизии всех частей тела, чтобы не застревать в текстурах
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end

    -- Держим BodyVelocity в корне, чтобы гравитация и удары мобов не сбивали высоту
    local bv = root:FindFirstChild("OllieHoverLock")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieHoverLock"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root
    else
        bv.Velocity = Vector3.zero
    end
end)

-- === 5. АВТО-ЭКИПИРОВКА И ХАКИ (BUSO) ===
local function equipBestWeapon()
    local char, _, hum = getCharacterParts()
    if not char or not hum then return end

    -- Авто-включение Хаки Вооружения (дает защиту и урон по логиям)
    if getgenv().FarmConfig.AutoBuso and not char:FindFirstChild("HasBuso") then
        pcall(function()
            if CommF then CommF:InvokeServer("Buso") end
        end)
    end

    -- Проверяем, одето ли уже нужное оружие
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.ToolTip == getgenv().FarmConfig.WeaponType or item.Name == getgenv().FarmConfig.WeaponType) then
            return item
        end
    end

    -- Ищем в рюкзаке по типу (Melee / Sword) или имени
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == getgenv().FarmConfig.WeaponType or tool.Name == getgenv().FarmConfig.WeaponType) then
                hum:EquipTool(tool)
                return tool
            end
        end
    end
end

