        local gainedLvl = math.max(0, lvl - (FSM.StartLevel or lvl))
        local gainedBeli = math.max(0, beli - (FSM.StartBeli or beli))
        local topFruitsStr = "Копим гачу/дроп"
        if #AccountValuation.HighValueFruitsList > 0 then
