    local best, bestDist = nil, 600
    local folders = { Workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs") }
    for _, folder in ipairs(folders) do
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                local lname = string.lower(npc.Name)
                local matched = false
                for _, n in ipairs(info.Names) do if lname == string.lower(n) then matched = true; break end end
                if matched then
                    local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
