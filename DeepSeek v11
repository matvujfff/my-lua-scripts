local function getVisibleQuestObject(expectedMobName)
    if CachedQuestObj and CachedQuestObj.Parent then
        local screenGui = CachedQuestObj:FindFirstAncestorOfClass("ScreenGui")
        if screenGui and isGuiChainVisible(CachedQuestObj, screenGui) then
            if expectedMobName then
                local txt = ""
                for _, d in ipairs(CachedQuestObj:GetDescendants()) do
                    if d:IsA("TextLabel") then txt = txt .. " " .. string.lower(d.Text) end
                end
                if string.find(txt, string.lower(expectedMobName), 1, true) then
                    return CachedQuestObj, screenGui
                end
            else
                return CachedQuestObj, screenGui
            end
        end
    end
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil, nil end
    local mainGui = pGui:FindFirstChild("Main")
    local directQuest = mainGui and mainGui:FindFirstChild("Quest")
    if directQuest and directQuest:IsA("GuiObject") and mainGui:IsA("ScreenGui") then
        if isGuiChainVisible(directQuest, mainGui) then
            CachedQuestObj = directQuest
            return directQuest, mainGui
        end
        return nil, nil
    end
    if (tick() - LastFullQuestScan) < 2.0 then return nil, nil end
    LastFullQuestScan = tick()
    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV11_0" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") and obj.Visible then
                    if isGuiChainVisible(obj, gui) then CachedQuestObj = obj; return obj, gui end
                end
            end
        end
    end
    return nil, nil
