local function mobNameMatches(enemyName, mobName)
    local n, m = string.lower(enemyName), string.lower(mobName)
    if string.sub(n, 1, #m) ~= m then return false end
    local c = string.sub(n, #m + 1, #m + 1)
    return c == "" or c == " " or c == "["
end

local function dragonBreathBlocked()
    local d = LocalPlayer:FindFirstChild("Data")
    local frag = d and d:FindFirstChild("Fragments")
    return frag and (tonumber(frag.Value) or 0) < Config.DragonClawFragmentCost
end

local function styleChainDone()
    if not Config.AutoRotateFightingStyles then return true end
    local t = Config.StyleTargetMastery; local sm = AccountValuation.StyleMastery
    if (AccountValuation.StyleTopRank or 0) < 4 then return false end
    if (sm[2] or 0) < t or (sm[3] or 0) < t or (sm[4] or 0) < t then return false end
    if dragonBreathBlocked() then return true end
    return (sm[5] or 0) >= t and (sm[6] or 0) >= t
end

local function getQuestByLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    local lvl = l and math.floor(l.Value) or 1
    if Config.StopOnGoalCompleted and lvl >= Config.MaxLevel then
        local extra = tonumber(Config.StyleGateMaxExtraLevels) or 0
        local overCap = extra > 0 and lvl >= Config.MaxLevel + extra
        if styleChainDone() or overCap then return nil, lvl, "COMPLETED" end
    end
    for i = 1, #ActiveQuests do
        local q = ActiveQuests[i]
        if lvl >= q.Min and lvl <= q.Max then return q, lvl, "OK" end
    end
    if lvl < ActiveQuests[1].Min then return ActiveQuests[1], lvl, "OK" end
    local maxInThisSea = ActiveQuests[#ActiveQuests].Max
    if lvl > maxInThisSea then
        if CurrentSeaNum == 1 and Config.AutoSea2Transition then return ActiveQuests[#ActiveQuests], lvl, "AUTO_SEA2_TRANSITION" end
        -- ✅ FIX: Sea 2 → Sea 3 при 1500+
        if CurrentSeaNum == 2 and Config.AutoSea3Transition then return ActiveQuests[#ActiveQuests], lvl, "AUTO_SEA3_TRANSITION" end
        if Config.ContinueFarmIfNextSeaLocked then return ActiveQuests[#ActiveQuests], lvl, "OK" end
        return nil, lvl, "NEED_NEXT_SEA"
    end
    return ActiveQuests[#ActiveQuests], lvl, "OK"
end

local function getLiveNPCCFrame(qData)
    local npcFolders = { Workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs") }
    if qData.NPC then
        local bestNamedCF, bestNamedDist = nil, 260
        for _, folder in ipairs(npcFolders) do
            if folder then
                for _, npc in ipairs(folder:GetChildren()) do
                    if npc.Name == qData.NPC or npc.Name == "Quest Giver" then
                        local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                        if r then
                            if not qData.QPos then return r.CFrame * CFrame.new(0, 0, -2.5) end
                            local d = (r.Position - qData.QPos.Position).Magnitude
                            if d < bestNamedDist then bestNamedDist = d; bestNamedCF = r.CFrame * CFrame.new(0, 0, -2.5) end
                        end
                    end
                end
            end
        end
        if bestNamedCF then return bestNamedCF end
    end
    if qData.QPos then
        local bestCF, bestDist = nil, 70
        for _, folder in ipairs(npcFolders) do
            if folder then
                for _, npc in ipairs(folder:GetChildren()) do
                    local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                    if r then
                        local d = (r.Position - qData.QPos.Position).Magnitude
                        if d < bestDist then bestDist = d; bestCF = r.CFrame * CFrame.new(0, 0, -2.5) end
                    end
                end
            end
        end
        if bestCF then return bestCF end
    end
    return qData.QPos or CFrame.new()
end

local WaypointCache = { Key = "", Time = 0, List = {} }
local function getMobSpawnWaypoints(qData)
    local key = qData.QName .. "_" .. tostring(qData.QNum)
    if WaypointCache.Key == key and (tick() - WaypointCache.Time) < 10.0 and #WaypointCache.List > 0 then
        return WaypointCache.List
    end
    local points = {}
    if qData.MPos then table.insert(points, qData.MPos * CFrame.new(0, Config.PatrolHoverHeight, 0)) end
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if mobNameMatches(sp.Name, qData.Mob) then
                local pos = (sp:IsA("BasePart") and sp.Position) or (sp:IsA("Model") and sp.PrimaryPart and sp.PrimaryPart.Position)
                if pos and (not qData.MPos or math.abs(pos.Y - qData.MPos.Position.Y) <= 120) then
                    local hoverPos = pos + Vector3.new(0, Config.PatrolHoverHeight, 0)
                    local dup = false
                    for _, ex in ipairs(points) do if (ex.Position - hoverPos).Magnitude < 35 then dup = true; break end end
                    if not dup then table.insert(points, CFrame.new(hoverPos)) end
                end
            end
        end
    end
    if #points == 0 then table.insert(points, getLiveNPCCFrame(qData) * CFrame.new(0, Config.PatrolHoverHeight, 0)) end
    WaypointCache.Key = key; WaypointCache.Time = tick(); WaypointCache.List = points
    return points
end

