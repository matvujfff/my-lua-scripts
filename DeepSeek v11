local function executeAttack(mob)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    -- Buso
    if not char:FindFirstChild("HasBuso") and (tick() - FSM.LastBusoTry) >= Config.BusoRetryCooldown then
        FSM.LastBusoTry = tick()
        task.spawn(function()
            pcall(function() local comm = getCommF(); if comm then comm:InvokeServer("Buso") end end)
        end)
    end

    -- Кэш Tool (не спамим EquipTool каждый тик)
    if not FSM.CurrentTool or not FSM.CurrentTool.Parent or FSM.CurrentTool.Parent ~= char then
        FSM.CurrentTool = equipBestTool()
    end
    local tool = FSM.CurrentTool
    if tool and tool:IsA("Tool") then
        pcall(function() tool:Activate() end)
    end

    -- КАНАЛ 1: Локальный контроллер (если доступен через getupvalues/getgc)
    pcall(function()
        local ctrl = getCombatFrameworkCtrl()
        if ctrl and ctrl.attack then
            ctrl.timeToNextAttack = 0
            ctrl.attacking = false
            ctrl.blocking = false
            ctrl.timeToNextBlock = 0
            ctrl.increment = 3
            ctrl.hitboxMagnitude = 120
            if ctrl.humanoid then ctrl.humanoid.AutoRotate = true end
            ctrl:attack()
        end
    end)

    -- КАНАЛ 2: RigControllerEvent (высокая надёжность, ограничение частоты)
    if (tick() - FSM.LastRigHit) >= 0.06 then
        FSM.LastRigHit = tick()
        pcall(function()
            local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent")
            local hits = collectNearbyMobBladeHits(65, 30)
            if rigEvent and #hits > 0 then
                rigEvent:FireServer("hit", hits, 2, "")
            end
        end)
    end

    -- КАНАЛ 3: RegisterAttack + RegisterHit (анти-бан: 1 раз в 0.10–0.14с)
    if (tick() - FSM.LastRegisterHit) >= (Config.FastAttackInterval + math.random() * Config.AttackJitter) then
        FSM.LastRegisterHit = tick()
        pcall(function()
            local regAtk, regHit = getCombatRemotes()
            if not regAtk or not regHit then return end
            local hits = collectNearbyMobBladeHits(65, 30)
            if #hits == 0 then
                if mob and mob:FindFirstChild("HumanoidRootPart") then
                    hits = { mob.HumanoidRootPart }
                else
                    return
                end
            end
            local attackId = tostring(math.random(1000000, 9999999))
            regAtk:FireServer(0)
            task.wait(0.005 + math.random() * 0.01)
            -- ✅ Правильная сигнатура: (hitPart, hitList, attackId)
            regHit:FireServer(hits[1], hits, attackId)
        end)
    end
end

