                    return
                end

                -- ✅ FIX: чистка блэклиста каждый тик (было только внутри "fruit found")
                for fruitObj, untilTime in pairs(FruitBlacklist) do
                    if tick() > untilTime or not fruitObj.Parent then FruitBlacklist[fruitObj] = nil end
                end

                -- Снайпер фруктов
                local worldFruit, fruitHandle = findWorldSpawnedFruit()
                if worldFruit and fruitHandle then
                    if FruitTarget ~= worldFruit then FruitTarget = worldFruit; FruitSince = tick() end
                    if (tick() - FruitSince) > Config.FruitPickupTimeoutSec then
                        FruitBlacklist[worldFruit] = tick() + Config.FruitBlacklistSec
                        FruitTarget = nil; FSM.ActiveCombatMob = nil; return
                    end
                    FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil
                    smartMoveTo(fruitHandle.CFrame, false)
                    logStatus("СНАЙПЕР: " .. tostring(worldFruit.Name))
                    if (root.Position - fruitHandle.Position).Magnitude <= 12 then
                        pcall(function() firetouchinterest(root, fruitHandle, 0) end)
                        pcall(function() firetouchinterest(root, fruitHandle, 1) end)
                        task.wait(0.25)
                        storeAnyBackpackFruits()
                    end
                    return
                else FruitTarget = nil end

                local qData, myLvl, status = getQuestByLevel()

                if CurrentSeaNum == 2 and myLvl >= 1500 and not FSM.Sea3HintShown then
                    FSM.Sea3HintShown = true
                    pcall(function()
                        StarterGui:SetCore("SendNotification", { Title = "OLLIE V11.0", Text = "1500 LVL — переход в Sea 3", Duration = 8 })
                    end)
                end

                if status == "COMPLETED" then
                    FSM.Completed = true
                    Env.OllieV11_0_Enabled = false
                    FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil; FSM.StyleTrip = nil
                    stopTweenAndReleasePhysics(true)
                    if MainFrameRef then MainFrameRef.BorderColor3 = Color3.fromRGB(255, 215, 0) end
                    logStatus("ФАРМ ОКОНЧЕН — " .. tostring(Config.MaxLevel) .. " LVL!", myLvl, "COMPLETED")
                    updateStatsBoardUI(true)
                    if not FSM.CompletionNotified then
                        FSM.CompletionNotified = true
                        pcall(function()
                            StarterGui:SetCore("SendNotification", { Title = "OLLIE V11.0", Text = tostring(Config.MaxLevel) .. " LVL! АККАУНТ ГОТОВ К ПРОДАЖЕ!", Duration = 15 })
                        end)
                    end
                    return
                elseif status == "AUTO_SEA2_TRANSITION" then
                    runAutoSea2Transition(myLvl); return
                elseif status == "AUTO_SEA3_TRANSITION" then
                    -- ✅ FIX: Sea 2 → Sea 3 при 1500+
                    runAutoSea3Transition(myLvl); return
                elseif status == "NEED_NEXT_SEA" or not qData then
                    stopTweenAndReleasePhysics(true)
                    FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil
                    logStatus(string.format("Лимит Sea %d (LVL %d).", CurrentSeaNum, myLvl), myLvl, "NEXT SEA")
                    return
                end

                local expectedQuestKey = qData.QName .. "_" .. tostring(qData.QNum)

                if FSM.StyleTrip then
                    FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil
                    local trip = FSM.StyleTrip
                    local info = StyleTeachers[trip.Key]
                    local teacherCF = info and getLiveTeacherCFrame(info)
                    if not info or not teacherCF then
                        FSM.StyleTrip = nil; buyStyleDirect(trip.Key)
                    elseif (tick() - trip.Since) > Config.StyleTripTimeoutSec then
                        FSM.StyleTrip = nil; FSM.LastStyleBuyTry = tick(); buyStyleDirect(trip.Key)
                    else
                        local tDist = (root.Position - teacherCF.Position).Magnitude
                        if tDist > Config.StyleTeacherReachDist then
                            FSM.GroundedAtNPC = false
                            smartMoveTo(teacherCF, false)
                            logStatus(string.format("К учителю: %s (%dм)", info.Label, math.floor(tDist)), myLvl, "STYLE_TRIP")
                        else
                            stopTweenOnly()
                            FSM.StyleTrip = nil; FSM.LastStyleBuyTry = tick()
                            logStatus("Покупка: " .. info.Label, myLvl, "STYLE_BUY")
                            buyStyleDirect(trip.Key)
                            task.wait(0.4)
                        end
                        return
                    end
                end

                if watchdogCheck(myLvl) then return end

                local guiQuestActive = isQuestGuiVisible(qData.Mob)

                if guiQuestActive and (
                    (FSM.CurrentTrackedQuestKey and FSM.CurrentTrackedQuestKey ~= expectedQuestKey)
                    or (not FSM.CurrentTrackedQuestKey and isQuestTextDefinitelyStale(qData))
                ) then
                    local comm = getCommF()
                    if comm then pcall(function() comm:InvokeServer("AbandonQuest") end) end
                    FSM.CurrentTrackedQuestKey = nil; FSM.ForceFarmExpireTime = 0
                    task.wait(0.15)
                    guiQuestActive = isQuestGuiVisible(qData.Mob)
                end

                local hasActiveQuest = guiQuestActive or (tick() < FSM.ForceFarmExpireTime)

                if not hasActiveQuest then
                    FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil
                    local npcCF = getLiveNPCCFrame(qData)
                    local npcDist = (root.Position - npcCF.Position).Magnitude
                    if npcDist > Config.NPCInteractDist then
                        FSM.GroundedAtNPC = false
                        smartMoveTo(npcCF, false)
                        logStatus(string.format("К NPC (%dм)", math.floor(npcDist)), myLvl, expectedQuestKey)
                    else
                        stopTweenOnly()
                        ensureHoverBV(root, npcCF)
                        FSM.GroundedAtNPC = true
                        root.CFrame = npcCF
                        local comm = getCommF()
                        if Config.AutoSetSpawnPoint and comm and LastSetSpawnIsland ~= qData.QName then
                            LastSetSpawnIsland = qData.QName
                            task.spawn(function() pcall(function() comm:InvokeServer("SetSpawnPoint") end) end)
                        end
                        local serverReply = nil
                        if comm then
                            pcall(function() serverReply = comm:InvokeServer("StartQuest", qData.QName, qData.QNum) end)
                        end
                        FSM.GroundedAtNPC = false
                        FSM.QuestTriesAtNPC = FSM.QuestTriesAtNPC + 1
                        FSM.CurrentTrackedQuestKey = expectedQuestKey
                        logStatus("Квест #" .. tostring(FSM.QuestTriesAtNPC) .. " (" .. tostring(serverReply) .. ")", myLvl, expectedQuestKey)
                        task.wait(0.10)
                        if isQuestGuiVisible(qData.Mob) or FSM.QuestTriesAtNPC >= 3 then
                            if not isQuestGuiVisible(qData.Mob) then FSM.ForceFarmExpireTime = tick() + 28 end
                            FSM.QuestTriesAtNPC = 0
                        end
                    end
                else
                    FSM.GroundedAtNPC = false; FSM.QuestTriesAtNPC = 0
                    FSM.CurrentTrackedQuestKey = expectedQuestKey
                    local mob, aliveCount = findTargetMob(qData)
                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                        FSM.ActiveCombatMob = mob
                        FSM.ActiveMobName = qData.Mob
                        local mobRoot = mob.HumanoidRootPart
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        local mobHp = mobHum and mobHum.Health or 0
                        if CurrentMobInstance ~= mob or not FSM.ClusterAnchorPos then
                            CurrentMobInstance = mob
                            FSM.ClusterAnchorPos = mobRoot.Position
                            LastMobHealth = mobHp; LastMobDamageTick = tick()
                            FSM.AttackAngleIndex = 1; FSM.LastAngleSwitchTick = tick()
                        end
                        local anchorPos = FSM.ClusterAnchorPos
                        local mobDist = (root.Position - anchorPos).Magnitude
                        if (LastMobHealth - mobHp) >= Config.MobDamageMinDrop then
                            LastMobHealth = mobHp; LastMobDamageTick = tick(); FSM.LastAngleSwitchTick = tick()
                        elseif mobHp > LastMobHealth then
                            LastMobHealth = mobHp
                        elseif mobDist <= Config.MobDamageEngageDist then
                            if (tick() - FSM.LastAngleSwitchTick) >= Config.HitRecoverySwitchSec then
                                FSM.LastAngleSwitchTick = tick()
                                FSM.AttackAngleIndex = (FSM.AttackAngleIndex % #AirCombatOffsets) + 1
                                FSM.ClusterAnchorPos = mobRoot.Position
                            end
                            if (tick() - LastMobDamageTick) > Config.MobDamageTimeoutSec then
                                IgnoredMobs[mob] = tick() + Config.MobIgnoreSec
                                FSM.ActiveCombatMob = nil; FSM.ClusterAnchorPos = nil; CurrentMobInstance = nil
                                stopTweenOnly()
                                root.CFrame = root.CFrame + Vector3.new(Config.AntiStuckShift, 15, 0)
                                return
                            end
                        end
                        local offsetVec = AirCombatOffsets[FSM.AttackAngleIndex] or AirCombatOffsets[1]
                        local attackPos = anchorPos + offsetVec
                        local uprightAirCF = makeUprightCFrame(attackPos, anchorPos + Vector3.new(0, offsetVec.Y, -2))
                        smartMoveTo(uprightAirCF, true)
                        logStatus(string.format("С воздуха: %s (x%d) [HP: %d]", mob.Name, aliveCount, math.floor(mobHp)), myLvl, expectedQuestKey)
                    else
                        FSM.ActiveCombatMob = nil; FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil; CurrentMobInstance = nil
                        local waypoints = getMobSpawnWaypoints(qData)
                        if #waypoints > 1 and (tick() - FSM.LastPatrolSwitch) >= Config.SpawnPatrolInterval then
                            FSM.LastPatrolSwitch = tick()
                            FSM.PatrolIndex = (FSM.PatrolIndex % #waypoints) + 1
                        end
                        if FSM.PatrolIndex > #waypoints then FSM.PatrolIndex = 1 end
                        local targetSpawnCF = waypoints[FSM.PatrolIndex]
                        local waitDist = (root.Position - targetSpawnCF.Position).Magnitude
                        smartMoveTo(targetSpawnCF, false)
                        logStatus(string.format("Ждем %s (%dм) [%d/%d]", qData.Mob, math.floor(waitDist), FSM.PatrolIndex, #waypoints), myLvl, expectedQuestKey)
                    end
                end
            end)
            if not ok then
                warn("[OLLIE] Main loop error: " .. tostring(err))
                -- Частичный сброс, чтобы не зависнуть
                pcall(function() stopTweenOnly() end)
                FSM.ActiveCombatMob = nil
                FSM.ClusterAnchorPos = nil
            end
        end
    end
end)
