local IgnoredMobs, LastMobDamageTick, LastMobHealth, CurrentMobInstance = {}, 0, 0, nil

local function findTargetMob(qData)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil, 0 end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = (myRoot and myRoot.Position) or (qData.MPos and qData.MPos.Position) or Vector3.new()
    local nowT = tick()
    for ignoredMob, untilT in pairs(IgnoredMobs) do
        if nowT >= untilT or not ignoredMob.Parent then IgnoredMobs[ignoredMob] = nil end
    end
    local bestMob, bestDist, aliveCount = nil, math.huge, 0
    for _, m in ipairs(enemies:GetChildren()) do
        if mobNameMatches(m.Name, qData.Mob) then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr then
                if mh.Health > 0 and mr.Position.Y > -300 and math.abs(mr.Position.Y - refPos.Y) <= 110 and not IgnoredMobs[m] then
                    aliveCount = aliveCount + 1
                    local d = (mr.Position - refPos).Magnitude
                    if d < bestDist then bestDist = d; bestMob = m end
                elseif mh.Health <= 0 and mr.Size.X > 4 then
                    pcall(function() mr.Size = DeadBoxVec end)
                end
            end
        end
    end
    return bestMob, aliveCount
end

