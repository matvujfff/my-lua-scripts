local CachedQuestObj = nil
local LastFullQuestScan = 0
local function isGuiChainVisible(obj, rootGui)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then return false end
    local parent = obj.Parent
    while parent and parent ~= rootGui do
        if parent:IsA("GuiObject") and not parent.Visible then return false end
        parent = parent.Parent
    end
    return rootGui and rootGui.Enabled == true
end

