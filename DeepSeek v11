local function isQuestTextDefinitelyStale(qData)
    local qObj, rootGui = getVisibleQuestObject()
    if not qObj then return false end
    local parts = {}
    for _, desc in ipairs(qObj:GetDescendants()) do
        if desc:IsA("TextLabel") and isGuiChainVisible(desc, rootGui) and type(desc.Text) == "string" and #desc.Text > 0 then
            table.insert(parts, string.lower(desc.Text))
        end
    end
    if #parts == 0 then return false end
    local fullText = table.concat(parts, " | ")
    if string.find(fullText, string.lower(qData.Mob), 1, true) then return false end
    for _, other in ipairs(ActiveQuests) do
        if other.Mob ~= qData.Mob then
            local otherLower = string.lower(other.Mob)
            if #otherLower > 4 and string.find(fullText, otherLower, 1, true) then return true end
        end
    end
    return false
end

