equipNewestOwnedStyle = function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return nil end
    local target = Config.StyleTargetMastery
    local pickTool, pickRank, topTool, topRank = nil, 0, nil, 0
    local seen = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    for _, cont in ipairs({ char, bp }) do
        if cont then
            for _, item in ipairs(cont:GetChildren()) do
                local rank = item:IsA("Tool") and StyleRank[item.Name]
                if rank then
                    local lvlObj = item:FindFirstChild("Level")
                    local mastery = (lvlObj and tonumber(lvlObj.Value)) or 0
                    AccountValuation.StyleMastery[rank] = mastery
                    seen[rank] = true
                    if rank > topRank then topTool, topRank = item, rank end
                    if rank >= 2 and mastery < target and rank > pickRank then pickTool, pickRank = item, rank end
                end
            end
        end
    end
    if topRank > 2 then
        for r = 2, topRank - 1 do
            if not seen[r] then AccountValuation.StyleMastery[r] = math.max(AccountValuation.StyleMastery[r] or 0, target) end
        end
    end
    AccountValuation.StyleTopRank = topRank
    local chosen = pickTool or topTool
    if chosen and chosen.Parent ~= char then pcall(function() hum:EquipTool(chosen) end) end
    return chosen
end

