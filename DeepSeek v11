local LastSea2Check, LastDetectiveNudge, DoorArriveTick = 0, 0, 0
local CachedDressrosaState, LastDressrosaDump = nil, ""

local function runAutoSea2Transition(myLvl)
    local comm = getCommF()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not comm or not root or not hum then return end
    FSM.Sea2TransitionTick = tick()
    FSM.ActiveMobName = nil; FSM.ClusterAnchorPos = nil
    if (tick() - LastSea2Check) >= 3.0 then
        LastSea2Check = tick()
        pcall(function()
            CachedDressrosaState = comm:InvokeServer("DressrosaQuestProgress")
            if type(CachedDressrosaState) == "table" then
                local okEnc, enc = pcall(function() return HttpService:JSONEncode(CachedDressrosaState) end)
                if okEnc and type(enc) == "string" and enc ~= LastDressrosaDump then LastDressrosaDump = enc; print("[OLLIE] Dressrosa: " .. enc) end
            end
        end)
    end
    if type(CachedDressrosaState) == "table" then
        if CachedDressrosaState.KilledIceBoss == true then
            logStatus("Босс Ice Admiral убит! Переход в Sea 2...", myLvl, "TRAVEL_SEA2")
            pcall(function() comm:InvokeServer("TravelDressrosa") end)
            task.wait(2.0); return
        end
        if not CachedDressrosaState.TalkedDetective then
            local detCF = CFrame.new(4849.29, 5.65, 719.61)
            if (root.Position - detCF.Position).Magnitude > 12 then
                smartMoveTo(detCF, false)
                logStatus("Авто-Sea 2: Детектив...", myLvl, "DETECTIVE")
            else
                stopTweenOnly(); root.CFrame = detCF
                pcall(function() comm:InvokeServer("DressrosaQuestProgress", "Detective") end)
                LastSea2Check = 0; task.wait(0.4)
            end
            return
        end
        if not CachedDressrosaState.UsedKey then
            FSM.ActiveCombatMob = nil
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local keyTool = (bp and bp:FindFirstChild("Key")) or char:FindFirstChild("Key")
            if not keyTool then
                pcall(function() comm:InvokeServer("DressrosaQuestProgress", "Detective") end)
                task.wait(0.4); return
            end
            if keyTool.Parent == bp then hum:EquipTool(keyTool) end
            local doorCF = CFrame.new(1347.71, 37.34, -1325.64)
            if (root.Position - doorCF.Position).Magnitude > 10 then
                DoorArriveTick = 0; smartMoveTo(doorCF, false)
                logStatus("Авто-Sea 2: Несем ключ...", myLvl, "USE_KEY")
            else
                stopTweenOnly()
                if DoorArriveTick == 0 then DoorArriveTick = tick() end
                local doorWait = tick() - DoorArriveTick
                local doorTarget = doorCF
                if doorWait > 8 then
                    local nudge = math.floor(doorWait / 3) % 3
                    if nudge == 1 then doorTarget = doorCF * CFrame.new(0, 0, 6)
                    elseif nudge == 2 then doorTarget = doorCF * CFrame.new(0, 0, -6) end
                end
                root.CFrame = doorTarget
                logStatus("Авто-Sea 2: Ключ у двери...", myLvl, "USE_KEY")
                LastSea2Check = 0; task.wait(0.4)
            end
            return
        end
        DoorArriveTick = 0
        local iceBoss = findTargetMob({ Mob = "Ice Admiral", MPos = CFrame.new(1347.71, 37.34, -1325.64) })
        if iceBoss and iceBoss:FindFirstChild("HumanoidRootPart") and iceBoss:FindFirstChildOfClass("Humanoid") then
            FSM.ActiveCombatMob = iceBoss
            FSM.ActiveMobName = "Ice Admiral"
            local bPos = iceBoss.HumanoidRootPart.Position
            FSM.ClusterAnchorPos = bPos
            smartMoveTo(makeUprightCFrame(bPos + Vector3.new(0, Config.HoverHeight, Config.AttackBackOffset), bPos), true)
            logStatus("Авто-Sea 2: Убиваем Ice Admiral!", myLvl, "ICE_ADMIRAL")
        else
            FSM.ActiveCombatMob = nil
            smartMoveTo(CFrame.new(1347.71, 48.0, -1325.64), false)
            logStatus("Авто-Sea 2: Ждем спавна Ice Admiral...", myLvl, "WAIT_ADMIRAL")
        end
    else
        if (tick() - LastDetectiveNudge) >= 3.0 then
            LastDetectiveNudge = tick()
            pcall(function() comm:InvokeServer("DressrosaQuestProgress", "Detective") end)
        end
    end
end

