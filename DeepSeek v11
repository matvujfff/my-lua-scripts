local function smartMoveTo(targetCFrame, isCombatHover)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    local curPos = root.Position
    local finalPos = targetCFrame.Position
    if PlaceId == Sea1_PlaceId and (tick() - LastPortalInvoke) >= 3.5 then
        local comm = getCommF()
        if comm then
            local portalVec = nil
            if finalPos.X > 50000 and curPos.X < 40000 then portalVec = Sea1Portals.FishmanInside
            elseif finalPos.X < 40000 and curPos.X > 50000 then portalVec = Sea1Portals.FishmanOutside
            elseif finalPos.Y > 4500 and curPos.Y < 3500 then portalVec = Sea1Portals.SkyUpperYard
            elseif finalPos.Y > 680 and finalPos.Y < 1200 and curPos.Y < 500 and (curPos - finalPos).Magnitude > 2200 then portalVec = Sea1Portals.SkyTemple end
            if portalVec then
                LastPortalInvoke = tick(); stopTweenOnly()
                ensureHoverBV(root, targetCFrame)
                pcall(function() comm:InvokeServer("requestEntrance", portalVec) end)
                task.wait(0.85); return
            end
        end
    end
    ensureHoverBV(root, targetCFrame)
    local totalDist = (finalPos - curPos).Magnitude
    local horizDist = Vector3.new(finalPos.X - curPos.X, 0, finalPos.Z - curPos.Z).Magnitude
    if totalDist > 120 then requestStreamThrottled(finalPos, curPos) end
    local snapRadius = isCombatHover and Config.CombatSnapDist or 8.0
    if totalDist <= snapRadius then
        stopTweenOnly()
        -- ✅ FIX: выключаем BV перед прямым CFrame (устраняет джиттер)
        local bv = root:FindFirstChild("OllieBV")
        if bv then bv.Enabled = false end
        root.CFrame = targetCFrame
        task.delay(0.05, function()
            if bv and bv.Parent then bv.Enabled = true end
        end)
        return
    end
    local waypointPos = finalPos
    if not isCombatHover and horizDist > 160 then
        local cruiseY = math.max(finalPos.Y + 35, Config.TravelClearanceY)
        if curPos.X > 50000 or math.abs(curPos.Z) > 31000 then cruiseY = finalPos.Y + 15 end
        waypointPos = Vector3.new(finalPos.X, cruiseY, finalPos.Z)
    end
    if ActiveTween and LastTweenGoalPos and (LastTweenGoalPos - waypointPos).Magnitude < 4.0 then
        if ActiveTween.PlaybackState == Enum.PlaybackState.Playing then return end
    end
    if ActiveTween then pcall(function() ActiveTween:Cancel() end) end
    local moveDist = (waypointPos - curPos).Magnitude
    local duration = math.max(moveDist / Config.FlightSpeed, 0.03)
    local targetCF = makeUprightCFrame(waypointPos, finalPos)
    LastTweenGoalPos = waypointPos
    ActiveTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    ActiveTween:Play()
end

