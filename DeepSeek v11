local function ensureHoverBV(root, targetCF)
    if not root then return end
    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity"); bv.Name = "OllieBV"; bv.MaxForce = HugeVec
        bv.Velocity = ZeroVec; bv.Parent = root
    else bv.Velocity = ZeroVec end
    local bg = root:FindFirstChild("OllieBG")
    if not bg then
        bg = Instance.new("BodyGyro"); bg.Name = "OllieBG"; bg.MaxTorque = HugeVec
        bg.P = 95000; bg.D = 1200; bg.CFrame = targetCF or root.CFrame; bg.Parent = root
    elseif targetCF then bg.CFrame = targetCF end
    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)
end

