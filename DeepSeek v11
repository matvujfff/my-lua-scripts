local function formatNumber(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", "")
end

local function recalculateFunPayValuation()
    local d = LocalPlayer:FindFirstChild("Data")
    local lvl = d and d:FindFirstChild("Level") and d.Level.Value or 1
    local beli = d and d:FindFirstChild("Beli") and d.Beli.Value or 0
    if not FSM.StartLevel then FSM.StartLevel = lvl end
    if not FSM.StartBeli then FSM.StartBeli = beli end
    local baseLvlEUR = 0.05
    if lvl >= 1750 then baseLvlEUR = 2.10
    elseif lvl >= 1500 then baseLvlEUR = 1.40 + ((lvl - 1500) / 250) * 0.70
    elseif lvl >= 700 then baseLvlEUR = 0.55 + ((lvl - 700) / 800) * 0.85
    else baseLvlEUR = (lvl / 700) * 0.55 end
    local beliBonusEUR = (beli / 10000000) * 0.22
    local styleBonusEUR = 0
    if AccountValuation.HasBlackLeg then styleBonusEUR = styleBonusEUR + 0.15 end
    if AccountValuation.HasElectro then styleBonusEUR = styleBonusEUR + 0.20 end
    if AccountValuation.HasFishmanKarate then styleBonusEUR = styleBonusEUR + 0.35 end
    if AccountValuation.HasSuperhuman then styleBonusEUR = styleBonusEUR + 1.25 end
    if (tick() - FSM.LastInventoryScan) >= 25.0 then
        FSM.LastInventoryScan = tick()
        task.spawn(function()
            pcall(function()
                local comm = getCommF(); if not comm then return end
                local inv = comm:InvokeServer("getInventory")
                if type(inv) == "table" then
                    local totalFruits, highValList = 0, {}
                    for _, item in ipairs(inv) do
                        if type(item) == "table" and item.Type == "Blox Fruit" and type(item.Name) == "string" then
                            totalFruits = totalFruits + 1
                            local fVal = FruitMarketValueEUR[item.Name] or 0.12
                            if fVal >= 0.45 then table.insert(highValList, { Name = item.Name, Eur = fVal }) end
                        end
                    end
                    AccountValuation.StoredFruitsCount = totalFruits
                    AccountValuation.HighValueFruitsList = highValList
                end
            end)
        end)
    end
    local fruitBonusEUR = 0
    for _, f in ipairs(AccountValuation.HighValueFruitsList) do fruitBonusEUR = fruitBonusEUR + f.Eur end
    local commonFruitsCount = math.max(0, AccountValuation.StoredFruitsCount - #AccountValuation.HighValueFruitsList)
    fruitBonusEUR = fruitBonusEUR + (commonFruitsCount * 0.10)
    local godhumanBonusEUR = 0
    if AccountValuation.GodhumanReady then
        godhumanBonusEUR = Config.GodhumanReadyBonusNetEUR / (1.0 - Config.FunPayCommissionRate)
    end
    local grossEUR = baseLvlEUR + beliBonusEUR + styleBonusEUR + fruitBonusEUR + godhumanBonusEUR
    local netEUR = grossEUR * (1.0 - Config.FunPayCommissionRate)
    AccountValuation.GrossEUR = grossEUR
    AccountValuation.NetEUR = netEUR
    AccountValuation.NetRUB = netEUR * Config.EurToRub
    AccountValuation.NetUAH = netEUR * Config.EurToUah
    return lvl, beli
end

