local function isGuiChainVisible(obj)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then
        return false
    end
    local parent = obj.Parent
    while parent do
        if parent:IsA("ScreenGui") then
            return parent.Enabled
        elseif parent:IsA("GuiObject") and not parent.Visible then
            return false
        end
        parent = parent.Parent
    end
    return false
end

local function getQuestFrameReference()
    if CachedQuestFrame and CachedQuestFrame.Parent then
        return CachedQuestFrame
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    local mainGui = pGui:FindFirstChild("Main")
    if mainGui then
        local directQuest = mainGui:FindFirstChild("Quest")
        if directQuest and directQuest:IsA("GuiObject") then
            CachedQuestFrame = directQuest
            return directQuest
        end
    end

    if (os.clock() - LastGuiScanClock) < 1.5 then
        return nil
    end
    LastGuiScanClock = os.clock()

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV6" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") then
                    CachedQuestFrame = obj
                    return obj
                end
            end
        end
    end
    return nil
end

local function isQuestGuiVisible()
    local qFrame = getQuestFrameReference()
    return qFrame ~= nil and isGuiChainVisible(qFrame)
end

-- Ожидает, пока окно Quest примет нужное состояние видимости (targetVisible = true или false)
local function waitForQuestGuiState(targetVisible, timeoutSec)
    local t0 = os.clock()
    while isCurrentRunActive() and (os.clock() - t0) < timeoutSec do
        if isQuestGuiVisible() == targetVisible then
            return true
        end
        task.wait(0.12)
    end
    return isQuestGuiVisible() == targetVisible
end

-- ИСПРАВЛЕНО (Дефект 4): Проверяет не только видимость окна Quest, но и соответствие текста задания
-- ожидаемому мобу qData.Mob (или русским ключевым словам из локализации игры).
-- Возвращает: isVisible (bool), textStatus ("MATCH", "MISMATCH", "UNDECIDED_LOCALIZED")
local function inspectActiveQuestMatch(qData)
    local qFrame = getQuestFrameReference()
    if not qFrame or not isGuiChainVisible(qFrame) then
        return false, "HIDDEN"
    end

    local combinedText = ""
    for _, desc in ipairs(qFrame:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and type(desc.Text) == "string" and #desc.Text > 0 then
            combinedText = combinedText .. " " .. string.lower(desc.Text)
        end
    end

    local targetMobLower = string.lower(qData.Mob)
    if string.find(combinedText, targetMobLower, 1, true) then
        return true, "MATCH"
    end

    -- Проверяем, не содержит ли окно Quest английское имя ДРУГОГО моба из нашей таблицы QuestsSea1
    -- (если интерфейс на английском или смешанном языке, это сразу выявляет старый/чужой квест)
    for _, otherQuest in ipairs(qData._AllQuestsRef or {}) do
        if otherQuest.Mob ~= qData.Mob then
            local otherLower = string.lower(otherQuest.Mob)
            if string.find(combinedText, otherLower, 1, true) then
                return true, "MISMATCH"
            end
        end
    end

    -- Если интерфейс полностью переведен на русский (например, "Небесный бандит" вместо "Sky Bandit"),
    -- проверяем награду Beli/Exp, если она уникальна, либо возвращаем UNDECIDED_LOCALIZED
    if qData.VerifyHint and string.find(combinedText, string.lower(qData.VerifyHint), 1, true) then
        return true, "MATCH"
    end

    return true, "UNDECIDED_LOCALIZED"
end

