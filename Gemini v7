local function tryFastPortalTransition(rootPart, targetPos)
    if not rootPart or (os.clock() - LastPortalInvoke) < 3.5 then return false end
    local curPos = rootPart.Position
    local comm = getCommF()
    if not comm then return false end

    local portalToUse = nil

    if targetPos.X > 50000 and curPos.X < 40000 then
        portalToUse = Sea1Portals.FishmanInside
    elseif targetPos.X < 40000 and curPos.X > 50000 then
        portalToUse = Sea1Portals.FishmanOutside
    elseif targetPos.Y > 4500 and curPos.Y < 3500 then
        portalToUse = Sea1Portals.SkyUpperYard
    elseif targetPos.Y > 780 and targetPos.Y < 1200 and (curPos - targetPos).Magnitude > 3500 then
        portalToUse = Sea1Portals.SkyTemple
    end

    if portalToUse then
        LastPortalInvoke = os.clock()
        pcall(function()
            comm:InvokeServer("requestEntrance", portalToUse)
        end)
        task.wait(0.35)
        return true
    end
    return false
end

local function getQuestByLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    if not l or type(l.Value) ~= "number" then
        return nil, 0, "DATA_NOT_LOADED"
    end

    local lvl = math.floor(l.Value)
    if lvl < 1 then
        return nil, lvl, "OUT_OF_RANGE"
    end
    if lvl > Config.MaxVerifiedSea1Level then
        return nil, lvl, "ABOVE_SEA1_CAP"
    end

    for i = 1, #QuestsSea1 do
        local q = QuestsSea1[i]
        if lvl >= q.Min and lvl <= q.Max then
            return q, lvl, "OK"
        end
    end

    return nil, lvl, "OUT_OF_RANGE"
end

local function getLiveNPCCFrame(qData)
    local npcFolders = {
        Workspace:FindFirstChild("NPCs"),
        ReplicatedStorage:FindFirstChild("NPCs")
    }
    for _, folder in ipairs(npcFolders) do
        if folder then
            if qData.NPC then
                local exact = folder:FindFirstChild(qData.NPC)
                if exact then
                    local r = exact:FindFirstChild("HumanoidRootPart") or exact:FindFirstChild("Head") or exact.PrimaryPart
                    if r and (r.Position - qData.QPos.Position).Magnitude <= 250 then
                        return r.CFrame * CFrame.new(0, 0, -2.5)
                    end
                end
            end
            local bestCF = nil
            local bestDist = 60
            for _, npc in ipairs(folder:GetChildren()) do
                local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                if r then
                    local d = (r.Position - qData.QPos.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestCF = r.CFrame * CFrame.new(0, 0, -2.5)
                    end
                end
            end
            if bestCF then
                return bestCF
            end
        end
    end
    return qData.QPos
end

local WaypointCache = {
    QuestKey = "",
    UpdatedAt = 0,
    Points = {}
}

local function isConfirmedSpawnPosition(pos, qData)
    if not pos then return false end
    local refPos = qData.MPos.Position
    local horizDist = Vector3.new(pos.X - refPos.X, 0, pos.Z - refPos.Z).Magnitude
    local verticalDrop = refPos.Y - pos.Y
    if horizDist > 1200 or verticalDrop > 160 then
        return false
    end
    return true
end

local function getMobSpawnWaypoints(qData)
    local qKey = qData.QName .. "_" .. tostring(qData.QNum)
    local now = os.clock()

    if WaypointCache.QuestKey == qKey and (now - WaypointCache.UpdatedAt) < Config.WaypointCacheTTL and #WaypointCache.Points > 0 then
        return WaypointCache.Points
    end

    local points = {}
    local lowerMob = string.lower(qData.Mob)

    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if string.find(string.lower(sp.Name), lowerMob, 1, true) then
                local pos = (sp:IsA("BasePart") and sp.Position)
                    or (sp:IsA("Model") and sp.PrimaryPart and sp.PrimaryPart.Position)
                if isConfirmedSpawnPosition(pos, qData) then
                    local hoverPos = pos + Vector3.new(0, Config.AttackHeight, 0)
                    local isDuplicate = false
                    for _, existingCF in ipairs(points) do
                        if (existingCF.Position - hoverPos).Magnitude < 12 then
                            isDuplicate = true
                            break
                        end
                    end
                    if not isDuplicate then
                        table.insert(points, CFrame.new(hoverPos))
                    end
                end
            end
        end
    end

    local mainHoverPos = qData.MPos.Position + Vector3.new(0, Config.AttackHeight, 0)
    local hasMain = false
    for _, existingCF in ipairs(points) do
        if (existingCF.Position - mainHoverPos).Magnitude < 20 then
            hasMain = true
            break
        end
    end
    if not hasMain then
        table.insert(points, CFrame.new(mainHoverPos))
    end

    WaypointCache.QuestKey = qKey
    WaypointCache.UpdatedAt = now
    WaypointCache.Points = points
    return points
end

