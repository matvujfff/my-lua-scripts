-- 7. АВТО-СТАТЫ И ФРУКТЫ (ЗАЩИЩЕНО ТОКЕНОМ ЗАПУСКА MyRunId)
-- ============================================================================
task.spawn(function()
    while isCurrentRunActive() and task.wait(4) do
        if isCurrentRunActive() and Env.OllieV6_Enabled then
            local comm = getCommF()
            if comm then
                if Config.AutoStats then
                    pcall(function()
                        local d = LocalPlayer:FindFirstChild("Data")
                        local pts = d and d:FindFirstChild("Points")
                        if pts and pts.Value > 0 then
                            local spend = math.min(pts.Value, 30)
                            local meleePts = math.ceil(spend * 0.6)
                            local defPts = math.max(1, spend - meleePts)
                            comm:InvokeServer("AddPoint", "Melee", meleePts)
                            comm:InvokeServer("AddPoint", "Defense", defPts)
                        end
                    end)
                end
                if Config.AutoRollFruit then
                    pcall(function() comm:InvokeServer("Cousin", "Buy") end)
                end
            end
        end
    end
end)

-- ============================================================================
-- 8. ГЛАВНЫЙ ЦИКЛ АВТОФАРМА (ВЕРИФИКАЦИЯ КВЕСТА + КОНТРОЛЬ БЛОКИРОВОК МАРШРУТА)
-- ============================================================================
local CurrentTrackedQuestKey = nil
local QuestTriesAtNPC = 0
local PatrolIndex = 1
local LastPatrolSwitchClock = 0

task.spawn(function()
    while isCurrentRunActive() and task.wait(Config.LoopInterval) do
        if not isCurrentRunActive() then break end

        if not Env.OllieV6_Enabled then
            DesiredGoalCFrame = nil
            GroundedAtNPC = false
            ActiveCombatMob = nil
        else
            local loopOk, loopErr = pcall(function()
                if not ensureTeam() then return end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not char or not root or not hum or hum.Health <= 0 then
                    logStatus("Ожидание спавна персонажа...")
                    DesiredGoalCFrame = nil
                    GroundedAtNPC = false
                    IsHealingState = false
                    SafeHealCFrame = nil
                    ActiveCombatMob = nil
                    return
                end

                clearBlockingDialogue()

                local qData, myLvl, rangeStatus = getQuestByLevel()
                if rangeStatus == "DATA_NOT_LOADED" then
                    logStatus("Ожидание загрузки Data.Level...")
                    return
                elseif rangeStatus == "ABOVE_SEA1_CAP" then
                    DesiredGoalCFrame = nil
                    GroundedAtNPC = false
                    ActiveCombatMob = nil
                    restoreModifiedCollisions()
                    logStatus("Достигнут предел таблицы Sea 1 (LVL " .. tostring(myLvl) .. " > 700). Скрипт на паузе.", myLvl, "MAX SEA 1")
                    return
                elseif not qData then
                    DesiredGoalCFrame = nil
                    GroundedAtNPC = false
                    ActiveCombatMob = nil
                    restoreModifiedCollisions()
                    logStatus("Уровень " .. tostring(myLvl) .. " вне подтвержденных диапазонов!", myLvl, "NONE")
                    return
                end

                local expectedQuestKey = qData.QName .. "_" .. tostring(qData.QNum)

                -- === ПРОВЕРКА ЗДОРОВЬЯ (SAFE MODE) ===
                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if Config.SafeModeEnabled then
                    if hpRatio < Config.LowHpThreshold and not IsHealingState then
                        IsHealingState = true
                        GroundedAtNPC = false
                        ActiveCombatMob = nil
                        SafeHealCFrame = CFrame.new(root.Position.X, math.max(root.Position.Y + Config.SafeSkyOffset, 250), root.Position.Z)
                    elseif IsHealingState and hpRatio >= Config.RecoverHpThreshold then
                        IsHealingState = false
                        SafeHealCFrame = nil
                    end
                else
                    IsHealingState = false
                end

                if IsHealingState and SafeHealCFrame then
                    GroundedAtNPC = false
                    ActiveCombatMob = nil
                    DesiredGoalCFrame = SafeHealCFrame
                    logStatus(string.format("ОТХИЛ В НЕБЕ [HP: %d%% / %d%%]", math.floor(hpRatio * 100), math.floor(Config.RecoverHpThreshold * 100)), myLvl, qData.QName)
                    return
                end

                -- ИСПРАВЛЕНО (Дефект 4): Полная проверка активного квеста:
                --   1. Если окно Quest скрыто -> CurrentTrackedQuestKey сбрасывается в nil.
                --   2. Если окно Quest открыто, проверяем текст задания (inspectActiveQuestMatch) И ключ CurrentTrackedQuestKey:
                --      - Если текст явно указывает на чужой квест ("MISMATCH") ИЛИ CurrentTrackedQuestKey отличается от expectedQuestKey
                --        ИЛИ скрипт только что запущен с неизвестным локализованным квестом (CurrentTrackedQuestKey == nil и нет точного "MATCH") ->
                --        вызываем AbandonQuest и ждем фактического закрытия окна Quest!
                local guiVisible, matchState = inspectActiveQuestMatch(qData)

                if not guiVisible then
                    CurrentTrackedQuestKey = nil
                else
                    local isVerifiedCorrectQuest = false
                    if matchState == "MATCH" and (CurrentTrackedQuestKey == nil or CurrentTrackedQuestKey == expectedQuestKey) then
                        CurrentTrackedQuestKey = expectedQuestKey
                        isVerifiedCorrectQuest = true
                    elseif matchState == "UNDECIDED_LOCALIZED" and CurrentTrackedQuestKey == expectedQuestKey then
                        isVerifiedCorrectQuest = true
                    end

                    if not isVerifiedCorrectQuest then
                        ActiveCombatMob = nil
                        logStatus("Отмена несоответствующего/старого квеста...", myLvl, qData.QName)
                        local comm = getCommF()
                        if comm then
                            pcall(function() comm:InvokeServer("AbandonQuest") end)
                        end
                        CurrentTrackedQuestKey = nil
                        -- Ожидаем фактического закрытия окна Quest в GUI (учитываем сетевую задержку обновления GUI после AbandonQuest)
                        waitForQuestGuiState(false, 2.5)
                        guiVisible = isQuestGuiVisible()
                    end
                end

                local hasVerifiedQuest = guiVisible and (CurrentTrackedQuestKey == expectedQuestKey)

                if not hasVerifiedQuest then
                    -- ШАГ 1: ЛЕТИМ К NPC И БЕРЕМ КВЕСТ
                    ActiveCombatMob = nil
                    local npcTargetCF = getLiveNPCCFrame(qData)

                    if QuestTriesAtNPC >= 2 and (QuestTriesAtNPC % 2 == 0) then
                        npcTargetCF = qData.QPos
                    end

                    tryFastPortalTransition(root, npcTargetCF.Position)
                    local npcDist = (root.Position - npcTargetCF.Position).Magnitude

                    if npcDist > 7 then
                        GroundedAtNPC = false
                        DesiredGoalCFrame = npcTargetCF
                        if NavBypass.Phase == "BLOCKED_HALT" then
                            logStatus("МАРШРУТ К NPC ЗАБЛОКИРОВАН (3 попытки обхода не прошли)!", myLvl, qData.QName)
                        else
                            logStatus("Летим к NPC " .. tostring(qData.NPC) .. " (" .. tostring(math.floor(npcDist)) .. "м)", myLvl, qData.QName)
                        end
                        requestStreamThrottled(npcTargetCF.Position)
                    else
                        requestStreamThrottled(npcTargetCF.Position)
                        GroundedAtNPC = true
                        DesiredGoalCFrame = nil
                        restoreModifiedCollisions()
                        root.CFrame = npcTargetCF
                        hum:MoveTo(npcTargetCF.Position)
                        task.wait(0.4)

                        local comm = getCommF()
                        local serverReply = nil
                        if comm then
                            pcall(function()
                                serverReply = comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                            end)
                        end

                        QuestTriesAtNPC = QuestTriesAtNPC + 1
                        logStatus("Взятие квеста #" .. tostring(QuestTriesAtNPC) .. " (Ответ: " .. tostring(serverReply) .. ")", myLvl, qData.QName)

                        -- Дожидаемся появления окна Quest в GUI и проверяем, что открылся именно наш квест
                        local appeared = waitForQuestGuiState(true, 1.2)
                        GroundedAtNPC = false

                        if appeared then
                            local visNow, matchNow = inspectActiveQuestMatch(qData)
                            if visNow and matchNow ~= "MISMATCH" then
                                CurrentTrackedQuestKey = expectedQuestKey
                                QuestTriesAtNPC = 0
                            end
                        elseif QuestTriesAtNPC >= 4 then
                            QuestTriesAtNPC = 0
                            DesiredGoalCFrame = qData.QPos * CFrame.new(0, 15, 0)
                            task.wait(0.5)
                        end
                    end
                else
                    -- ШАГ 2: КВЕСТ ПОДТВЕРЖДЕН -> ИЩЕМ И УНИЧТОЖАЕМ ЦЕЛЕВЫХ МОБОВ
                    GroundedAtNPC = false
                    QuestTriesAtNPC = 0

                    local mob = findTargetMob(qData)
                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                        ActiveCombatMob = mob
                        local mPos = mob.HumanoidRootPart.Position
                        tryFastPortalTransition(root, mPos)

                        local distToMob = (root.Position - mPos).Magnitude
                        local attackPos = mPos + Vector3.new(0, Config.AttackHeight, Config.AttackBackOffset)
                        DesiredGoalCFrame = CFrame.new(attackPos, mPos)

                        if NavBypass.Phase == "BLOCKED_HALT" then
                            logStatus("ПУТЬ К МОБУ ЗАБЛОКИРОВАН (ожидание смещения цели)...", myLvl, qData.QName)
                        else
                            logStatus("Бьем: " .. mob.Name .. " [HP: " .. tostring(math.floor(mob.Humanoid.Health)) .. "]", myLvl, qData.QName)
                        end

                        -- Стягиваем пачку в главном цикле (0.12 с), а сами удары наносит выделенный быстрый поток (0.08 с) без дублей
                        if distToMob <= 45 then
                            pullMobsTogether(qData.Mob, mPos)
                        end
                    else
                        ActiveCombatMob = nil
                        local waypoints = getMobSpawnWaypoints(qData)

                        if #waypoints > 1 and (os.clock() - LastPatrolSwitchClock) >= Config.SpawnPatrolInterval then
                            LastPatrolSwitchClock = os.clock()
                            PatrolIndex = (PatrolIndex % #waypoints) + 1
                        end
                        if PatrolIndex > #waypoints then
                            PatrolIndex = 1
                        end

                        local targetSpawnCF = waypoints[PatrolIndex]
                        tryFastPortalTransition(root, targetSpawnCF.Position)
                        requestStreamThrottled(targetSpawnCF.Position)

                        local waitDist = (root.Position - targetSpawnCF.Position).Magnitude
                        DesiredGoalCFrame = targetSpawnCF

                        if NavBypass.Phase == "BLOCKED_HALT" then
                            logStatus(
                                string.format("МАРШРУТ К СПАВНУ ЗАБЛОКИРОВАН [Точка %d/%d]", PatrolIndex, #waypoints),
                                myLvl,
                                qData.QName
                            )
                        elseif waitDist <= 8 then
                            logStatus(
                                string.format("Ждем спавн %s [Точка %d/%d]", qData.Mob, PatrolIndex, #waypoints),
                                myLvl,
                                qData.QName
                            )
                        else
                            logStatus(
                                string.format("Летим к спавну %s (%dм) [Точка %d/%d]", qData.Mob, math.floor(waitDist), PatrolIndex, #waypoints),
                                myLvl,
                                qData.QName
                            )
                        end
                    end
                end
            end)

            if not loopOk then
                logStatus("Ошибка цикла (перехвачена): " .. string.sub(tostring(loopErr), 1, 36))
            end
        end
    end
end)
