    trackCharacterParts(LocalPlayer.Character)
end

-- ИСПРАВЛЕНО (Дефект 3): Строгий автомат обхода препятствий:
--   - Переход CLIMB -> CRUISE_OVER происходит ТОЛЬКО при подтвержденном наборе высоты (curPos.Y >= SafeAltitudeY - 6).
--   - Истечение тайм-аута в CLIMB или отсутствие продвижения в CRUISE_OVER считается неудачной попыткой, а не успехом.
--   - После исчерпания Config.MaxBypassAttempts автомат переходит в явное безопасное состояние "BLOCKED_HALT"
--     и прекращает бесконечно давить в непроходимую преграду до смены цели.
local NavBypass = {
    Phase = "NONE",         -- "NONE", "CLIMB", "CRUISE_OVER", "BLOCKED_HALT"
    PhaseStartedAt = 0,
    SafeAltitudeY = 0,
    ClimbAnchorX = 0,
    ClimbAnchorZ = 0,
    CruiseStartHorizGap = 0,
    LastCheckClock = 0,
    LastSamplePos = nil,
    LastGoalDist = math.huge,
    StuckTicks = 0,
    AttemptsUsed = 0,
    TrackedGoalPos = nil
}

local function resetNavBypass(keepAttemptCount)
    NavBypass.Phase = "NONE"
    NavBypass.PhaseStartedAt = 0
    NavBypass.LastCheckClock = os.clock()
    NavBypass.LastSamplePos = nil
    NavBypass.LastGoalDist = math.huge
    NavBypass.StuckTicks = 0
    if not keepAttemptCount then
        NavBypass.AttemptsUsed = 0
        NavBypass.TrackedGoalPos = nil
    end
end

local function startNextBypassClimb(curPos, finalDstPos, now)
    if NavBypass.AttemptsUsed >= Config.MaxBypassAttempts then
        NavBypass.Phase = "BLOCKED_HALT"
        NavBypass.PhaseStartedAt = now
        return
    end
    NavBypass.AttemptsUsed = NavBypass.AttemptsUsed + 1
    NavBypass.Phase = "CLIMB"
    NavBypass.PhaseStartedAt = now
    NavBypass.ClimbAnchorX = curPos.X
    NavBypass.ClimbAnchorZ = curPos.Z
    -- Каждая следующая попытка берет эшелон выше предыдущего (+140, +240, +340 стадов), но не выше +420 от старта
    local extraHeight = Config.BypassClimbHeight + ((NavBypass.AttemptsUsed - 1) * 100)
    NavBypass.SafeAltitudeY = math.min(
        math.max(curPos.Y, finalDstPos.Y) + extraHeight,
        curPos.Y + 420
    )
    NavBypass.StuckTicks = 0
end

