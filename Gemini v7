-- ИСПРАВЛЕНО (Дефект 2 и 5):
--   1. Кэшируем BasePart'ы персонажа при спавне/добавлении (без вызова GetDescendants() на каждом кадре Stepped).
--   2. Сохраняем в ModifiedCollisionParts ТОЛЬКО те части, у которых CanCollide был true до вмешательства скрипта,
--      и восстанавливаем ровно их при паузе, смерти, остановке или посадке к NPC.
local CachedCharParts = {}
local ModifiedCollisionParts = {}

local function trackCharacterParts(char)
    CachedCharParts = {}
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(CachedCharParts, obj)
        end
    end
    table.insert(Env.OllieV6_Connections, char.DescendantAdded:Connect(function(obj)
        if isCurrentRunActive() and obj:IsA("BasePart") then
            table.insert(CachedCharParts, obj)
        end
    end))
end

restoreModifiedCollisions = function()
    for part, origVal in pairs(ModifiedCollisionParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origVal
            end)
        end
        ModifiedCollisionParts[part] = nil
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local bv = root and root:FindFirstChild("OllieBV")
    if bv then
        pcall(function() bv:Destroy() end)
    end
end
Env.OllieV6_RestoreCollisions = restoreModifiedCollisions

