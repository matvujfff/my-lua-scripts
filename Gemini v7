end))

table.insert(Env.OllieV6_Connections, RunService.Heartbeat:Connect(function(dt)
    if not isCurrentRunActive() then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if not Env.OllieV6_Enabled or hum.Health <= 0 or GroundedAtNPC then
        restoreModifiedCollisions()
        resetNavBypass(false)
        return
    end

    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieBV"
        bv.MaxForce = HugeVec
        bv.Velocity = ZeroVec
        bv.Parent = root
    else
        bv.Velocity = ZeroVec
    end

    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)

    if not DesiredGoalCFrame then
        resetNavBypass(false)
        return
    end

    local curPos = root.Position
    local finalDstPos = DesiredGoalCFrame.Position
    local totalDist = (finalDstPos - curPos).Magnitude
    local horizGapToGoal = Vector3.new(finalDstPos.X - curPos.X, 0, finalDstPos.Z - curPos.Z).Magnitude
    local now = os.clock()

    -- Смена конечной цели более чем на 25 стадов сбрасывает автомат обхода (и выводит из BLOCKED_HALT)
    if not NavBypass.TrackedGoalPos or (NavBypass.TrackedGoalPos - finalDstPos).Magnitude > 25.0 then
        resetNavBypass(false)
        NavBypass.TrackedGoalPos = finalDstPos
        NavBypass.LastGoalDist = totalDist
        NavBypass.LastSamplePos = curPos
        NavBypass.LastCheckClock = now
    end

    -- 1. Достижение конечной точки
    if totalDist <= 6.0 then
        resetNavBypass(false)
        root.CFrame = DesiredGoalCFrame
        return
    end

    -- 2. Если все попытки обхода исчерпаны (BLOCKED_HALT) — удерживаем безопасное зависание на месте без давления в стену
    if NavBypass.Phase == "BLOCKED_HALT" then
        root.CFrame = CFrame.new(curPos) * DesiredGoalCFrame.Rotation
        return
    end

    -- 3. Переходы состояний автомата обхода
    if NavBypass.Phase == "CLIMB" then
        -- Переход в CRUISE_OVER ТОЛЬКО при фактическом достижении заданной высоты!
        if curPos.Y >= (NavBypass.SafeAltitudeY - 6.0) then
            NavBypass.Phase = "CRUISE_OVER"
            NavBypass.PhaseStartedAt = now
            NavBypass.CruiseStartHorizGap = horizGapToGoal
            NavBypass.LastCheckClock = now
            NavBypass.LastSamplePos = curPos
        elseif (now - NavBypass.PhaseStartedAt) >= 2.5 then
            -- Тайм-аут подъема: потолок или крыша не дали набрать высоту -> фиксируем отказ попытки
            startNextBypassClimb(curPos, finalDstPos, now)
        end

    elseif NavBypass.Phase == "CRUISE_OVER" then
        -- Успешный проход над препятствием подтверждается только выходом в горизонтальный створ цели (<= 14 стадов)
        if horizGapToGoal <= 14.0 then
            resetNavBypass(true)
            NavBypass.LastGoalDist = totalDist
            NavBypass.LastSamplePos = curPos
            NavBypass.LastCheckClock = now
        else
            -- Проверяем каждые 0.7 с, двигаемся ли мы горизонтально над преградой
            if (now - NavBypass.LastCheckClock) >= 0.7 then
                local moved = NavBypass.LastSamplePos and (curPos - NavBypass.LastSamplePos).Magnitude or 999
                if moved < 6.0 or (now - NavBypass.PhaseStartedAt) >= 6.5 then
                    -- Маршрут на этой высоте все еще заблокирован -> берем следующую попытку (или уходим в BLOCKED_HALT)
                    startNextBypassClimb(curPos, finalDstPos, now)
                end
                NavBypass.LastSamplePos = curPos
                NavBypass.LastCheckClock = now
            end
        end

    else
        -- Фаза "NONE": контроль прогресса прямого полета каждые 0.65 с
        if totalDist > 14.0 and (now - NavBypass.LastCheckClock) >= 0.65 then
            local distReduced = NavBypass.LastGoalDist - totalDist
            local actualMoved = NavBypass.LastSamplePos and (curPos - NavBypass.LastSamplePos).Magnitude or 999

            if distReduced < 6.0 or actualMoved < 6.0 then
                NavBypass.StuckTicks = NavBypass.StuckTicks + 1
                if NavBypass.StuckTicks >= 2 then
                    startNextBypassClimb(curPos, finalDstPos, now)
                end
            else
                NavBypass.StuckTicks = 0
            end

            NavBypass.LastGoalDist = totalDist
            NavBypass.LastSamplePos = curPos
            NavBypass.LastCheckClock = now
        end
    end

    if NavBypass.Phase == "BLOCKED_HALT" then
        root.CFrame = CFrame.new(curPos) * DesiredGoalCFrame.Rotation
        return
    end

    -- 4. Шаг перемещения для текущей фазы
    local stepTargetPos = finalDstPos
    if NavBypass.Phase == "CLIMB" then
        stepTargetPos = Vector3.new(NavBypass.ClimbAnchorX, NavBypass.SafeAltitudeY, NavBypass.ClimbAnchorZ)
    elseif NavBypass.Phase == "CRUISE_OVER" then
        stepTargetPos = Vector3.new(finalDstPos.X, NavBypass.SafeAltitudeY, finalDstPos.Z)
    end

    local delta = stepTargetPos - curPos
    local distToStepTarget = delta.Magnitude

    if distToStepTarget <= 0.05 then
        root.CFrame = CFrame.new(curPos) * DesiredGoalCFrame.Rotation
    else
        local step = math.min(distToStepTarget, Config.FlightSpeed * dt)
        local nextPos = curPos + (delta.Unit * step)
        local lookHoriz = Vector3.new(finalDstPos.X - nextPos.X, 0, finalDstPos.Z - nextPos.Z).Magnitude
        if lookHoriz > 0.05 then
            root.CFrame = CFrame.new(nextPos, finalDstPos)
        else
            root.CFrame = CFrame.new(nextPos) * DesiredGoalCFrame.Rotation
        end
    end
end))

-- ============================================================================
-- 6. БОЕВАЯ СИСТЕМА: КЭШИРОВАННЫЕ REMOTES И ЕДИНЫЙ ПОТОК АТАКИ (БЕЗ ДУБЛЕЙ)
-- ============================================================================
local CachedRegAtk = nil
local CachedRegHit = nil
local CachedCFController = nil
local LastCFResolveClock = 0

local function getCombatRemotes()
    if CachedRegAtk and CachedRegAtk.Parent and CachedRegHit and CachedRegHit.Parent then
        return CachedRegAtk, CachedRegHit
    end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if net then
        CachedRegAtk = net:FindFirstChild("RE/RegisterAttack")
        CachedRegHit = net:FindFirstChild("RE/RegisterHit")
    end
    return CachedRegAtk, CachedRegHit
end

local function getCombatFrameworkController()
    if CachedCFController then
        return CachedCFController
    end
    if (os.clock() - LastCFResolveClock) < 5.0 then
        return nil
    end
    LastCFResolveClock = os.clock()
    pcall(function()
        local cfScript = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        if cfScript and debug and debug.getupvalues then
            local cf = require(cfScript)
            local upvals = debug.getupvalues(cf)
            if upvals and upvals[2] and upvals[2].activeController then
                CachedCFController = upvals[2].activeController
            end
        end
    end)
    return CachedCFController
end

local function equipBestTool()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return nil end

    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == Config.WeaponType or eq.Name == "Combat") then
        return eq
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == Config.WeaponType or item.Name == "Combat") then
                hum:EquipTool(item)
                return item
            end
        end
        local firstTool = bp:FindFirstChildOfClass("Tool")
        if firstTool then
            hum:EquipTool(firstTool)
            return firstTool
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function findTargetMob(qData)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local lowerName = string.lower(qData.Mob)

    local bestMob = nil
    local bestDist = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = (myRoot and myRoot.Position) or qData.MPos.Position

    for _, m in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(m.Name), lowerName, 1, true) then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr and mh.Health > 0 then
                local d = (mr.Position - refPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestMob = m
                end
            end
        end
    end

    return bestMob
end

local LastSimRadiusSet = 0
local function pullMobsTogether(mobName, targetPos)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local lowerName = string.lower(mobName)
    local boxVec = Vector3.new(Config.MobHitboxSize, Config.MobHitboxSize, Config.MobHitboxSize)

    if sethiddenproperty and (os.clock() - LastSimRadiusSet) >= 2.0 then
        LastSimRadiusSet = os.clock()
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)
    end

    for _, m in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(m.Name), lowerName, 1, true) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            local mh = m:FindFirstChildOfClass("Humanoid")
            if mr and mh and mh.Health > 0 and (mr.Position - targetPos).Magnitude <= 260 then
                pcall(function()
                    if mr.CanCollide then mr.CanCollide = false end
                    if mr.Size ~= boxVec then
                        mr.Size = boxVec
                        mr.Transparency = 0.85
                    end
                    mr.AssemblyLinearVelocity = ZeroVec
                    if mh.WalkSpeed ~= 0 then mh.WalkSpeed = 0 end
                    if mh.JumpPower ~= 0 then mh.JumpPower = 0 end
                    if Config.BringMobs and (mr.Position - targetPos).Magnitude > 1.5 then
                        mr.CFrame = CFrame.new(targetPos)
                    end
                end)
            end
        end
    end
end

local function executeAttack(mob)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    if not char:FindFirstChild("HasBuso") and (os.clock() - LastBusoTry) >= Config.BusoRetryCooldown then
        LastBusoTry = os.clock()
        task.spawn(function()
            pcall(function()
                local comm = getCommF()
                if comm then comm:InvokeServer("Buso") end
            end)
        end)
    end

    local tool = equipBestTool()
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        local regAtk, regHit = getCombatRemotes()
        local enemies = Workspace:FindFirstChild("Enemies")
        if regAtk and regHit and mob and mob:FindFirstChild("HumanoidRootPart") then
            local targets = {}
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    local er = enemy:FindFirstChild("HumanoidRootPart")
                    local eh = enemy:FindFirstChildOfClass("Humanoid")
                    if er and eh and eh.Health > 0 and (er.Position - root.Position).Magnitude <= 65 then
                        table.insert(targets, {enemy, er})
                    end
                end
            end
            if #targets == 0 then
                table.insert(targets, {mob, mob.HumanoidRootPart})
            end
            regAtk:FireServer(0)
            regHit:FireServer(mob.HumanoidRootPart, targets)
        end
    end)

    pcall(function()
        local ctrl = getCombatFrameworkController()
        if ctrl then
            ctrl.timeToNextAttack = 0
            ctrl.hitboxMagnitude = 60
            ctrl:attack()
        end
    end)

    pcall(function()
        VirtualUser:CaptureController()
        local camCF = (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame) or CFrame.new()
        VirtualUser:Button1Down(Vector2.new(600, 280), camCF)
        VirtualUser:Button1Up(Vector2.new(600, 280), camCF)
    end)
end

-- ИСПРАВЛЕНО (Дефект 5): Единый поток быстрых атак с проверкой токена запуска isCurrentRunActive()
task.spawn(function()
    while isCurrentRunActive() and task.wait(Config.FastAttackInterval) do
        if isCurrentRunActive() and Env.OllieV6_Enabled and not GroundedAtNPC and not IsHealingState and ActiveCombatMob then
            pcall(function()
                local mh = ActiveCombatMob:FindFirstChildOfClass("Humanoid")
                local mr = ActiveCombatMob:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if mh and mr and myRoot and mh.Health > 0 and (mr.Position - myRoot.Position).Magnitude <= 50 then
                    executeAttack(ActiveCombatMob)
                end
            end)
        end
    end
end)

