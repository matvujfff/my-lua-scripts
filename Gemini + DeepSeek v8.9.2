local CachedQuestObj = nil
local function isGuiChainVisible(obj, rootGui)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then
        return false
    end
    local parent = obj.Parent
    while parent and parent ~= rootGui do
        if parent:IsA("GuiObject") and not parent.Visible then
            return false
        end
        parent = parent.Parent
    end
    return rootGui and rootGui.Enabled == true
end

local function getVisibleQuestObject()
    if CachedQuestObj and CachedQuestObj.Parent then
        local screenGui = CachedQuestObj:FindFirstAncestorOfClass("ScreenGui")
        if screenGui and isGuiChainVisible(CachedQuestObj, screenGui) then
            return CachedQuestObj, screenGui
        end
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil, nil end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV8_9_2" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") and obj.Visible then
                    if isGuiChainVisible(obj, gui) then
                        CachedQuestObj = obj
                        return obj, gui
                    end
                end
            end
        end
    end
    return nil, nil
end

local function isQuestGuiVisible()
    local qObj = getVisibleQuestObject()
    return qObj ~= nil
end

local function isQuestTextDefinitelyStale(qData)
    local qObj, rootGui = getVisibleQuestObject()
    if not qObj then return false end

    local parts = {}
    for _, desc in ipairs(qObj:GetDescendants()) do
        if desc:IsA("TextLabel") and isGuiChainVisible(desc, rootGui) and type(desc.Text) == "string" and #desc.Text > 0 then
            table.insert(parts, string.lower(desc.Text))
        end
    end
    if #parts == 0 then return false end
    local fullText = table.concat(parts, " | ")

    local targetMobLower = string.lower(qData.Mob)
    if string.find(fullText, targetMobLower, 1, true) then
        return false
    end

    for _, other in ipairs(ActiveQuests) do
        if other.Mob ~= qData.Mob then
            local otherLower = string.lower(other.Mob)
            if #otherLower > 4 and string.find(fullText, otherLower, 1, true) then
                return true
            end
        end
    end
    return false
end

local function clearBlockingDialogue()
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then return end
        for _, gui in ipairs(pGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local dlg = gui:FindFirstChild("Dialogue", true)
                if dlg and dlg:IsA("GuiObject") and dlg.Visible then
                    local opt1 = dlg:FindFirstChild("Option1", true)
                    if opt1 and firesignal then
                        pcall(function() firesignal(opt1.Activated) end)
                    end
                end
            end
        end
    end)
end

local function mobNameMatches(enemyName, mobName)
    local n, m = string.lower(enemyName), string.lower(mobName)
    if string.sub(n, 1, #m) ~= m then return false end
    local c = string.sub(n, #m + 1, #m + 1)
    return c == "" or c == " " or c == "["
end

local function getQuestByLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    local lvl = l and math.floor(l.Value) or 1

    if Config.StopOnGoalCompleted and lvl >= Config.MaxLevel then
        return nil, lvl, "COMPLETED"
    end

    for i = 1, #ActiveQuests do
        local q = ActiveQuests[i]
        if lvl >= q.Min and lvl <= q.Max then
            return q, lvl, "OK"
        end
    end

    local maxInThisSea = ActiveQuests[#ActiveQuests].Max
    if lvl > maxInThisSea then
        return nil, lvl, "NEED_NEXT_SEA"
    end

    return ActiveQuests[#ActiveQuests], lvl, "OK"
end

-- FIX BUG #2: Ищет живую модель NPC по имени и координатам во всех папках (включая одноименных "Quest Giver" в Sea 2/3)
local function getLiveNPCCFrame(qData)
    local npcFolders = {
        Workspace:FindFirstChild("NPCs"),
        ReplicatedStorage:FindFirstChild("NPCs")
    }

    -- 1. Приоритетный поиск по имени NPC (или "Quest Giver") в радиусе 260 стадов от QPos
    if qData.NPC then
        local bestNamedCF = nil
        local bestNamedDist = 260
        for _, folder in ipairs(npcFolders) do
            if folder then
                for _, npc in ipairs(folder:GetChildren()) do
                    if npc.Name == qData.NPC or npc.Name == "Quest Giver" then
                        local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                        if r then
                            if not qData.QPos then
                                return r.CFrame * CFrame.new(0, 0, -2.5)
                            end
                            local d = (r.Position - qData.QPos.Position).Magnitude
                            if d < bestNamedDist then
                                bestNamedDist = d
                                bestNamedCF = r.CFrame * CFrame.new(0, 0, -2.5)
                            end
                        end
                    end
                end
            end
        end
        if bestNamedCF then
            return bestNamedCF
        end
    end

    -- 2. Fallback по расстоянию до QPos
    if qData.QPos then
        local bestCF = nil
        local bestDist = 70
        for _, folder in ipairs(npcFolders) do
            if folder then
                for _, npc in ipairs(folder:GetChildren()) do
                    local r = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
                    if r then
                        local d = (r.Position - qData.QPos.Position).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestCF = r.CFrame * CFrame.new(0, 0, -2.5)
                        end
                    end
                end
            end
        end
        if bestCF then return bestCF end
    end

    return qData.QPos or CFrame.new()
end

-- FIX BUG #1: Удален "or string.find(...)", используется строго префиксный матчер mobNameMatches(sp.Name, qData.Mob)
local WaypointCache = { Key = "", Time = 0, List = {} }
local function getMobSpawnWaypoints(qData)
    local key = qData.QName .. "_" .. tostring(qData.QNum)
    if WaypointCache.Key == key and (tick() - WaypointCache.Time) < 10.0 and #WaypointCache.List > 0 then
        return WaypointCache.List
    end

    local points = {}
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if mobNameMatches(sp.Name, qData.Mob) then
                local pos = (sp:IsA("BasePart") and sp.Position)
                    or (sp:IsA("Model") and sp.PrimaryPart and sp.PrimaryPart.Position)
                if pos and (not qData.MPos or math.abs(pos.Y - qData.MPos.Position.Y) <= 450) then
                    local hoverPos = pos + Vector3.new(0, Config.HoverHeight, 0)
                    local dup = false
                    for _, ex in ipairs(points) do
                        if (ex.Position - hoverPos).Magnitude < 12 then dup = true break end
                    end
                    if not dup then
                        table.insert(points, CFrame.new(hoverPos))
                    end
                end
            end
        end
    end

    if qData.MPos then
        table.insert(points, qData.MPos * CFrame.new(0, Config.HoverHeight, 0))
    elseif #points == 0 then
        table.insert(points, getLiveNPCCFrame(qData) * CFrame.new(0, Config.HoverHeight, 0))
    end

    WaypointCache.Key = key
    WaypointCache.Time = tick()
    WaypointCache.List = points
    return points
end

