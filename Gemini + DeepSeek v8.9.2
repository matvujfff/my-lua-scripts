local function smartMoveTo(targetCFrame)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    local curPos = root.Position
    local finalPos = targetCFrame.Position

    if PlaceId == Sea1_PlaceId and (tick() - LastPortalInvoke) >= 4.0 then
        local comm = getCommF()
        if comm then
            local portalVec = nil
            if finalPos.X > 50000 and curPos.X < 40000 then
                portalVec = Sea1Portals.FishmanInside
            elseif finalPos.X < 40000 and curPos.X > 50000 then
                portalVec = Sea1Portals.FishmanOutside
            elseif finalPos.Y > 4500 and curPos.Y < 3500 then
                portalVec = Sea1Portals.SkyUpperYard
            elseif finalPos.Y > 680 and finalPos.Y < 1200 and (curPos - finalPos).Magnitude > 2200 then
                portalVec = Sea1Portals.SkyTemple
            end
            if portalVec then
                LastPortalInvoke = tick()
                stopTweenOnly()
                ensureHoverBV(root)
                pcall(function() comm:InvokeServer("requestEntrance", portalVec) end)
                task.wait(0.35)
                return
            end
        end
    end

    ensureHoverBV(root)

    local totalDist = (finalPos - curPos).Magnitude
    local horizDist = Vector3.new(finalPos.X - curPos.X, 0, finalPos.Z - curPos.Z).Magnitude

    if totalDist > 120 then
        requestStreamThrottled(finalPos, curPos)
    end

    if totalDist <= 5.5 then
        stopTweenOnly()
        root.CFrame = targetCFrame
        return
    end

    local waypointPos = finalPos
    if horizDist > 160 then
        local cruiseY = math.max(finalPos.Y + 35, Config.TravelClearanceY)
        waypointPos = Vector3.new(finalPos.X, cruiseY, finalPos.Z)
    end

    if ActiveTween and LastTweenGoalPos and (LastTweenGoalPos - waypointPos).Magnitude < 4.0 then
        if ActiveTween.PlaybackState == Enum.PlaybackState.Playing then
            return
        end
    end

    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
    end

    local moveDist = (waypointPos - curPos).Magnitude
    local duration = math.max(moveDist / Config.FlightSpeed, 0.04)
    local lookHoriz = Vector3.new(finalPos.X - waypointPos.X, 0, finalPos.Z - waypointPos.Z).Magnitude
    local targetCF = (lookHoriz > 0.05) and CFrame.new(waypointPos, Vector3.new(finalPos.X, waypointPos.Y, finalPos.Z)) or (CFrame.new(waypointPos) * targetCFrame.Rotation)

    LastTweenGoalPos = waypointPos
    ActiveTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    ActiveTween:Play()
end

