-- 5. ТУРБО TWEEN-КОНТРОЛЛЕР ПЕРЕМЕЩЕНИЯ (С ЗАЩИТОЙ ПОТОКА STREAMING)
-- ============================================================================
local ActiveTween = nil
local LastTweenGoalPos = nil
local LastStreamRequest = 0
local StreamInFlight = false
local LastPortalInvoke = 0
local ZeroVec = Vector3.new(0, 0, 0)
local HugeVec = Vector3.new(1e9, 1e9, 1e9)
local DeadBoxVec = Vector3.new(1, 1, 1)

local function requestStreamThrottled(targetPos, currentPos)
    if not StreamInFlight and (tick() - LastStreamRequest) >= 1.1 then
        LastStreamRequest = tick()
        StreamInFlight = true
        task.spawn(function()
            pcall(function()
                if currentPos and (targetPos - currentPos).Magnitude > 500 then
                    local mid = currentPos + ((targetPos - currentPos).Unit * 420)
                    LocalPlayer:RequestStreamAroundAsync(mid)
                end
                LocalPlayer:RequestStreamAroundAsync(targetPos)
            end)
            StreamInFlight = false
        end)
    end
end

local function ensureHoverBV(root)
    if not root then return end
    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieBV"
        bv.MaxForce = HugeVec
        bv.Velocity = ZeroVec
        bv.Parent = root
    else
        bv.Velocity = ZeroVec
    end
    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)
end

local function stopTweenOnly()
    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
        ActiveTween = nil
    end
    LastTweenGoalPos = nil
end

local function stopTweenAndReleasePhysics(restoreCollide)
    stopTweenOnly()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = root:FindFirstChild("OllieBV")
        if bv then pcall(function() bv:Destroy() end) end
        if restoreCollide then
            pcall(function() root.CanCollide = true end)
        end
    end
end
Env.OllieV8_9_2_Cleanup = function()
    stopTweenAndReleasePhysics(true)
end

buildHUD(function(enabled)
    if not enabled then
        stopTweenAndReleasePhysics(true)
    end
end, performServerHop)

