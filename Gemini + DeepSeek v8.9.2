local function getCombatRemotes()
    if CachedRegAtk and CachedRegAtk.Parent and CachedRegHit and CachedRegHit.Parent then
        return CachedRegAtk, CachedRegHit
    end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if net then
        CachedRegAtk = net:FindFirstChild("RE/RegisterAttack")
        CachedRegHit = net:FindFirstChild("RE/RegisterHit")
    end
    return CachedRegAtk, CachedRegHit
end

local function getCombatFrameworkCtrl()
    if CachedCFUpvalTable and CachedCFUpvalTable.activeController then
        return CachedCFUpvalTable.activeController
    end
    if (tick() - LastCFScan) < 3.5 then return nil end
    LastCFScan = tick()
    pcall(function()
        local cfScript = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        if cfScript and debug and debug.getupvalues then
            local cf = require(cfScript)
            local upvals = debug.getupvalues(cf)
            if upvals and type(upvals[2]) == "table" then
                CachedCFUpvalTable = upvals[2]
            end
        end
    end)
    return CachedCFUpvalTable and CachedCFUpvalTable.activeController or nil
end

local function equipBestTool()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return nil end

    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == Config.WeaponType or eq.Name == "Black Leg" or eq.Name == "Combat") then
        return eq
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == Config.WeaponType or item.Name == "Black Leg" or item.Name == "Combat") then
                hum:EquipTool(item)
                return item
            end
        end
        local firstTool = bp:FindFirstChildOfClass("Tool")
        if firstTool then
            hum:EquipTool(firstTool)
            return firstTool
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function findTargetMob(qData)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = (myRoot and myRoot.Position) or (qData.MPos and qData.MPos.Position) or Vector3.new()

    local bestMob = nil
    local bestDist = math.huge

    for _, m in ipairs(enemies:GetChildren()) do
        if mobNameMatches(m.Name, qData.Mob) then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr then
                if mh.Health > 0 and mr.Position.Y > -300 then
                    local d = (mr.Position - refPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestMob = m
                    end
                elseif mh.Health <= 0 and mr.Size.X > 4 then
                    pcall(function() mr.Size = DeadBoxVec end)
                end
            end
        end
    end
    return bestMob
end

local LastSimRadiusTime = 0
local function pullMobsTogether(mobName, targetPos)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local boxVec = Vector3.new(Config.MobHitboxSize, Config.MobHitboxSize, Config.MobHitboxSize)

    if sethiddenproperty and (tick() - LastSimRadiusTime) >= 1.5 then
        LastSimRadiusTime = tick()
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)
    end

    for _, m in ipairs(enemies:GetChildren()) do
        if mobNameMatches(m.Name, mobName) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            local mh = m:FindFirstChildOfClass("Humanoid")
            if mr and mh then
                if mh.Health > 0 and (mr.Position - targetPos).Magnitude <= Config.MobPullMaxRadius then
                    pcall(function()
                        mr.CanCollide = false
                        mr.Size = boxVec
                        mr.Transparency = 0.85
                        mr.AssemblyLinearVelocity = ZeroVec
                        mh.WalkSpeed = 0
                        mh.JumpPower = 0
                        if Config.BringMobs and (mr.Position - targetPos).Magnitude > 1.2 then
                            mr.CFrame = CFrame.new(targetPos)
                        end
                    end)
                elseif mh.Health <= 0 and mr.Size.X > 4 then
                    pcall(function() mr.Size = DeadBoxVec end)
                end
            end
        end
    end
end

local function executeAttack(mob)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    if not char:FindFirstChild("HasBuso") and (tick() - FSM.LastBusoTry) >= Config.BusoRetryCooldown then
        FSM.LastBusoTry = tick()
        task.spawn(function()
            pcall(function()
                local comm = getCommF()
                if comm then comm:InvokeServer("Buso") end
            end)
        end)
    end

    local tool = equipBestTool()
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        local regAtk, regHit = getCombatRemotes()
        local enemies = Workspace:FindFirstChild("Enemies")
        if regAtk and regHit and mob and mob:FindFirstChild("HumanoidRootPart") then
            local targets = {}
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    local er = enemy:FindFirstChild("HumanoidRootPart")
                    local eh = enemy:FindFirstChildOfClass("Humanoid")
                    if er and eh and eh.Health > 0 and (er.Position - root.Position).Magnitude <= 70 then
                        table.insert(targets, {enemy, er})
                    end
                end
            end
            if #targets == 0 then
                table.insert(targets, {mob, mob.HumanoidRootPart})
            end
            regAtk:FireServer(0)
            regHit:FireServer(mob.HumanoidRootPart, targets)
        end
    end)

    pcall(function()
        local ctrl = getCombatFrameworkCtrl()
        if ctrl then
            ctrl.timeToNextAttack = 0
            ctrl.hitboxMagnitude = 65
            ctrl:attack()
        end
    end)
end

