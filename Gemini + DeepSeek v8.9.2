local LastSetSpawnIsland = ""

task.spawn(function()
    while isRunActive() and task.wait(Config.LoopInterval) do
        if not isRunActive() or FSM.Completed then
            stopTweenAndReleasePhysics(true)
            break
        end

        if not Env.OllieV8_9_2_Enabled then
            stopTweenAndReleasePhysics(true)
            FSM.ActiveCombatMob = nil
        else
            pcall(function()
                if not ensureTeam() then return end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not char or not root or not hum or hum.Health <= 0 then
                    stopTweenAndReleasePhysics(false)
                    FSM.ActiveCombatMob = nil
                    FSM.IsHealingState = false
                    logStatus("Ожидание спавна персонажа...")
                    return
                end

                clearBlockingDialogue()

                local qData, myLvl, status = getQuestByLevel()

                if status == "COMPLETED" then
                    FSM.Completed = true
                    Env.OllieV8_9_2_Enabled = false
                    stopTweenAndReleasePhysics(true)
                    if MainFrameRef then MainFrameRef.BorderColor3 = Color3.fromRGB(255, 215, 0) end
                    logStatus("ФАРМ ОКОНЧЕН — ДОСТИГНУТ " .. tostring(Config.MaxLevel) .. " УРОВЕНЬ!", myLvl, "COMPLETED")
                    if not FSM.CompletionNotified then
                        FSM.CompletionNotified = true
                        pcall(function()
                            StarterGui:SetCore("SendNotification", {
                                Title = "OLLIE ENGINE V8.9.2",
                                Text = "ФАРМ ОКОНЧЕН — ВСЕ ПОСТАВЛЕННЫЕ ЦЕЛИ ВЫПОЛНЕНЫ!",
                                Duration = 10
                            })
                        end)
                    end
                    return
                elseif status == "NEED_NEXT_SEA" or not qData then
                    stopTweenAndReleasePhysics(true)
                    FSM.ActiveCombatMob = nil
                    logStatus(
                        string.format("Достигнут лимит Sea %d (LVL %d). Перейди в Sea %d!", CurrentSeaNum, myLvl, CurrentSeaNum + 1),
                        myLvl,
                        "NEXT SEA"
                    )
                    return
                end

                local expectedQuestKey = qData.QName .. "_" .. tostring(qData.QNum)

                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if Config.SafeModeEnabled then
                    if hpRatio < Config.LowHpThreshold and not FSM.IsHealingState then
                        FSM.IsHealingState = true
                        FSM.ActiveCombatMob = nil
                        FSM.SafeHealCFrame = CFrame.new(root.Position.X, math.max(root.Position.Y + Config.SafeSkyOffset, 260), root.Position.Z)
                    elseif FSM.IsHealingState and hpRatio >= Config.RecoverHpThreshold then
                        FSM.IsHealingState = false
                        FSM.SafeHealCFrame = nil
                    end
                else
                    FSM.IsHealingState = false
                end

                if FSM.IsHealingState and FSM.SafeHealCFrame then
                    FSM.GroundedAtNPC = false
                    FSM.ActiveCombatMob = nil
                    smartMoveTo(FSM.SafeHealCFrame)
                    logStatus(string.format("ОТХИЛ [HP: %d%% / %d%%]", math.floor(hpRatio * 100), math.floor(Config.RecoverHpThreshold * 100)), myLvl, expectedQuestKey)
                    return
                end

                local guiQuestActive = isQuestGuiVisible()

                if guiQuestActive and (
                    (FSM.CurrentTrackedQuestKey and FSM.CurrentTrackedQuestKey ~= expectedQuestKey)
                    or (not FSM.CurrentTrackedQuestKey and isQuestTextDefinitelyStale(qData))
                ) then
                    local comm = getCommF()
                    if comm then pcall(function() comm:InvokeServer("AbandonQuest") end) end
                    FSM.CurrentTrackedQuestKey = nil
                    FSM.ForceFarmExpireTime = 0
                    task.wait(0.25)
                    guiQuestActive = isQuestGuiVisible()
                end

                local hasActiveQuest = guiQuestActive or (tick() < FSM.ForceFarmExpireTime)

                if not hasActiveQuest then
                    -- ШАГ 1: БЫСТРЫЙ ПОДЛЕТ К NPC И ВЗЯТИЕ КВЕСТА БЕЗ ПРОВАЛА СКВОЗЬ ПОЛ
                    FSM.ActiveCombatMob = nil
                    local npcCF = getLiveNPCCFrame(qData)
                    local npcDist = (root.Position - npcCF.Position).Magnitude

                    if npcDist > 7.5 then
                        FSM.GroundedAtNPC = false
                        smartMoveTo(npcCF)
                        logStatus(string.format("Летим к NPC (%dм)", math.floor(npcDist)), myLvl, expectedQuestKey)
                    else
                        stopTweenOnly()
                        ensureHoverBV(root)
                        FSM.GroundedAtNPC = true
                        root.CFrame = npcCF
                        task.wait(0.12)

                        local comm = getCommF()
                        if Config.AutoSetSpawnPoint and comm and LastSetSpawnIsland ~= qData.QName then
                            LastSetSpawnIsland = qData.QName
                            task.spawn(function()
                                pcall(function() comm:InvokeServer("SetSpawnPoint") end)
                            end)
                        end

                        local serverReply = nil
                        if comm then
                            pcall(function()
                                serverReply = comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                            end)
                        end

                        FSM.GroundedAtNPC = false
                        FSM.QuestTriesAtNPC = FSM.QuestTriesAtNPC + 1
                        FSM.CurrentTrackedQuestKey = expectedQuestKey
                        logStatus("Взятие квеста #" .. tostring(FSM.QuestTriesAtNPC) .. " (Ответ: " .. tostring(serverReply) .. ")", myLvl, expectedQuestKey)
                        task.wait(0.22)

                        if isQuestGuiVisible() or FSM.QuestTriesAtNPC >= 3 then
                            if not isQuestGuiVisible() then
                                FSM.ForceFarmExpireTime = tick() + 28
                            end
                            FSM.QuestTriesAtNPC = 0
                        end
                    end
                else
                    -- ШАГ 2: ТУРБО-ФАРМ И РАННЯЯ СТЯЖКА ПАЧКИ
                    FSM.GroundedAtNPC = false
                    FSM.QuestTriesAtNPC = 0
                    FSM.CurrentTrackedQuestKey = expectedQuestKey

                    local mob = findTargetMob(qData)
                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                        FSM.ActiveCombatMob = mob
                        local mPos = mob.HumanoidRootPart.Position
                        local attackPos = mPos + Vector3.new(0, Config.HoverHeight, Config.AttackBackOffset)

                        smartMoveTo(CFrame.new(attackPos, mPos))
                        logStatus("Бьем: " .. mob.Name .. " [HP: " .. tostring(math.floor(mob.Humanoid.Health)) .. "]", myLvl, expectedQuestKey)

                        if (root.Position - mPos).Magnitude <= Config.MobPullEngageDist then
                            pullMobsTogether(qData.Mob, mPos)
                        end
                    else
                        FSM.ActiveCombatMob = nil
                        local waypoints = getMobSpawnWaypoints(qData)
                        if #waypoints > 1 and (tick() - FSM.LastPatrolSwitch) >= Config.SpawnPatrolInterval then
                            FSM.LastPatrolSwitch = tick()
                            FSM.PatrolIndex = (FSM.PatrolIndex % #waypoints) + 1
                        end
                        if FSM.PatrolIndex > #waypoints then FSM.PatrolIndex = 1 end

                        local targetSpawnCF = waypoints[FSM.PatrolIndex]
                        local waitDist = (root.Position - targetSpawnCF.Position).Magnitude
                        smartMoveTo(targetSpawnCF)
                        logStatus(
                            string.format("Ждем/летим к спавну %s (%dм) [%d/%d]", qData.Mob, math.floor(waitDist), FSM.PatrolIndex, #waypoints),
                            myLvl,
                            expectedQuestKey
                        )
                    end
                end
            end)
        end
    end
end)
