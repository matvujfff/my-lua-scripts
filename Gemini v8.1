-- 2. STEALTH SERVER HOP (БЕЗ ВНЕШНИХ HTTP-ЗАПРОСОВ К GAMES.ROBLOX.COM)
-- ============================================================================
local IsHopping = false
local LastHopTime = 0

local function performServerHop()
    if IsHopping or not isRunActive() then return end
    local sinceLast = tick() - LastHopTime
    if LastHopTime > 0 and sinceLast < Config.ServerHopCooldown then
        logStatus(string.format("Анти-Бан пауза на хоп: жди %d сек", math.ceil(Config.ServerHopCooldown - sinceLast)))
        return
    end

    IsHopping = true
    LastHopTime = tick()
    logStatus("Безопасная смена сервера (Stealth)...")

    local placeId = game.PlaceId
    local currentJob = tostring(game.JobId)
    local hoppedViaBrowser = false

    -- Используем ТОЛЬКО внутриигровой браузер серверов Blox Fruits (никаких http_request к сайту Roblox!)
    pcall(function()
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if sb then
            local page = math.random(2, 5)
            local list = sb:InvokeServer(page)
            if type(list) == "table" then
                for jobId, info in pairs(list) do
                    if tostring(jobId) ~= currentJob and type(info) == "table" and tonumber(info.Count) and info.Count >= 2 and info.Count <= 8 then
                        logStatus("Переход через игровой браузер...")
                        hoppedViaBrowser = true
                        sb:InvokeServer("teleport", jobId)
                        break
                    end
                end
            end
        end
    end)

    if not hoppedViaBrowser then
        task.wait(1.0)
        logStatus("Стандартный переход TeleportService...")
        pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end

    task.wait(8)
    IsHopping = false
end

buildHUD(performServerHop)

