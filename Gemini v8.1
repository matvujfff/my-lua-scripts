-- Проверяет лучом Raycast, нет ли прямо по курсу стены/скалы/барьера
local function isObstacleAhead(char, curPos, targetPos)
    local dir = targetPos - curPos
    local dist = dir.Magnitude
    if dist < 10 then return false end
    local checkDist = math.min(dist, 65)
    local ok, hit = pcall(function()
        RayParams.FilterDescendantsInstances = { char, Workspace:FindFirstChild("Enemies") }
        return Workspace:Raycast(curPos, dir.Unit * checkDist, RayParams)
    end)
    if ok and hit and hit.Instance and hit.Instance.CanCollide then
        return true
    end
    return false
end

table.insert(Env.OllieV8_1_Connections, RunService.Heartbeat:Connect(function(dt)
    if not isRunActive() then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if not Env.OllieV8_1_Enabled or hum.Health <= 0 or GroundedAtNPC then
        local bv = root:FindFirstChild("OllieBV")
        if bv then bv:Destroy() end
        if GroundedAtNPC or not Env.OllieV8_1_Enabled then
            root.CanCollide = true
        end
        return
    end

    local bv = root:FindFirstChild("OllieBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OllieBV"
        bv.MaxForce = HugeVec
        bv.Velocity = ZeroVec
        bv.Parent = root
    else
        bv.Velocity = ZeroVec
    end

    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)

    if DesiredGoalCFrame then
        local curPos = root.Position
        local dstPos = DesiredGoalCFrame.Position
        local totalDist = (dstPos - curPos).Magnitude
        local horizVec = Vector3.new(dstPos.X - curPos.X, 0, dstPos.Z - curPos.Z)
        local horizDist = horizVec.Magnitude
        local now = tick()

        -- Детектор упора в невидимый барьер или незагруженный чанк
        if totalDist > 18 then
            if (now - LastStuckCheck) >= 0.75 then
                if LastStuckPos and (curPos - LastStuckPos).Magnitude < 7.0 then
                    EmergencyClimbUntil = now + 3.0
                    EmergencyClimbY = math.max(curPos.Y, dstPos.Y, Config.SkyBridgeMinAltitude) + 250
                    requestStreamThrottled(dstPos, curPos)
                end
                LastStuckPos = curPos
                LastStuckCheck = now
            end
        else
            EmergencyClimbUntil = 0
            LastStuckPos = curPos
        end

        -- === ВЫБОР ТРАЕКТОРИИ (SKY-BRIDGE ПРОТИВ БАРЬЕРОВ МОРЯ И СКАЛ) ===
        local stepGoal = dstPos

        -- Случай 1: Сработал детектор застревания ИЛИ впереди стена по Raycast ИЛИ дальний перелет между островами (> 420 стадов)
        local needSkyBridge = (horizDist > Config.SkyBridgeDistThreshold)
            or (now < EmergencyClimbUntil)
            or (horizDist > 28 and isObstacleAhead(char, curPos, dstPos))

        if needSkyBridge and horizDist > Config.SkyBridgeDescendRadius then
            local safeCruiseY = math.max(curPos.Y, dstPos.Y + 180, Config.SkyBridgeMinAltitude)
            if now < EmergencyClimbUntil and EmergencyClimbY > safeCruiseY then
                safeCruiseY = EmergencyClimbY
            end

            if curPos.Y < (safeCruiseY - 12) then
                -- Фаза А: Строго вертикальный взлет в чистое небо (не давим в барьер перед собой!)
                stepGoal = Vector3.new(curPos.X, safeCruiseY, curPos.Z)
            else
                -- Фаза Б: Горизонтальный полет высоко в небе над океаном и горами до точки над целью
                stepGoal = Vector3.new(dstPos.X, safeCruiseY, dstPos.Z)
            end
        end

        local delta = stepGoal - curPos
        local dist = delta.Magnitude

        if totalDist <= 6.0 then
            root.CFrame = DesiredGoalCFrame
        elseif dist > 0.05 then
            local step = math.min(dist, Config.FlightSpeed * dt)
            local nextPos = curPos + (delta.Unit * step)
            local lookHoriz = Vector3.new(dstPos.X - nextPos.X, 0, dstPos.Z - nextPos.Z).Magnitude
            if lookHoriz > 0.05 then
                root.CFrame = CFrame.new(nextPos, Vector3.new(dstPos.X, nextPos.Y, dstPos.Z))
            else
                root.CFrame = CFrame.new(nextPos) * DesiredGoalCFrame.Rotation
            end
        end
    end
end))

