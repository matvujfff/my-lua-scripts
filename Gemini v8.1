local DesiredGoalCFrame = nil
local GroundedAtNPC = false
local IsHealingState = false
local SafeHealCFrame = nil
local ActiveCombatMob = nil
local LastBusoTry = 0
local ZeroVec = Vector3.new(0, 0, 0)
local HugeVec = Vector3.new(1e9, 1e9, 1e9)

local LastStuckCheck = 0
local LastStuckPos = nil
local EmergencyClimbUntil = 0
local EmergencyClimbY = 0
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

table.insert(Env.OllieV8_1_Connections, LocalPlayer.CharacterAdded:Connect(function()
