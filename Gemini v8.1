-- Отложенный и медленный ввод промокодов (чтобы не слать пачку пакетов в первую секунду входа)
local CodesRedeemed = false
local function redeemAllExpCodesOnce()
    if CodesRedeemed or not Config.AutoRedeemCodes then return end
    CodesRedeemed = true
    task.spawn(function()
        -- Ждем 8 секунд после выбора команды, чтобы аккаунт выглядел как живой игрок
        task.wait(8.0 + math.random(1, 4))
        local d = LocalPlayer:FindFirstChild("Data")
        local lvl = d and d:FindFirstChild("Level") and d.Level.Value or 1
        -- Если уровень уже > 40, коды на этом аккаунте уже вводились ранее — не спамим ремоут!
        if lvl > 40 then return end

        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        local redeemRemote = rem and rem:FindFirstChild("Redeem")
        if not redeemRemote then return end

        local expCodes = {
            "Sub2CaptainMaui", "kittgaming", "Sub2Fer999",
            "Enyu_is_Pro", "Magicbus", "JCWK", "Starcodeheo", "Bluxxy",
            "SUB2GAMERROBOT_EXP1", "Sub2NoobMaster123", "Sub2OfficialNoobie",
            "StrawHatMaine", "TantaiGaming", "Axiore", "TheGreatAce"
        }
        for _, code in ipairs(expCodes) do
            if not isRunActive() then break end
            pcall(function()
                redeemRemote:InvokeServer(code)
            end)
            -- Человеческая пауза 1.3 - 2.1 сек между кодами
            task.wait(1.3 + (math.random(0, 8) / 10))
        end
    end)
end

local function ensureTeam()
    if not LocalPlayer.Team or (LocalPlayer.Team.Name ~= "Pirates" and LocalPlayer.Team.Name ~= "Marines") then
        logStatus("Выбираем команду Pirates...")
        pcall(function()
            local comm = getCommF()
            if comm then
                comm:InvokeServer("SetTeam", "Pirates")
            end
        end)
        task.wait(1.5)
        return false
    end
    redeemAllExpCodesOnce()
    return true
end

local function isQuestGuiVisible()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "OllieHudV8_1" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj.Name == "Quest" and obj:IsA("GuiObject") and obj.Visible then
                    local parent = obj.Parent
                    local chainVisible = true
                    while parent and parent ~= gui do
                        if parent:IsA("GuiObject") and not parent.Visible then
                            chainVisible = false
                            break
                        end
                        parent = parent.Parent
                    end
                    if chainVisible then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function clearBlockingDialogue()
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then return end
        for _, gui in ipairs(pGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local dlg = gui:FindFirstChild("Dialogue", true)
                if dlg and dlg:IsA("GuiObject") and dlg.Visible then
                    local opt1 = dlg:FindFirstChild("Option1", true)
                    if opt1 and firesignal then
                        pcall(function() firesignal(opt1.Activated) end)
                    end
                end
            end
        end
    end)
end

local function mobNameMatches(enemyName, mobName)
    local n, m = string.lower(enemyName), string.lower(mobName)
    if string.sub(n, 1, #m) ~= m then return false end
    local c = string.sub(n, #m + 1, #m + 1)
    return c == "" or c == " " or c == "["
end

