local function HopToOnePlayerServer(reason)
    if State.ServerHopping then return end
    State.ServerHopping = true
    State.Task = "Смена сервера (" .. tostring(reason) .. ")"

    local placeId = game.PlaceId
    local cursor = ""
    local foundServer = nil

    for page = 1, 8 do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
            placeId,
            cursor ~= "" and ("&cursor=" .. cursor) or ""
        )

        local ok, response = pcall(function()
            if request then
                local r = request({Url = url, Method = "GET"})
                return HttpService:JSONDecode(r.Body)
            else
                return HttpService:JSONDecode(game:HttpGet(url))
            end
        end)

        if ok and response and response.data then
            for _, srv in ipairs(response.data) do
                if type(srv) == "table" and srv.id ~= game.JobId and srv.playing and srv.maxPlayers then
                    if srv.playing >= 1 and srv.playing <= 2 and srv.playing < srv.maxPlayers then
                        foundServer = srv.id
                        break
                    end
                end
            end
            if foundServer then break end
            if response.nextPageCursor then
                cursor = response.nextPageCursor
            else
                break
            end
        end
        task.wait(0.35)
    end

    pcall(function()
        if foundServer then
            TeleportService:TeleportToPlaceInstance(placeId, foundServer, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
    task.wait(8)
    State.ServerHopping = false
end

