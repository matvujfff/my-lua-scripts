local function GetActiveQuestEntry()
    local lvl = LocalPlayer.Data.Level.Value
    for _, q in ipairs(QuestDatabase) do
        if q.Sea == State.CurrentSea and lvl >= q.Min and lvl <= q.Max then
            return q
        end
    end
    -- Fallback на последний квест текущего моря
    for i = #QuestDatabase, 1, -1 do
        if QuestDatabase[i].Sea == State.CurrentSea then
            return QuestDatabase[i]
        end
    end
    return QuestDatabase[1]
end

