local function ProcessBackpackFruits()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return end

    local currentFruit = LocalPlayer.Data.DevilFruit.Value
    local containers = {bp, char}

    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Fruit") or item:GetAttribute("OriginalName")) then
                local fruitId = item:GetAttribute("OriginalName") or item.Name:gsub(" Fruit", "") .. "-" .. item.Name:gsub(" Fruit", "")

                -- Если у нас нет Buddha, а выпала Buddha или хороший Логия на старте — съедаем для ускорения прокачки в 3 раза
                local shouldEat = false
                if currentFruit ~= "Buddha-Buddha" then
                    if fruitId == "Buddha-Buddha" then
                        shouldEat = true
                    elseif State.CurrentSea == 1 and currentFruit == "" and FruitValuation[fruitId] and FruitValuation[fruitId].PriorityEat then
                        shouldEat = true
                    end
                end

                -- Сначала всегда пробуем сохранить ценный фрукт в инвентарь
                local storedOk = false
                pcall(function()
                    storedOk = CommF_:InvokeServer("StoreFruit", fruitId, item)
                end)

                if not storedOk and shouldEat then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:EquipTool(item)
                        task.wait(0.2)
                        local eatRemote = item:FindFirstChild("EatRemote", true)
                        if eatRemote then
                            eatRemote:InvokeServer("Eat")
                        end
                    end
                end
            end
        end
    end
end

