-- 5. БЕЗОПАСНОЕ ПЕРЕМЕЩЕНИЕ (SAFE TWEEN ENGINE) И ZERO-STUCK ПОЗИЦИОНИРОВАНИЕ
-- ============================================================================
local function GetCharacterRoot()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return hrp, hum
    end
    return nil, nil
end

local function SafeTweenTo(targetCFrame)
    local hrp, hum = GetCharacterRoot()
    if not hrp or not hum then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance <= 12 then
        hrp.CFrame = targetCFrame
        return true
    end

    -- Мгновенный сброс сидения (предотвращает залипание на стульях/лодках)
    if hum.Sit then
        hum.Sit = false
        hum.Jump = true
    end

    -- Пошаговая линейная интерполяция на базе RunService.Heartbeat (без рывков TweenService)
    local startTime = os.clock()
    local duration = distance / Config.TweenSpeed
    local startPos = hrp.Position
    local targetPos = targetCFrame.Position
    local rotation = targetCFrame - targetCFrame.Position

    while (hrp.Position - targetPos).Magnitude > 10 do
        if not LocalPlayer.Character or not hrp.Parent or hum.Health <= 0 then
            return false
        end
        local elapsed = os.clock() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        local nextPos = startPos:Lerp(targetPos, alpha)
        hrp.CFrame = CFrame.new(nextPos) * rotation
        if alpha >= 1 then break end
        RunService.Heartbeat:Wait()
    end

    if hrp and hrp.Parent then
        hrp.CFrame = targetCFrame
    end
    return true
end

