-- 12. LIVE FUNPAY ACCOUNT VALUATION HUD (С РАСЧЕТОМ КОМИССИИ И ЧЕК-ЛИСТОМ)
-- ============================================================================
local function CalculateFunPayValuation()
    local lvl = LocalPlayer.Data.Level.Value
    local beli = LocalPlayer.Data.Beli.Value
    local frags = LocalPlayer.Data.Fragments.Value

    -- 1. Базовая оценка уровня и открытого моря (по актуальному стакану FunPay 2026)
    local grossRub = 0
    if lvl < 700 then
        grossRub = math.floor((lvl / 700) * 65)
    elseif lvl < 1500 then
        grossRub = 75 + math.floor(((lvl - 700) / 800) * 165)
    else
        grossRub = 260 + math.floor(math.min(lvl - 1500, 1050) * 0.18)
    end

    -- 2. Бонус за 5 стилей 400 Mastery (Full Godhuman Ready)
    local stylesReadyCount = 0
    for _, style in ipairs(FightingStylesOrder) do
        local m = State.StyleMasteryCache[style.Name] or 0
        if m >= 400 then
            stylesReadyCount = stylesReadyCount + 1
            grossRub = grossRub + 75
        elseif m >= 300 then
            grossRub = grossRub + 35
        end
    end
    if stylesReadyCount == 5 then
        grossRub = grossRub + 320 -- Премия за готовый сет «Full Godhuman Ready»
    end

    -- 3. Бонус за гарантированное оружие
    if State.OwnedItems["Saber"] then grossRub = grossRub + 45 end
    if State.OwnedItems["Rengoku"] or State.OwnedItems["Midnight Blade"] then grossRub = grossRub + 85 end

    -- 4. Бонус за экономику (Beli + Fragments)
    if beli >= 10000000 then
        grossRub = grossRub + 110
    elseif beli >= 5000000 then
        grossRub = grossRub + 45
    end
    if frags >= 5000 then
        grossRub = grossRub + 80
    end

    -- 5. Оценка фруктов в инвентаре и съеденного фрукта
    local bestFruitBonus = 0
    local hasValuableFruit = false
    for _, fName in ipairs(State.StoredFruits) do
        local info = FruitValuation[fName]
        if info then
            grossRub = grossRub + info.RubBonus
            if info.RubBonus >= 170 then
                hasValuableFruit = true
            end
            if info.RubBonus > bestFruitBonus then
                bestFruitBonus = info.RubBonus
            end
        end
    end

    local netRub = math.floor(grossRub * (1 - Config.FunPayFeePercent))
    local grossEur = grossRub / Config.EurToRubRate
    local netEur = netRub / Config.EurToRubRate

    local isTenEuroReady = (lvl >= 1500)
        and (stylesReadyCount == 5)
        and (beli >= 10000000)
        and (frags >= 5000)
        and State.OwnedItems["Saber"]
        and (State.OwnedItems["Rengoku"] or State.OwnedItems["Midnight Blade"])
        and hasValuableFruit

    return {
        GrossRub = grossRub,
        NetRub = netRub,
        GrossEur = grossEur,
        NetEur = netEur,
        StylesReady = stylesReadyCount,
        HasValuableFruit = hasValuableFruit,
        IsLotReady = isTenEuroReady
    }
end

