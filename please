local function FindBossModel(bossName)
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        local m = enemies:FindFirstChild(bossName)
        if m and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
            return m
        end
    end
    local rs = ReplicatedStorage:FindFirstChild(bossName)
    if rs and rs:FindFirstChild("Humanoid") and rs.Humanoid.Health > 0 then
        return rs
    end
    return nil
end

local function KillSpecificTarget(targetModel)
    if not targetModel then return false end
    local tHrp = targetModel:FindFirstChild("HumanoidRootPart")
    local tHum = targetModel:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum then return false end

    while targetModel.Parent and tHum.Health > 0 do
        if State.ServerHopping then return false end
        SafeTweenTo(tHrp.CFrame * CFrame.new(0, 24, 0))
        ExecuteFastAttack()
        RunService.Heartbeat:Wait()
    end
    return true
end

