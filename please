local function RunAutoRaidForFragments()
    if State.CurrentSea < 2 then return false end
    if LocalPlayer.Data.Level.Value < 1100 then return false end
    if LocalPlayer.Data.Fragments.Value >= Config.MinFragmentsGoal then return false end

    -- Проверка: находимся ли мы уже на острове рейда
    local raidTimer = LocalPlayer.PlayerGui:FindFirstChild("Main")
        and LocalPlayer.PlayerGui.Main:FindFirstChild("Timer")

    if raidTimer and raidTimer.Visible then
        State.Task = "Зачистка острова Рейда (Фарм Fragments)"
        -- Поиск активных мобов рейда и перелет между островами 1-5
        local enemies = Workspace:FindFirstChild("Enemies")
        if enemies then
            for _, mob in ipairs(enemies:GetChildren()) do
                local mHrp = mob:FindFirstChild("HumanoidRootPart")
                local mHum = mob:FindFirstChildOfClass("Humanoid")
                if mHrp and mHum and mHum.Health > 0 then
                    SafeTweenTo(mHrp.CFrame * CFrame.new(0, 26, 0))
                    BringMobsToAnchor(mob.Name, mHrp.Position)
                    ExecuteFastAttack()
                    return true
                end
            end
        end
        -- Перелет к следующему острову рейда
        local locations = Workspace:FindFirstChild("_WorldOrigin") and Workspace._WorldOrigin:FindFirstChild("Locations")
        if locations then
            for i = 5, 1, -1 do
                local isl = locations:FindFirstChild("Island " .. tostring(i))
                if isl then
                    SafeTweenTo(isl.CFrame * CFrame.new(0, 60, 0))
                    break
                end
            end
        end
        return true
    else
        -- Покупка микрочипа Flame за 100k Beli и запуск рейда в Замке/Лаборатории
        if LocalPlayer.Data.Beli.Value >= 1200000 then
            State.Task = "Покупка чипа Flame Raid для фарма Фрагментов"
            pcall(function()
                CommF_:InvokeServer("RaidsNpc", "Select", "Flame")
            end)
            if State.CurrentSea == 2 then
                SafeTweenTo(CFrame.new(-6438, 250, -4501))
                pcall(function()
                    fireclickdetector(Workspace.Map.CircleIsland.RaidSummon2.Button.Main.ClickDetector)
                end)
            elseif State.CurrentSea == 3 then
                SafeTweenTo(CFrame.new(-5017, 314, -2823))
                pcall(function()
                    fireclickdetector(Workspace.Map["Boat Castle"].RaidSummon2.Button.Main.ClickDetector)
                end)
            end
            task.wait(2)
            return true
        end
    end
    return false
end

