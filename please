        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextColor3 = Color3.fromRGB(225, 230, 240)
        lbl.Text = "..."
        lbl.Parent = frame
        HudLabels[key] = lbl
    end
end

local function UpdateTelemetryHUD()
    if not HudLabels["Task"] then return end
    local val = CalculateFunPayValuation()
    local elapsed = os.time() - State.StartTime
    local hours = math.floor(elapsed / 3600)
    local mins = math.floor((elapsed % 3600) / 60)
    local secs = elapsed % 60

    local lvl = LocalPlayer.Data.Level.Value
    local beliM = LocalPlayer.Data.Beli.Value / 1000000
    local frags = LocalPlayer.Data.Fragments.Value

    HudLabels["Task"].Text = string.format("Задача: %s", State.Task)
    HudLabels["Runtime"].Text = string.format("Аптайм: %02d:%02d:%02d / Лимит 36:00:00", hours, mins, secs)
    HudLabels["LevelSea"].Text = string.format("Уровень: %d (Sea %d) | Игроков: %d", lvl, State.CurrentSea, #Players:GetPlayers())
    HudLabels["Styles"].Text = string.format("Стили 400 Mastery: %d / 5 (Godhuman Ready)", val.StylesReady)
    HudLabels["Economy"].Text = string.format("Баланс: %.2fM $ | Фрагменты: %d f", beliM, frags)
    HudLabels["Weapons"].Text = string.format("Оружие: Saber[%s] | Rengoku[%s]",
        State.OwnedItems["Saber"] and "ДА" or "НЕТ",
        (State.OwnedItems["Rengoku"] or State.OwnedItems["Midnight Blade"]) and "ДА" or "НЕТ"
    )
    HudLabels["Fruits"].Text = string.format("Фрукты в складе: %d (Ценный: %s)",
        #State.StoredFruits,
        val.HasValuableFruit and "ДА" or "НЕТ"
    )
    HudLabels["FunPayGross"].Text = string.format("Цена лота FunPay: ~%d ₽ (%.2f €)", val.GrossRub, val.GrossEur)
    HudLabels["FunPayNet"].Text = string.format("Чистыми (-12%% ком.): ~%d ₽ (%.2f €)", val.NetRub, val.NetEur)
    HudLabels["FunPayNet"].TextColor3 = Color3.fromRGB(110, 245, 145)

    if val.IsLotReady then
        HudLabels["LotStatus"].Text = "СТАТУС ЛОТА 10 €: [ГОТОВ К ПРОДАЖЕ НА FUNPAY]"
        HudLabels["LotStatus"].TextColor3 = Color3.fromRGB(80, 255, 120)
    else
        HudLabels["LotStatus"].Text = "СТАТУС ЛОТА 10 €: [В ПРОЦЕССЕ СБОРКИ...]"
        HudLabels["LotStatus"].TextColor3 = Color3.fromRGB(255, 205, 85)
    end
end

