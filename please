local function SelectAndEquipOptimalWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not hum or not bp then return end

    local beli = LocalPlayer.Data.Beli.Value
    local frags = LocalPlayer.Data.Fragments.Value

    -- Проходим по списку 5 стилей для Godhuman Ready
    for _, style in ipairs(FightingStylesOrder) do
        local currentMastery = State.StyleMasteryCache[style.Name] or 0
        local seaAllowed = (not style.MinSea) or (State.CurrentSea >= style.MinSea)

        if currentMastery < style.TargetMastery and seaAllowed then
            local tool = char:FindFirstChild(style.Name) or bp:FindFirstChild(style.Name)
            if not tool then
                if beli >= style.CostBeli and frags >= style.CostFrag then
                    pcall(function()
                        if type(style.BuyArg) == "table" then
                            CommF_:InvokeServer(unpack(style.BuyArg))
                        else
                            CommF_:InvokeServer(style.BuyArg)
                        end
                    end)
                    task.wait(0.3)
                    tool = char:FindFirstChild(style.Name) or bp:FindFirstChild(style.Name)
                end
            end

            if tool then
                if tool:FindFirstChild("Level") then
                    State.StyleMasteryCache[style.Name] = tool.Level.Value
                end
                if State.StyleMasteryCache[style.Name] < style.TargetMastery then
                    if tool.Parent == bp then
                        hum:EquipTool(tool)
                    end
                    return
                end
            end
        end
    end

    -- Fallback: экипировка любого доступного Melee-инструмента
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then
            hum:EquipTool(tool)
            return
        end
    end
end

