-- 13. WATCHDOG ТАЙМЕР И ГЛАВНЫЙ ЦИКЛ КОНЕЧНОГО АВТОМАТА (FSM)
-- ============================================================================
local function CheckWatchdogProgress()
    local currentExp = LocalPlayer.Data.Exp.Value
    if currentExp ~= State.LastExpValue then
        State.LastExpValue = currentExp
        State.LastExpTimestamp = os.time()
    elseif os.time() - State.LastExpTimestamp >= Config.WatchdogTimeout then
        -- Сброс зависшего состояния через принудительный респавн
        State.Task = "Watchdog: Сброс зависшей задачи"
        State.LastExpTimestamp = os.time()
        pcall(function()
            CommF_:InvokeServer("AbandonQuest")
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
            end
        end)
        task.wait(4)
    end
end

local function RunPrimaryKaitunLoop()
    InitializeSecurityAndBypass()
    StartAdminAndDisconnectWatch()
    BuildTelemetryHUD()
    RefreshInventoryAndMastery()

    -- Если на старте сервер переполнен (>3 человек) — сразу уходим на пустой (1 игрок)
    if #Players:GetPlayers() > 3 then
        task.spawn(function()
            HopToOnePlayerServer("Оптимизация: переход на сервер с 1 игроком")
        end)
    end

    -- Фоновый поток обновления интерфейса, гачи и статов
    task.spawn(function()
        while task.wait(1) do
            pcall(function()
                DismissAllModalDialogs()
                AutoAllocateStats()
                RunFruitGachaAndSniper()
                CheckAndUnlockRengoku()
                CheckWatchdogProgress()
                UpdateTelemetryHUD()
            end)
        end
    end)

    -- Основной боевой поток FSM
    while task.wait(0.1) do
        if not State.ServerHopping then
            local ok, err = pcall(function()
                local hrp, hum = GetCharacterRoot()
                if not hrp or not hum then return end

                -- Приоритет 1: Смена морей по достижении 700 / 1500 LVL
                if ExecuteSea1ToSea2Transition() then return end
                if ExecuteSea2ToSea3Transition() then return end

                -- Приоритет 2: Получение Saber на 200+ уровне
                if ExecuteSaberQuest() then return end

                -- Приоритет 3: Фарм Фрагментов (рейды) для Dragon Breath и чек-листа (5000+ f)
                if RunAutoRaidForFragments() then return end

                -- Приоритет 4: Основной цикл прокачки уровня и 5 стилей до 400 Mastery
                local qEntry = GetActiveQuestEntry()
                if not qEntry then return end

                if not HasActiveQuestForMob(qEntry.Mob) then
                    State.Task = string.format("Получение квеста: %s (LVL %d)", qEntry.Mob, LocalPlayer.Data.Level.Value)
                    SafeTweenTo(qEntry.Pos)
                    CommF_:InvokeServer("StartQuest", qEntry.Quest, qEntry.Index)
                    task.wait(0.35)
                else
                    State.Task = string.format("Фарм AoE: %s", qEntry.Mob)
                    local enemies = Workspace:FindFirstChild("Enemies")
                    local targetMob = nil
                    if enemies then
                        for _, mob in ipairs(enemies:GetChildren()) do
                            if mob.Name == qEntry.Mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") and mob.Humanoid.Health > 0 then
                                targetMob = mob
                                break
                            end
                        end
                    end

                    if targetMob then
                        local anchor = targetMob.HumanoidRootPart.Position
                        SafeTweenTo(CFrame.new(anchor + Config.HoverOffset))
                        BringMobsToAnchor(qEntry.Mob, anchor)
                        ExecuteFastAttack()
                    else
                        -- Ожидание спавна на базовой точке квеста на безопасной высоте
                        SafeTweenTo(qEntry.Pos * CFrame.new(0, 35, 0))
                    end
                end
            end)
        end
    end
end

RunPrimaryKaitunLoop()
