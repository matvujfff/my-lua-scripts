local CachedCommF = nil
local function getCommF()
    if CachedCommF and CachedCommF.Parent then return CachedCommF end
    local ok, rem = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes", 10)
    end)
    if ok and rem then
        local ok2, cf = pcall(function() return rem:WaitForChild("CommF_", 10) end)
        if ok2 and cf then CachedCommF = cf end
    end
    return CachedCommF
end

