-- 8. ГЛАВНЫЙ ЦИКЛ АВТОФАРМА
-- ============================================================================
task.spawn(function()
    ensureTeamSelected()
    updateHUD("Команда выбрана. Запуск цикла фарма...")

    while task.wait(getgenv().OllieFarm.AttackInterval) do
        if not getgenv().OllieFarm.Enabled then
            TargetFlightCFrame = nil
            continue
        end

        pcall(function()
            -- Если команда слетела — перевыбираем
            if not LocalPlayer.Team then
                ensureTeamSelected()
                return
            end

            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not root or not hum or hum.Health <= 0 then
                updateHUD("Ожидание возрождения персонажа...")
                return
            end

            -- Проверка на чужих игроков рядом (защита от репортов)
            if getgenv().OllieFarm.PlayerEvasion then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local distToPlr = (root.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                        if distToPlr < getgenv().OllieFarm.SafePlayerDistance then
                            updateHUD("Чужой игрок рядом (" .. math.floor(distToPlr) .. "м)! Смена сервера...")
                            executeServerHop()
                            return
                        end
                    end
                end
            end

            local questData, currentLvl = getActiveQuestData()

            -- Шаг А: Если квест не взят, летим к NPC и берем его
            if not hasActiveQuest(questData.Mob) then
                local distToNpc = (root.Position - questData.QPos.Position).Magnitude
                updateHUD(string.format("Летим к NPC за квестом (%dм)", math.floor(distToNpc)), currentLvl, questData.QName)
                TargetFlightCFrame = questData.QPos

                if distToNpc <= 12 then
                    local remote = getCommF()
                    if remote then
                        remote:InvokeServer("StartQuest", questData.QName, questData.QNum)
                        task.wait(0.4)
                    end
                end
                return
            end

            -- Шаг Б: Квест активен -> ищем живого моба в Workspace.Enemies
            local enemies = Workspace:FindFirstChild("Enemies")
            local targetMob = nil

            if enemies then
                for _, mob in ipairs(enemies:GetChildren()) do
                    if mob.Name == questData.Mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        targetMob = mob
                        break
                    end
                end
            end

            if targetMob then
                local mobPos = targetMob.HumanoidRootPart.Position
                local distToMob = (root.Position - mobPos).Magnitude
                updateHUD(string.format("Атакуем: %s [HP: %d]", targetMob.Name, math.floor(targetMob.Humanoid.Health)), currentLvl, questData.QName)

                -- Зависаем над головой моба
                TargetFlightCFrame = CFrame.new(mobPos + Vector3.new(0, getgenv().OllieFarm.HoverHeight, 0))

                if distToMob <= 35 then
                    bringSameMobs(questData.Mob, mobPos)
                    performAttack(targetMob)
                end
            else
                -- Если живых мобов рядом нет — летим на точку спавна и ждем респавна
                local distToSpawn = (root.Position - questData.MPos.Position).Magnitude
                updateHUD(string.format("Ожидание спавна %s (%dм)", questData.Mob, math.floor(distToSpawn)), currentLvl, questData.QName)
                TargetFlightCFrame = questData.MPos * CFrame.new(0, 22, 0)
            end
        end)
    end
end)
