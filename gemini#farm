local CachedCommF = nil

local function getCommF()
    if CachedCommF and CachedCommF.Parent then
        return CachedCommF
    end
    local ok, res = pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        return rem and rem:FindFirstChild("CommF_")
    end)
    if ok and res then
        CachedCommF = res
    end
    return CachedCommF
end

local function waitForCommF()
    log("Ожидаю ReplicatedStorage.Remotes.CommF_ ...")
    setStatus("Ожидание Remotes/CommF_...")
    local attempts = 0
    while Env.OllieV3.Session == SessionId do
        attempts = attempts + 1
        local ok, res = pcall(function()
            local rem = ReplicatedStorage:WaitForChild("Remotes", 10)
            if not rem then return nil end
            return rem:WaitForChild("CommF_", 10)
        end)
        if ok and res then
            CachedCommF = res
            log("CommF_ найден")
            return res
        end
        log("CommF_ пока не найден (попытка " .. attempts .. "): " .. tostring(res))
        task.wait(1)
    end
    return nil
end

