-- 10. ФАРМ МОБОВ
-- ============================================================================
local function findTarget(mobName, fromPos)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local best = nil
    local bestDist = math.huge
    local children = enemies:GetChildren()
    for i = 1, #children do
        local m = children[i]
        if m.Name == mobName then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr and mh.Health > 0 then
                local d = (mr.Position - fromPos).Magnitude
                if d < bestDist then
                    best = m
                    bestDist = d
                end
            end
        end
    end
    return best
end

local function farmStep(q, lvl, root)
    LandingMode = false
    local target = findTarget(q.Mob, root.Position)

    if target then
        local mRoot = target:FindFirstChild("HumanoidRootPart")
        local mHum = target:FindFirstChildOfClass("Humanoid")
        if mRoot and mHum then
            local mPos = mRoot.Position
            setStatus("Бьем: " .. target.Name .. " [HP: " .. tostring(math.floor(mHum.Health)) .. "]", lvl, q.QName)
            DesiredCFrame = CFrame.new(mPos + Vector3.new(0, Env.OllieV3.HoverHeight, 0))

            local distToMob = (root.Position - mPos).Magnitude
            if distToMob <= Env.OllieV3.AttackRange then
                bringMobsAround(q.Mob, mPos)
                attackTarget(target)
            end
        end
    else
        local spDist = (root.Position - q.MPos.Position).Magnitude
        setStatus("Ждем респавна " .. q.Mob .. " (" .. tostring(math.floor(spDist)) .. "м)", lvl, q.QName)
        DesiredCFrame = CFrame.new(q.MPos.Position + Vector3.new(0, 20, 0))
    end
end

