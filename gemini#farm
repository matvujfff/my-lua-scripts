-- 9. Главный цикл фарма
task.spawn(function()
    selectTeam()
    while task.wait(getgenv().FarmConfig.AttackDelay) do
        if getgenv().FarmConfig.Enabled then
            pcall(function()
                if isOtherPlayerNearby() then
                    -- Если чужой игрок подошел вплотную более чем на 15 секунд — меняем сервер
                    serverHop()
                    return
                end

                local questInfo = getQuestForCurrentLevel()
                local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")

                -- Если квест не взят — летим к NPC и берем квест
                if questGui and not questGui.Visible then
                    smoothMoveTo(questInfo.QuestPos)
                    task.wait(0.5)
                    CommF:InvokeServer("StartQuest", questInfo.QuestName, questInfo.QuestLvl)
                    task.wait(0.5)
                else
                    -- Поиск живого моба по текущему квесту
                    local enemiesFolder = Workspace:FindFirstChild("Enemies")
                    local targetMob = nil

                    if enemiesFolder then
                        for _, mob in ipairs(enemiesFolder:GetChildren()) do
                            if mob.Name == questInfo.Mob and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                                targetMob = mob
                                break
                            end
                        end
                    end

                    if targetMob then
                        equipFightingStyle()
                        -- Зависаем ровно над головой моба
                        local hoverCFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().FarmConfig.HoverHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        smoothMoveTo(hoverCFrame)
                        
                        -- Безопасный клик атаки
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(50, 50))
                    else
                        -- Если мобы еще не заспавнились, ждем над точкой спавна
                        smoothMoveTo(questInfo.MobPos * CFrame.new(0, 25, 0))
                    end
                end
            end)
        end
    end
end)
