-- 7. Экипировка melee-стиля
local function equipFightingStyle()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local eq = char:FindFirstChildOfClass("Tool")
    if eq and MELEE_STYLES[eq.Name] then return end
    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and MELEE_STYLES[item.Name] then
            hum:EquipTool(item)
            return
        end
    end
end

-- 8. Детект чужих
local function isOtherPlayerNearby()
    if not getgenv().FarmConfig.PlayerEvasion then return false end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local r = plr.Character:FindFirstChild("HumanoidRootPart")
            if r and (myRoot.Position - r.Position).Magnitude < getgenv().FarmConfig.SafePlayerDistance then
                return true
            end
        end
    end
    return false
end

local function hasActiveQuest()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    return quest ~= nil and quest.Visible == true
end

