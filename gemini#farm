local isHopping = false
local function executeServerHop()
    if isHopping then return end
    isHopping = true
    updateHUD("Поиск нового свободного сервера...")

    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local apiUrl = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(placeId))

    local success, rawBody = pcall(function()
        local reqFunc = (http_request or request or (syn and syn.request))
        if reqFunc then
            local res = reqFunc({ Url = apiUrl, Method = "GET" })
            return res and res.Body
        else
            return game:HttpGet(apiUrl)
        end
    end)

    if success and rawBody then
        local ok, data = pcall(function() return HttpService:JSONDecode(rawBody) end)
        if ok and data and data.data then
            for _, srv in ipairs(data.data) do
                if type(srv) == "table" and srv.id ~= currentJobId and srv.playing and srv.playing >= 2 and srv.playing <= 8 then
                    updateHUD("Телепортация на сервер " .. string.sub(tostring(srv.id), 1, 8))
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(placeId, srv.id, LocalPlayer)
                    end)
                    task.wait(4)
                end
            end
        end
    end
    isHopping = false
end

