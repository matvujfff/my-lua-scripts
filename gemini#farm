-- 10. Movement — noclip + smooth step, plus grounded snap helper
-- ============================================================================
local DesiredCFrame = nil

RunService.Heartbeat:Connect(function(dt)
    if not Env.OllieV3.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    pcall(function()
        root.AssemblyLinearVelocity = ZERO
        root.AssemblyAngularVelocity = ZERO
        root.Velocity = ZERO
        root.RotVelocity = ZERO
    end)

    local parts = char:GetDescendants()
    for i = 1, #parts do
        local p = parts[i]
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
        end
    end

    if DesiredCFrame then
        local curPos = root.Position
        local dstPos = DesiredCFrame.Position
        local delta  = dstPos - curPos
        local dist   = delta.Magnitude
        if dist <= 6 then
            root.CFrame = DesiredCFrame
        else
            local step = math.min(dist, Env.OllieV3.TweenSpeed * dt)
            root.CFrame = CFrame.new(curPos + delta.Unit * step)
        end
    end
end)

-- Snap root exactly to ground-level at `pos`, kill velocity, brief settle.
local function snapToGround(pos)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    pcall(function()
        root.AssemblyLinearVelocity  = ZERO
        root.AssemblyAngularVelocity = ZERO
        root.Velocity    = ZERO
        root.RotVelocity = ZERO
        root.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
    end)
end

