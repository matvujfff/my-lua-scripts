    if l then return l.Value end
    return 1
end

-- Update 30 reworked First Sea. Prefer positions from the current in-game NPC guide,
-- because hard-coded pre-update coordinates can land beside a moved quest giver.
local function resolveQuestPosition(q)
    local guide = ReplicatedStorage:FindFirstChild("GuideModule")
    if guide then
        local ok, npcList = pcall(function()
            return require(guide).Data.NPCList
        end)
        if ok and type(npcList) == "table" then
            for _, entry in pairs(npcList) do
                if type(entry) == "table" then
                    for _, value in pairs(entry) do
                        if value == q.QName then
                            local pos = entry.Position
                            if typeof(pos) == "CFrame" then return pos end
                            if typeof(pos) == "Vector3" then return CFrame.new(pos) end
                        end
                    end
                end
            end
        else
            log("GuideModule.NPCList недоступен; использую запасные координаты квеста")
        end
    else
        log("GuideModule не найден; использую запасные координаты квеста")
    end
    return q.QPos
end

local MobSpawnAliases = {
    ["Magma General"] = {"Magma General", "Magma Admiral"},
    ["Sky Warlord"] = {"Sky Warlord", "Wysper"},
    ["Lightning God"] = {"Lightning God", "Thunder God"}
}

local function resolveMobPosition(q)
    local folder = ReplicatedStorage:FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
    if folder then
        local candidates = MobSpawnAliases[q.Mob] or {q.Mob}
        for i = 1, #candidates do
            local instance = folder:FindFirstChild(candidates[i])
            if instance then
                if instance:IsA("BasePart") then return instance.CFrame end
                if instance:IsA("Model") then return instance:GetPivot() end
                if instance:IsA("Attachment") then return instance.WorldCFrame end
            end
        end
    end
    return q.MPos
end

local function getQuestForLevel()
    local lvl = getLevel()
    for i = 1, #QuestsSea1 do
        local q = QuestsSea1[i]
        if lvl >= q.Min and lvl <= q.Max then
            return q, lvl
        end
    end
    return QuestsSea1[#QuestsSea1], lvl
end

