-- 3. Server hop с учётом неудач
local function serverHop()
    local req = (http_request or request or syn and syn.request)
    if not req then
        hopFailures = hopFailures + 1
        if hopFailures >= getgenv().FarmConfig.MaxHopFailures then
            getgenv().FarmConfig.PlayerEvasion = false
            warn("[farm] no HTTP executor — player evasion disabled")
        end
        return
    end
    local url = string.format(
        "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100",
        tostring(game.PlaceId)
    )
    local ok, response = pcall(function() return req({ Url = url, Method = "GET" }) end)
    if not (ok and response and response.Body) then
        hopFailures = hopFailures + 1
        return
    end
    local decoded = HttpService:JSONDecode(response.Body)
    if decoded and decoded.data then
        for _, srv in ipairs(decoded.data) do
            if srv.id ~= game.JobId and srv.playing and srv.playing >= 2 and srv.playing <= 7 then
                hopFailures = 0
                TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                task.wait(5)
                return
            end
        end
    end
    hopFailures = hopFailures + 1
end

