local LastTravelTry = 0
local WarnedWrongSea = false

local function mainStep()
    if IsSea2 or IsSea3 then
        if not WarnedWrongSea then
            WarnedWrongSea = true
            log("ВНИМАНИЕ: база квестов в скрипте только для Первого моря (PlaceId " .. tostring(PlaceId) .. ")")
        end
        setStatus("Скрипт рассчитан только на Первое море")
        return
    end

    if not selectPiratesTeam() then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not root or not hum or hum.Health <= 0 then
        setStatus("Ожидание спавна персонажа...")
        return
    end

    -- Уклонение от игроков (хоп запускается в отдельном потоке)
    if Env.OllieV3.PlayerEvasion then
        local allPlrs = Players:GetPlayers()
        for i = 1, #allPlrs do
            local p = allPlrs[i]
            if p ~= LocalPlayer and p.Character then
                local pr = p.Character:FindFirstChild("HumanoidRootPart")
                if pr and (root.Position - pr.Position).Magnitude < Env.OllieV3.SafePlayerDist then
                    setStatus("Игрок рядом! Меняем сервер...")
                    if not Hop.Busy and os.clock() >= Hop.NextAllowed then
                        log("Игрок " .. p.Name .. " рядом — запускаю Server Hop")
                        task.spawn(runServerHop)
                    end
                    return
                end
            end
        end
    end

    local q, myLvl = getQuestForLevel()

    -- Переход во Второе море (не чаще раза в 15 сек)
    if IsSea1 and myLvl >= 700 and os.clock() - LastTravelTry > 15 then
        LastTravelTry = os.clock()
        local comm = getCommF()
        if comm then
            log("Уровень 700+: пробую TravelDressrosa...")
            local ok, err = pcall(function()
                comm:InvokeServer("TravelDressrosa")
            end)
            if not ok then
                log("Ошибка TravelDressrosa: " .. tostring(err))
            end
        end
    end

    if not ensureQuest(q, myLvl) then
        if stillRunning() then
            setStatus("Квест не взят, повтор...", myLvl, q.QName)
            task.wait(2)
        end
        return
    end

    farmStep(q, myLvl, root)
end

-- Основной цикл
task.spawn(function()
    waitForCommF()
    log("Основной цикл запущен")

    local lastErr = ""
    local lastErrTime = 0

    while Env.OllieV3.Session == SessionId do
        task.wait(Env.OllieV3.AttackDelay)
        if not Env.OllieV3.Enabled then
            DesiredCFrame = nil
            LandingMode = false
        else
            local ok, err = pcall(mainStep)
            if not ok then
                local e = tostring(err)
                if e ~= lastErr or os.clock() - lastErrTime > 5 then
                    log("Ошибка в основном цикле: " .. e)
                    lastErr = e
                    lastErrTime = os.clock()
                end
            end
        end
    end
end)

