local function getQuestForCurrentLevel()
    local dataFolder = LocalPlayer:FindFirstChild("Data")
    local lvl = dataFolder and dataFolder:FindFirstChild("Level") and dataFolder.Level.Value or 1
    for _, q in ipairs(QuestDatabase) do
        if lvl >= q.MinLvl and lvl <= q.MaxLvl then
            return q
        end
    end
    return QuestDatabase[#QuestDatabase]
end

-- 5. Безопасный плавный полет (Smooth Tween + NoClip)
local activeTween = nil
local function smoothMoveTo(targetCFrame)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist < 5 then
        root.CFrame = targetCFrame
        return
    end

    local duration = dist / getgenv().FarmConfig.TweenSpeed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    
    if activeTween then activeTween:Cancel() end
    activeTween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    activeTween:Play()
    activeTween.Completed:Wait()
end

-- Отключение коллизий и гравитации во время полета, чтобы не застревать в стенах
RunService.Stepped:Connect(function()
    if getgenv().FarmConfig.Enabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root and not root:FindFirstChild("AntiGravityBV") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "AntiGravityBV"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = root
        end
    end
end)

-- 6. Авто-экипировка боевого стиля (Melee)
local function equipFightingStyle()
    local char = LocalPlayer.Character
    if not char then return end
    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.ToolTip == getgenv().FarmConfig.PreferredWeaponType or item.Name == "Combat") then
            char.Humanoid:EquipTool(item)
            break
        end
    end
end

-- 7. Детектор чужих игроков рядом (Защита от репортов)
local function isOtherPlayerNearby()
    if not getgenv().FarmConfig.PlayerEvasion then return false end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
            if dist < getgenv().FarmConfig.SafePlayerDistance then
                return true
            end
        end
    end
    return false
end

