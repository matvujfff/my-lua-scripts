local LandingMode = false -- true: вернуть коллизии возле точки посадки

-- Запоминаем исходное CanCollide для каждой детали. Раньше скрипт только выключал
-- коллизии и никогда не включал их обратно, из-за чего персонаж мог проваливаться.
local OriginalCollisions = setmetatable({}, { __mode = "k" })
local function setCharacterCollisionEnabled(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    local parts = char:GetDescendants()
    for i = 1, #parts do
        local part = parts[i]
        if part:IsA("BasePart") then
            if enabled then
                local original = OriginalCollisions[part]
                if original ~= nil then
                    pcall(function() part.CanCollide = original end)
                    OriginalCollisions[part] = nil
                end
            else
                if OriginalCollisions[part] == nil then
                    OriginalCollisions[part] = part.CanCollide
                end
                if part.CanCollide then
                    pcall(function() part.CanCollide = false end)
                end
            end
        end
    end
end

local hbConn
hbConn = RunService.Heartbeat:Connect(function(dt)
    if Env.OllieV3.Session ~= SessionId then
        setCharacterCollisionEnabled(true)
        if hbConn then hbConn:Disconnect() end
        return
    end
    if not Env.OllieV3.Enabled then
        setCharacterCollisionEnabled(true)
        return
    end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        setCharacterCollisionEnabled(true)
        return
    end

    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)

    local nearTarget = false
    if DesiredCFrame then
        nearTarget = (root.Position - DesiredCFrame.Position).Magnitude < 12
    end

    -- Noclip only during travel; restore original collisions when landing, pausing,
    -- dying, or stopping this script.
    setCharacterCollisionEnabled(LandingMode and nearTarget)

    if DesiredCFrame then
        local curPos = root.Position
        local delta = DesiredCFrame.Position - curPos
        local dist = delta.Magnitude
        local step = Env.OllieV3.TweenSpeed * dt
        if dist <= step + 0.5 then
            root.CFrame = DesiredCFrame
        else
            local nextPos = curPos + (delta.Unit * step)
            root.CFrame = CFrame.new(nextPos, nextPos + root.CFrame.LookVector)
        end
    end
end)

local function waitUntilNear(targetPos, tolerance, timeout)
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        if not stillRunning() then return false end
        local root = getRoot()
        if root and (root.Position - targetPos).Magnitude <= tolerance then
            return true
        end
        task.wait(0.1)
    end
    return false
end

