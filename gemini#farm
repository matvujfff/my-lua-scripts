local function getLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    if l then return l.Value end
    return 1
end

local function getQuestForLevel()
    local lvl = getLevel()
    for i = 1, #QuestsSea1 do
        local q = QuestsSea1[i]
        if lvl >= q.Min and lvl <= q.Max then return q, lvl end
    end
    return QuestsSea1[#QuestsSea1], lvl
end

local function isQuestVisible()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pGui and pGui:FindFirstChild("Main")
    local qFrame = main and main:FindFirstChild("Quest")
    return qFrame and qFrame.Visible or false
end

local function getQuestTitleText()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pGui and pGui:FindFirstChild("Main")
    local qFrame = main and main:FindFirstChild("Quest")
    if not qFrame or not qFrame.Visible then return nil end
    local cont = qFrame:FindFirstChild("Container")
    local qTitle = cont and cont:FindFirstChild("QuestTitle")
    local titleLbl = qTitle and qTitle:FindFirstChild("Title")
    if titleLbl and titleLbl:IsA("TextLabel") then return titleLbl.Text end
    return nil
end

local function isQuestActiveForMob(mobName)
    local txt = getQuestTitleText()
    if not txt then return false end
    if string.find(string.lower(txt), string.lower(mobName), 1, true) then
        return true
    end
    local comm = getCommF()
    if comm then
        pcall(function() comm:InvokeServer("AbandonQuest") end)
        log("Квест не тот ('" .. tostring(txt) .. "'), сбросил")
    end
    return false
end

