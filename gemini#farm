local Hop = {
    Busy = false,
    NextAllowed = 0,
    Failed = {},
    Candidates = {},
    LastTarget = nil,
    TeleportFailedFlag = false
}

local function getRequestFunction()
    if request then return request end
    if http_request then return http_request end
    if syn and syn.request then return syn.request end
    if fluxus and fluxus.request then return fluxus.request end
    return nil
end

local function shuffle(t)
    for i = #t, 2, -1 do
        local j = math.random(1, i)
        t[i], t[j] = t[j], t[i]
    end
end

-- Возвращает таблицу ответа API или nil, "причина"
local function fetchServerPage(cursor)
    local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor then
        url = url .. "&cursor=" .. HttpService:UrlEncode(tostring(cursor))
    end

    local body = nil
    local reqFn = getRequestFunction()

    if reqFn then
        local ok, res = pcall(reqFn, { Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
        if ok and type(res) == "table" then
            local status = tonumber(res.StatusCode or res.Status)
            if status == 429 then
                log("API вернул 429 (rate limit)")
                return nil, "429"
            end
            if status and status ~= 200 then
                log("API вернул HTTP " .. tostring(status))
            end
            body = res.Body
        else
            log("Ошибка request-функции: " .. tostring(res))
        end
    else
        log("request/http_request недоступны, пробую game:HttpGet")
    end

    if type(body) ~= "string" or body == "" then
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(res) == "string" then
            body = res
        else
            log("Ошибка game:HttpGet: " .. tostring(res))
        end
    end

    if type(body) ~= "string" or body == "" then
        return nil, "empty"
    end

    local okJ, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not okJ or type(data) ~= "table" then
        log("Невалидный JSON от API: " .. tostring(data))
        return nil, "badjson"
    end
    if type(data.data) ~= "table" then
        local msg = "нет поля data"
        if type(data.errors) == "table" and type(data.errors[1]) == "table" then
            msg = tostring(data.errors[1].message)
        end
        log("Ответ API без списка серверов: " .. msg)
        return nil, "nodata"
    end
    return data
end

-- Собираем кандидатов: не текущий, не пустой (0-1 игрок), не полный
local function refillCandidates()
    local fresh = {}
    local cursor = nil
    for page = 1, 3 do
        local data, err = fetchServerPage(cursor)
        if not data then
            if err == "429" then task.wait(3) end
            break
        end
        for i = 1, #data.data do
            local s = data.data[i]
            if type(s) == "table"
                and type(s.id) == "string"
                and s.id ~= game.JobId
                and not Hop.Failed[s.id]
                and type(s.playing) == "number"
                and type(s.maxPlayers) == "number"
                and s.playing >= Env.OllieV3.HopMinPlayers
                and s.playing < s.maxPlayers - 1 then -- оставляем запас в 1 слот
                fresh[#fresh + 1] = s.id
            end
        end
        cursor = data.nextPageCursor
        if type(cursor) ~= "string" then break end
        task.wait(0.5)
    end
    shuffle(fresh) -- чтобы не все прыгали на один и тот же сервер
    Hop.Candidates = fresh
    log("Подходящих серверов найдено: " .. tostring(#fresh))
    return #fresh
end

local function runServerHopBody()
    Hop.Failed = {}
    Hop.LastTarget = nil
    Hop.TeleportFailedFlag = false
    setStatus("Ищем свободный сервер...")
    log("Server Hop: старт; текущий JobId=" .. tostring(game.JobId))

    local tries = 0
    local emptyRounds = 0

    while tries < Env.OllieV3.HopMaxTries and Env.OllieV3.Session == SessionId do
        local id = table.remove(Hop.Candidates)
        if not id then
            local n = refillCandidates()
            if n == 0 then
                emptyRounds = emptyRounds + 1
                log("Список серверов пуст. Проверьте сообщения API/HTTP выше (раунд " .. emptyRounds .. ")")
                if emptyRounds >= 2 then
                    break
                end
                task.wait(2)
            else
                id = table.remove(Hop.Candidates)
            end
        end

        if id then
            tries = tries + 1
            Hop.LastTarget = id
            Hop.TeleportFailedFlag = false
            log("Целевой сервер: " .. id .. " (попытка " .. tries .. "/" .. Env.OllieV3.HopMaxTries .. ")")
            setStatus("Телепорт на сервер (" .. tries .. ")...")

            local callOk, callErr = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LocalPlayer)
            end)

            if not callOk then
                log("TeleportToPlaceInstance вызвал ошибку: " .. tostring(callErr))
                Hop.Failed[id] = true
            else
                -- При успешном переходе текущий скрипт выгрузится вместе с этим сервером.
                -- Если игрок остался здесь, ждём ошибку телепорта или тайм-аут и пробуем следующий ID.
                local deadline = os.clock() + 15
                while os.clock() < deadline and not Hop.TeleportFailedFlag
                    and Env.OllieV3.Session == SessionId do
                    task.wait(0.2)
                end

                if Hop.TeleportFailedFlag then
                    log("Roblox отклонил телепорт; пробую следующий сервер")
                else
                    log("Через 15 секунд переход не начался. ID помечен неудачным: " .. id)
                    Hop.Failed[id] = true
                end
            end
        end
    end

    if Env.OllieV3.Session == SessionId then
        log("Пробую резервное подключение к другому публичному серверу этого PlaceId")
        setStatus("Резервная смена сервера...")
        local fallbackOk, fallbackErr = pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
        if not fallbackOk then
            log("Резервная телепортация не запустилась: " .. tostring(fallbackErr))
            setStatus("Смена сервера не удалась; смотрите Output")
        else
            task.wait(15)
            log("Резервный вызов выполнен; если сервер не сменился, нужен текст ошибки TeleportInitFailed/Output")
            setStatus("Смена не подтверждена; проверьте Output")
        end
    end
end

local function runServerHop()
    if Hop.Busy then
        log("Server Hop уже выполняется; повторный запуск пропущен")
        setStatus("Смена сервера уже выполняется")
        return
    end

    Hop.Busy = true
    local ok, err = xpcall(runServerHopBody, function(e)
        return tostring(e) .. "\n" .. (debug and debug.traceback and debug.traceback() or "traceback недоступен")
    end)

    -- Важно: даже при ошибке кнопка должна оставаться рабочей для следующей попытки.
    Hop.Busy = false
    Hop.NextAllowed = os.clock() + Env.OllieV3.HopCooldown

    if not ok then
        log("КРИТИЧЕСКАЯ ошибка Server Hop: " .. tostring(err))
        setStatus("Ошибка смены сервера; смотрите Output")
    end
end

local function manualHop()
    Hop.NextAllowed = 0
    runServerHop()
end

