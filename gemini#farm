local function getQuestForCurrentLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if not data then return nil end
    local lvlObj = data:FindFirstChild("Level")
    if not lvlObj then return nil end
    local lvl = lvlObj.Value or 1
    for _, q in ipairs(QuestDatabase) do
        if lvl >= q.MinLvl and lvl <= q.MaxLvl then return q end
    end
    return QuestDatabase[#QuestDatabase]
end

-- 5. Anchor + движение
local activeTween = nil

local function setAnchor(on)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local bv = root:FindFirstChild("FarmAnchor")
    if on then
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FarmAnchor"
            bv.Velocity = Vector3.zero
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = root
        end
    elseif bv then
        bv:Destroy()
    end
end

local function smoothMoveTo(targetCFrame)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    setAnchor(false)
    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist < 5 then
        root.CFrame = targetCFrame
        setAnchor(true)
        return
    end
    local duration = math.max(dist / getgenv().FarmConfig.TweenSpeed, 0.05)
    if activeTween then activeTween:Cancel() end
    activeTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    activeTween:Play()
    activeTween.Completed:Wait()
    setAnchor(true)
end

