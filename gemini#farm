-- ============================================================================
local function httpGet(url)
    local ok, resp = pcall(function()
        if syn and syn.request then
            return syn.request({Url = url, Method = "GET"})
        end
        if http_request then
            return http_request({Url = url, Method = "GET"})
        end
        if request then
            return request({Url = url, Method = "GET"})
        end
        if http and http.request then
            return http.request({Url = url, Method = "GET"})
        end
        return { Body = game:HttpGet(url), StatusCode = 200 }
    end)
    if not ok or resp == nil then return nil end
    if type(resp) == "string" then return resp end
    if type(resp) == "table" then
        return resp.Body or resp.body or resp.Data
    end
    return nil
end

-- One-shot teleport attempt with TeleportInitFailed watch.
-- Returns (true) if queued / successful, (false, reason) on init failure.
local function tryTeleportInstance(placeId, targetJobId)
    local failedReason = nil
    local conn = nil
    local ok = pcall(function()
        conn = TeleportService.TeleportInitFailed:Connect(function(plr, _res, msg)
            if plr == LocalPlayer then
                failedReason = tostring(msg or "unknown")
            end
        end)
    end)

    local sent = false
    pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, targetJobId, LocalPlayer)
        sent = true
    end)

    if not sent then
        if conn then conn:Disconnect() end
        return false, "TeleportToPlaceInstance pcall failed"
    end

    -- Wait up to 8s for either an init-failure callback or the script to be teleported away.
    local t = 0
    while t < 8 and not failedReason do
        task.wait(0.5)
        t = t + 0.5
    end

    if conn then pcall(function() conn:Disconnect() end) end

    if failedReason then
        return false, failedReason
    end
    return true
end

local function serverHop()
    if Env.OllieV3.HopBusy then return end
    Env.OllieV3.HopBusy = true

    local placeId = game.PlaceId
    local jobId   = game.JobId
    local url     = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"

    setStatus("Ищем свободный сервер...")
    log("Хоп: запрос", url)

    local body = httpGet(url)
    if not body then
        setStatus("HTTP запрос не удался")
        log("Хоп: HTTP пусто, fallback Teleport(placeId)")
        pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
        Env.OllieV3.HopBusy = false
        return
    end

    local parsedOk, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not parsedOk or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
        setStatus("JSON парс не удался")
        log("Хоп: JSON bad")
        Env.OllieV3.HopBusy = false
        return
    end

    local candidates = {}
    for i = 1, #decoded.data do
        local srv = decoded.data[i]
        if type(srv) == "table" and srv.id and srv.id ~= jobId then
            local playing = tonumber(srv.playing) or 0
            local maxP    = tonumber(srv.maxPlayers) or 20
            if playing >= 1 and playing < maxP then
                candidates[#candidates + 1] = srv
            end
        end
    end
    log("Хоп: кандидатов", tostring(#candidates))

    if #candidates == 0 then
        setStatus("Пустой список, fallback Teleport")
        pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
        Env.OllieV3.HopBusy = false
        return
    end

    -- prefer quiet-but-alive servers
    table.sort(candidates, function(a, b)
        return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
    end)

    local tried = 0
    for i = 1, #candidates do
        if tried >= 8 then break end
        tried = tried + 1
        local srv = candidates[i]
        setStatus("Хоп → " .. tostring(srv.id):sub(1, 8) .. " (" .. tostring(srv.playing) .. "/" .. tostring(srv.maxPlayers or "?") .. ")")
        log("Хоп: сервер найден", tostring(srv.id), "players", tostring(srv.playing))
        local ok, reason = tryTeleportInstance(placeId, srv.id)
        if ok then
            Env.OllieV3.HopBusy = false
            return
        end
        log("Хоп: инстанс не удался:", tostring(reason))
        setStatus("Не вышло, пробуем следующий...")
    end

    setStatus("Все инстансы не вышли, обычный телепорт")
    log("Хоп: fallback Teleport(placeId)")
    pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
    Env.OllieV3.HopBusy = false
end

