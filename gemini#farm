-- 10. Главный цикл
task.spawn(function()
    selectTeam()
    while task.wait(getgenv().FarmConfig.AttackDelay) do
        if not getgenv().FarmConfig.Enabled then continue end
        pcall(function()
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end

            -- player evasion с таймером
            if isOtherPlayerNearby() then
                playerNearTime = playerNearTime + getgenv().FarmConfig.AttackDelay
                if playerNearTime >= getgenv().FarmConfig.PlayerEvasionTime then
                    serverHop()
                    playerNearTime = 0
                end
                return
            end
            playerNearTime = 0

            local q = getQuestForCurrentLevel()
            if not q then return end

            if not hasActiveQuest() then
                smoothMoveTo(q.QuestPos)
                task.wait(0.4)
                CommF:InvokeServer("StartQuest", q.QuestName, q.QuestLvl)
                task.wait(0.4)
                return
            end

            local enemies = Workspace:FindFirstChild("Enemies")
            local target = nil
            if enemies then
                for _, mob in ipairs(enemies:GetChildren()) do
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local root = mob:FindFirstChild("HumanoidRootPart")
                    if mob.Name == q.Mob and hum and root and hum.Health > 0 then
                        target = mob
                        break
                    end
                end
            end

            if target then
                equipFightingStyle()
                local hover = target.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().FarmConfig.HoverHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                smoothMoveTo(hover)
                -- атака по экранной позиции моба — надёжнее фиксированной точки
                local screen = Workspace.CurrentCamera:WorldToViewportPoint(target.HumanoidRootPart.Position)
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(screen.X, screen.Y), Workspace.CurrentCamera.CFrame)
            else
                smoothMoveTo(q.MobPos * CFrame.new(0, 25, 0))
            end
        end)
    end
end)
