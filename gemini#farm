-- 6. БОЕВАЯ СИСТЕМА: ЭКИПИРОВКА, СТЯЖКА МОБОВ (BRING MOB) И FAST ATTACK
-- ============================================================================
local function equipBestWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return nil end

    -- Проверяем, одето ли уже нужное оружие
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == getgenv().OllieFarm.WeaponCategory or equipped.Name == "Combat") then
        return equipped
    end

    -- Ищем в рюкзаке боевой стиль
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == getgenv().OllieFarm.WeaponCategory or tool.Name == "Combat") then
                hum:EquipTool(tool)
                return tool
            end
        end
        -- Если Melee не найден, берем любой доступный Tool
        local anyTool = backpack:FindFirstChildOfClass("Tool")
        if anyTool then
            hum:EquipTool(anyTool)
            return anyTool
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

-- Поиск ремутов новой системы боя Blox Fruits (Net / RegisterAttack / RegisterHit)
local NetModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetModule and NetModule:FindFirstChild("RE/RegisterAttack")
local RegisterHit = NetModule and NetModule:FindFirstChild("RE/RegisterHit")

local function performAttack(targetMob)
    local char = LocalPlayer.Character
    if not char then return end

    -- Авто-включение Хаки Вооружения (Buso Haki), если куплено
    if not char:FindFirstChild("HasBuso") then
        pcall(function()
            local remote = getCommF()
            if remote then remote:InvokeServer("Buso") end
        end)
    end

    local tool = equipBestWeapon()
    if tool then
        pcall(function() tool:Activate() end)
    end

    -- Прямой пакет удара через Net (если поддерживается текущей ревизией игры)
    pcall(function()
        if RegisterAttack and RegisterHit and targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(targetMob.HumanoidRootPart, {{targetMob, targetMob.HumanoidRootPart}})
        end
    end)

    -- Дублирующий клик через VirtualUser
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(400, 225))
    end)
end

-- Стяжка мобов одного типа в одну точку под удар
local function bringSameMobs(mobName, targetPosition)
    if not getgenv().OllieFarm.BringMobs then return end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end
    end)

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == mobName and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
            local d = (mob.HumanoidRootPart.Position - targetPosition).Magnitude
            if d <= 260 then
                pcall(function()
                    mob.HumanoidRootPart.CanCollide = false
                    mob.HumanoidRootPart.Size = Vector3.new(50, 50, 50)
                    mob.HumanoidRootPart.CFrame = CFrame.new(targetPosition)
                    if mob.Humanoid:FindFirstChild("Animator") then
                        mob.Humanoid.Animator:Destroy()
                    end
                end)
            end
        end
    end
end

