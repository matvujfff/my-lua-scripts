    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    pcall(function()
        root.AssemblyLinearVelocity = ZeroVec
        root.AssemblyAngularVelocity = ZeroVec
    end)

    local nearTarget = false
    if DesiredCFrame then
        nearTarget = (root.Position - DesiredCFrame.Position).Magnitude < 12
    end

    if not (LandingMode and nearTarget) then
        local parts = char:GetDescendants()
        for i = 1, #parts do
            local p = parts[i]
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end

    if DesiredCFrame then
        local curPos = root.Position
        local delta = DesiredCFrame.Position - curPos
        local dist = delta.Magnitude
        local step = Env.OllieV3.TweenSpeed * dt
        if dist <= step + 0.5 then
            root.CFrame = DesiredCFrame
        else
            local nextPos = curPos + (delta.Unit * step)
            root.CFrame = CFrame.new(nextPos, nextPos + root.CFrame.LookVector)
        end
    end
end)

local function waitUntilNear(targetPos, tolerance, timeout)
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        if not stillRunning() then return false end
        local root = getRoot()
        if root and (root.Position - targetPos).Magnitude <= tolerance then
            return true
        end
        task.wait(0.1)
    end
    return false
end

-- Точка на земле под/рядом с NPC (рейкаст вниз, чтобы не парить)
local function getGroundCFrame(npcCFrame)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    local offset = 3
    if hum and root then
        offset = math.max(3, hum.HipHeight + root.Size.Y / 2 + 0.3)
    end

    local filter = {}
    if char then filter[#filter + 1] = char end
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then filter[#filter + 1] = enemies end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = filter
    local okEx = pcall(function()
        params.FilterType = Enum.RaycastFilterType.Exclude
    end)
    if not okEx then
        pcall(function()
            params.FilterType = Enum.RaycastFilterType.Blacklist
        end)
    end

    local origin = npcCFrame.Position + Vector3.new(0, 8, 0)
    local ground = nil
    for i = 1, 4 do
        local ok, res = pcall(function()
            return Workspace:Raycast(origin, Vector3.new(0, -60, 0), params)
        end)
        if not ok or not res then break end
        local model = res.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            filter[#filter + 1] = model -- попали в NPC/моба: игнорируем и бросаем луч снова
            params.FilterDescendantsInstances = filter
        else
            ground = res.Position
            break
        end
    end

    if ground then
        return CFrame.new(ground + Vector3.new(0, offset, 0))
    end
    return CFrame.new(npcCFrame.Position)
end

