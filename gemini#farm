local ActiveQuestKey = nil
local DialogKeywords = { "accept", "yes", "continue", "start", "next", "принять" }

-- Best-effort: если виден диалог NPC, пробуем нажать кнопку подтверждения
local function handleDialogue()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pGui and pGui:FindFirstChild("Main")
    local dlg = main and main:FindFirstChild("Dialogue")
    if not dlg or not dlg:IsA("GuiObject") or not dlg.Visible then
        return false
    end

    log("Виден диалог NPC — пробую подтвердить")
    local pressed = false
    local items = dlg:GetDescendants()
    for i = 1, #items do
        local b = items[i]
        if (b:IsA("TextButton") or b:IsA("ImageButton")) and b.Visible then
            local txt = string.lower(b:IsA("TextButton") and b.Text or b.Name)
            for k = 1, #DialogKeywords do
                if string.find(txt, DialogKeywords[k], 1, true) then
                    pcall(function()
                        if firesignal then
                            firesignal(b.MouseButton1Click)
                            firesignal(b.Activated)
                        end
                    end)
                    pressed = true
                    break
                end
            end
        end
    end
    return pressed
end

local function takeQuest(q, lvl)
    local comm = getCommF()
    if not comm then
        log("Ошибка: CommF_ недоступен, квест взять нельзя")
        return false
    end

    for attempt = 1, Env.OllieV3.QuestMaxAttempts do
        if not stillRunning() then
            LandingMode = false
            return false
        end

        -- 1) подлёт и посадка на землю у NPC
        local groundCF = getGroundCFrame(q.QPos)
        LandingMode = true
        DesiredCFrame = groundCF
        setStatus("Летим к NPC квеста (попытка " .. attempt .. ")", lvl, q.QName)

        local startRoot = getRoot()
        local flightTimeout = 30
        if startRoot then
            flightTimeout = (startRoot.Position - groundCF.Position).Magnitude / Env.OllieV3.TweenSpeed + 10
        end
        local arrived = waitUntilNear(groundCF.Position, Env.OllieV3.QuestStandDist, flightTimeout)

        if not arrived then
            log("Не удалось долететь до NPC (" .. q.QName .. "), попытка " .. attempt)
        else
            -- 2) гасим скорость, даём серверу увидеть позицию
            local root = getRoot()
            if root then
                pcall(function()
                    root.AssemblyLinearVelocity = ZeroVec
                    root.AssemblyAngularVelocity = ZeroVec
                end)
            end
            task.wait(0.4)
            root = getRoot()
            if root then
                local d = (root.Position - q.QPos.Position).Magnitude
                log("У NPC, дистанция: " .. string.format("%.1f", d) .. " studs")
            end

            -- 3) диалог (если есть)
            handleDialogue()

            -- 4) вызов StartQuest
            setStatus("Берём квест " .. q.QName .. "...", lvl, q.QName)
            log("Пытаюсь взять квест " .. q.QName .. " [" .. tostring(q.QNum) .. "] (попытка " .. attempt .. ")...")
            local ok, res = pcall(function()
                return comm:InvokeServer("StartQuest", q.QName, q.QNum)
            end)
            if not ok then
                log("Ошибка вызова StartQuest: " .. tostring(res))
            else
                log("StartQuest ответ сервера: " .. tostring(res))
            end

            -- 5) верификация по PlayerGui.Main.Quest.Visible
            local confirmed = false
            for i = 1, 8 do
                task.wait(0.25)
                if isQuestVisible() then
                    confirmed = true
                    break
                end
            end

            if confirmed then
                log("Квест успешно взят: " .. q.QName)
                ActiveQuestKey = q.QName .. ":" .. tostring(q.QNum)
                LandingMode = false
                return true
            end
            log("Квест не появился в интерфейсе (попытка " .. attempt .. ")")
        end

        task.wait(Env.OllieV3.QuestRetryDelay)
    end

    LandingMode = false
    log("Не удалось взять квест " .. q.QName .. " за " .. Env.OllieV3.QuestMaxAttempts .. " попыток")
    return false
end

local function ensureQuest(q, lvl)
    local key = q.QName .. ":" .. tostring(q.QNum)

    if isQuestVisible() then
        if ActiveQuestKey == key then
            return true
        end
        -- квест есть, но мы не знаем чей: сверяем заголовок с именем моба
        local title = getQuestTitle()
        if title == nil or string.find(string.lower(title), string.lower(q.Mob), 1, true) then
            ActiveQuestKey = key
            return true
        end
        log("Активный квест не подходит (" .. tostring(title) .. "), отменяю...")
        abandonQuest()
        ActiveQuestKey = nil
        task.wait(0.5)
    else
        ActiveQuestKey = nil
    end

    return takeQuest(q, lvl)
end

