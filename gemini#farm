-- ============================================================================
-- 13. MAIN LOOP — grounded quest start + verified retry
-- ============================================================================
task.spawn(function()
    while task.wait(Env.OllieV3.AttackDelay) do
        if not Env.OllieV3.Enabled then
            DesiredCFrame = nil
        else
            pcall(function()
                if not selectPiratesTeam() then
                    return
                end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")

                if not char or not root or not hum or hum.Health <= 0 then
                    setStatus("Ожидание спавна персонажа...")
                    return
                end

                -- Player evasion
                if Env.OllieV3.PlayerEvasion then
                    local all = Players:GetPlayers()
                    for i = 1, #all do
                        local p = all[i]
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local pDist = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if pDist < Env.OllieV3.SafePlayerDist then
                                setStatus("Игрок рядом! Меняем сервер...")
                                serverHop()
                                return
                            end
                        end
                    end
                end

                local qData, myLvl = getQuestForLevel()

                -- auto-travel to sea 2 at 700
                if IsSea1 and myLvl >= 700 then
                    local comm = getCommF()
                    if comm then pcall(function() comm:InvokeServer("TravelDressrosa") end) end
                end

                if not isQuestActiveForMob(qData.Mob) then
                    -- Approach NPC on the horizontal plane only
                    local dxz = Vector3.new(root.Position.X - qData.QPos.Position.X, 0, root.Position.Z - qData.QPos.Position.Z)
                    local horiz = dxz.Magnitude
                    setStatus("К NPC (" .. tostring(math.floor(horiz)) .. "м)", myLvl, qData.QName)

                    if horiz > 10 then
                        DesiredCFrame = qData.QPos
                    else
                        -- Close enough: kill movement, land, then invoke
                        DesiredCFrame = nil
                        if os.clock() >= Env.OllieV3.NextQuestAttempt then
                            Env.OllieV3.NextQuestAttempt = os.clock() + 1.0
                            snapToGround(qData.QPos.Position)
                            task.wait(0.15)

                            local comm = getCommF()
                            if not comm then
                                log("StartQuest: CommF_ ещё не готов, ждём")
                                return
                            end

                            log("Пытаюсь взять квест [" .. tostring(qData.QName) .. " " .. tostring(qData.QNum) .. "]...")
                            local called = pcall(function()
                                comm:InvokeServer("StartQuest", qData.QName, qData.QNum)
                            end)
                            if not called then
                                log("Ошибка вызова StartQuest: pcall fail")
                            else
                                log("StartQuest отправлен, жду подтверждения")
                            end

                            task.wait(0.6)

                            if isQuestVisible() then
                                log("Квест успешно взят: " .. tostring(getQuestTitleText() or "?"))
                            else
                                log("Квест не подтверждён, повтор через 1с")
                            end
                        end
                    end
                else
                    -- Quest active → find mob
                    local enemies = Workspace:FindFirstChild("Enemies")
                    local target = nil
                    if enemies then
                        local kids = enemies:GetChildren()
                        for i = 1, #kids do
                            local m = kids[i]
                            if m.Name == qData.Mob then
                                local mh = m:FindFirstChildOfClass("Humanoid")
                                local mr = m:FindFirstChild("HumanoidRootPart")
                                if mh and mr and mh.Health > 0 then
                                    target = m
                                    break
                                end
                            end
                        end
                    end

                    if target then
                        local mPos = target.HumanoidRootPart.Position
                        local distToMob = (root.Position - mPos).Magnitude
                        setStatus("Бьем: " .. target.Name .. " [HP: " .. tostring(math.floor(target.Humanoid.Health)) .. "]", myLvl, qData.QName)
                        DesiredCFrame = CFrame.new(mPos + Vector3.new(0, Env.OllieV3.HoverHeight, 0))
                        if distToMob <= 40 then
                            bringMobsAround(qData.Mob, mPos)
                            attackTarget(target)
                        end
                    else
                        local spDist = (root.Position - qData.MPos.Position).Magnitude
                        setStatus("Ждем респавна " .. qData.Mob .. " (" .. tostring(math.floor(spDist)) .. "м)", myLvl, qData.QName)
                        DesiredCFrame = qData.MPos * CFrame.new(0, 20, 0)
                    end
                end
            end)
        end
    end
end)
